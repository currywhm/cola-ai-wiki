<view class="page reader-page"><app-nav title="文档阅读" back /><view class="reader-head row"><view class="grow reader-copy"><text class="reader-title">{{document.filename || '文档'}}</text><text class="muted block">{{document.page_count || 1}} 页 · {{document.status === 'completed' ? '已完成解析' : '处理中'}}</text></view><text class="tag">原文</text></view><view wx:if="{{document.organize_status === 'completed'}}" class="card organize-card"><view class="organize-heading"><text class="organize-label">已整理</text><text class="muted organize-method">{{document.organize_method === 'llm' ? '智能整理' : '基础整理'}}</text></view><text class="organize-title">{{document.organized_title}}</text><text class="organize-summary">{{document.summary}}</text><view wx:if="{{document.tags.length}}" class="tag-list"><text wx:for="{{document.tags}}" wx:key="*this" class="tag">{{item}}</text></view><view wx:if="{{document.key_points.length}}" class="point-list"><text wx:for="{{document.key_points}}" wx:key="*this" class="point">{{index + 1}}. {{item}}</text></view></view><view wx:elif="{{document.organize_status === 'processing'}}" class="organize-pending">正在整理这份资料，稍后刷新即可查看摘要</view><view wx:if="{{isHtml}}" class="card document-content article-content"><rich-text nodes="{{htmlContent}}"></rich-text></view><view wx:else class="card document-content"><text>{{pageContent || '文档内容会在服务端解析后显示。'}}</text></view><view wx:if="{{!isHtml}}" class="reader-bottom row between"><button class="ghost-btn" bindtap="previous" disabled="{{pageIndex === 0}}"><ui-icon name="chevron-left" size="{{16}}" /> <text>上一页</text></button><text class="muted page-count">第 {{pageIndex + 1}} / {{pageTotal}} 页</text><button class="ghost-btn next-page" bindtap="next" disabled="{{pageIndex + 1 >= pageTotal}}"><text>下一页</text> <ui-icon name="chevron-right" size="{{16}}" /></button></view></view>
