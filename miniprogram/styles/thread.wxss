/* 会话线程共用样式：问AI独立问答页、知识库会话、文件夹会话三处共用一份，
   保证「问AI」与「知识库 / 文件夹」进入的会话在字号、间距、圆角、配色上完全一致。

   排版与配色只从 app.wxss 的令牌取值：字阶 22/24/26/28/32/36/40rpx、四级墨色、
   单一品牌绿。正文与过程区的层级差固定为 32 : 26，标题 36 及以上。
   注意：rich-text 里的 .md-* 节点用字面色值，自定义属性不一定继承进原生渲染层。 */

.qa-page { display: flex; flex-direction: column; width: 100%; max-width: 750rpx; height: 100vh; min-height: 0; margin: 0 auto; overflow: hidden; background: var(--surface); box-sizing: border-box; padding-bottom: env(safe-area-inset-bottom); }

/* 顶部：只留返回与胶囊按钮的安全高度 */
.qa-nav { position: relative; flex: 0 0 auto; }
button.qa-back { position: absolute; left: 6rpx; bottom: 0; display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; background: transparent; }
button.qa-back::after { border: 0; }
/* 返回右侧的折叠图标：拉出历史对话抽屉 */
button.qa-history { position: absolute; left: 80rpx; bottom: 0; display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; background: transparent; }
button.qa-history::after { border: 0; }
button.qa-history:active { background: var(--surface-soft); }
/* 会话页的上下文（知识库名 / 文件夹名）：居中、小字、弱对比，不与标题栏抢位置 */
.qa-context { position: absolute; right: 200rpx; bottom: 0; left: 190rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 88rpx; }
.qa-context-title { max-width: 100%; overflow: hidden; color: var(--ink-1); font-size: var(--t-body); font-weight: 600; line-height: 1.3; letter-spacing: 0; text-overflow: ellipsis; white-space: nowrap; }
.qa-context-sub { max-width: 100%; margin-top: 2rpx; overflow: hidden; color: var(--ink-4); font-size: var(--t-micro); line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }

/* 会话内的资料条：文件夹会话用它保留「本文件夹有哪些文件」的可达性 */
.qa-docstrip { flex: 0 0 auto; padding: 0 30rpx 8rpx; }
.qa-docstrip-scroll { white-space: nowrap; }
/* 必须带 button. 前缀：app.wxss 的 button[class] 会把 display 拉成 flex，横滑芯片会变成竖排 */
button.qa-docstrip-chip { display: inline-flex; align-items: center; gap: 8rpx; max-width: 420rpx; margin-right: 12rpx; padding: 12rpx 22rpx; border-radius: var(--r-pill); background: var(--surface-soft); color: var(--ink-2); font-size: var(--t-meta); line-height: 1.3; }
.qa-docstrip-chip:active { background: var(--surface-sink); }
.qa-docstrip-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.qa-body { flex: 1 1 auto; min-height: 0; height: 0; padding: 8rpx 30rpx 32rpx; box-sizing: border-box; }

/* 开场白：品牌头像 + 一句招呼 + 当前资料范围（本地消息，不写入对话历史） */
.qa-hello { display: flex; align-items: flex-start; gap: 20rpx; padding: 8rpx 0 4rpx; }
.qa-hello-avatar { flex: 0 0 76rpx; width: 76rpx; height: 76rpx; border-radius: var(--r-lg); background: var(--brand-soft); }
.qa-hello-copy { flex: 1 1 auto; min-width: 0; padding-top: 2rpx; }
.qa-hello-title { display: block; color: var(--ink-1); font-size: var(--t-h1); font-weight: 600; line-height: 1.4; letter-spacing: 0; }
.qa-hello-desc { display: block; margin-top: 8rpx; color: var(--ink-3); font-size: var(--t-lead); line-height: 1.7; }

/* 开场后的问答提示：直接发送，不再回填输入框 */
.qa-prompts { margin: 4rpx 0 8rpx; }
.qa-prompts-title { display: block; margin-bottom: 16rpx; color: var(--ink-4); font-size: var(--t-meta); font-weight: 400; line-height: 1.4; }
/* justify-content 必须显式写：app.wxss 的 button[class] 会把它居中对齐 */
button.qa-prompt { display: flex; align-items: flex-start; justify-content: flex-start; width: 100%; margin: 0 0 16rpx; padding: 26rpx 28rpx; border-radius: var(--r-lg); background: var(--surface); color: var(--brand-ink); font-size: var(--t-lead); font-weight: 500; line-height: 1.55; text-align: left; box-shadow: 0 2rpx 12rpx rgba(27, 33, 30, .05); }
button.qa-prompt:active { background: var(--brand-soft); }
button.qa-prompt::after { border: 0; }
.qa-prompts-hint { display: block; padding: 4rpx 0 12rpx; color: var(--ink-4); font-size: var(--t-meta); line-height: 1.5; }

/* 消息 */
.qa-message { margin: 28rpx 0 32rpx; }
.qa-message.user { display: flex; justify-content: flex-end; }
/* 多选态：消息往右让出勾选框的位置；勾选只用形状与淡底变化，不再加重底色 */
.qa-message.picking { position: relative; padding-left: 64rpx; }
.qa-pick { position: absolute; top: 6rpx; left: 0; display: flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; box-sizing: border-box; border: 2rpx solid #ccd3cd; border-radius: 50%; background: var(--surface); }
.qa-pick.on { border-color: var(--info-soft); background: var(--info-soft); }
.qa-pick.inline { position: static; flex: 0 0 44rpx; width: 44rpx; min-width: 44rpx; }
.qa-message.picking .qa-user-bubble { max-width: 78%; }
.qa-user-bubble { max-width: 82%; padding: 22rpx 28rpx; border-radius: var(--r-lg) var(--r-lg) 6rpx var(--r-lg); background: var(--brand-deep); color: #fff; font-size: var(--t-body); font-weight: 400; line-height: 1.65; letter-spacing: .2rpx; word-break: break-word; }
.qa-answer { min-width: 0; }
/* 正文：产品级字号与行高，长回答也不窒息 */
.qa-answer-text { display: block; color: var(--ink-1); font-size: var(--t-body); line-height: 1.75; letter-spacing: 0; white-space: normal; word-break: break-word; }
.qa-answer-text .md-p { margin: 0 0 16rpx; }
.qa-answer-text .md-p:last-child { margin-bottom: 0; }
.qa-answer-text .md-h { margin: 28rpx 0 12rpx; color: #1b211e; font-weight: 600; line-height: 1.45; }
.qa-answer-text .md-h1 { font-size: 36rpx; }
.qa-answer-text .md-h2 { font-size: 34rpx; }
.qa-answer-text .md-h3, .qa-answer-text .md-h4 { font-size: 32rpx; }

/*
  过程区（思考 / 步骤 / 工具 / 技能）：对齐 harness 的 ReasoningRow 与 ToolRow——
  折叠时只留「图标 + 标题 + 一行摘要 + 耗时」，展开才看思考全文与逐条动作。
*/
.qa-trace { margin: 0 0 20rpx; }
.qa-trace-head { display: flex; align-items: center; gap: 12rpx; min-height: 88rpx; padding: 4rpx 0; }
.qa-trace-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 40rpx; width: 40rpx; height: 40rpx; }
.qa-trace-head.live .qa-trace-icon { animation: qa-breathe 1.6s ease-in-out infinite; }
@keyframes qa-breathe { 0%, 100% { opacity: .45; } 50% { opacity: 1; } }
.qa-trace-title { display: block; flex: 0 0 auto; color: var(--ink-2); font-size: var(--t-row); font-weight: 600; line-height: 1.4; }
.qa-trace-head.live .qa-trace-title { color: var(--brand); }
.qa-trace-summary { display: block; flex: 1 1 auto; min-width: 0; overflow: hidden; color: var(--ink-3); font-size: var(--t-meta); line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.qa-trace-spacer { flex: 1 1 auto; min-width: 0; }
.qa-trace-elapsed { display: block; flex: 0 0 auto; color: var(--ink-4); font-size: var(--t-micro); line-height: 1.4; font-variant-numeric: tabular-nums; }
.qa-trace-chevron { display: flex; align-items: center; justify-content: center; flex: 0 0 32rpx; width: 32rpx; height: 32rpx; opacity: .5; }
.qa-trace-body { margin: 8rpx 0 4rpx; padding: 20rpx 22rpx 18rpx; border-radius: var(--r-md); background: var(--surface-soft); }
/* 思维链原文：展开时才完整呈现，次级色小字号，不抢正文；它下面不再跟别的行，所以不留分隔线 */
.qa-reason { display: block; color: var(--ink-3); font-size: var(--t-row); line-height: 1.72; white-space: pre-wrap; word-break: break-word; }
.qa-node { display: flex; align-items: flex-start; gap: 12rpx; margin-bottom: 16rpx; }
.qa-node-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 40rpx; width: 40rpx; height: 40rpx; border-radius: var(--r-sm); background: var(--surface-sink); }
.qa-node.error .qa-node-icon { background: var(--danger-soft); }
.qa-node.skill .qa-node-icon { background: var(--info-soft); }
.qa-node.agent .qa-node-icon { background: #f2eefb; }
.qa-node.run .qa-node-icon { background: var(--brand-soft); animation: qa-breathe 1.6s ease-in-out infinite; }
.qa-node-copy { flex: 1 1 auto; min-width: 0; padding-top: 4rpx; }
.qa-node-title { display: block; color: var(--ink-2); font-size: var(--t-row); line-height: 1.5; }
.qa-node.run .qa-node-title { color: var(--brand); }
.qa-node.error .qa-node-title { color: var(--danger); }
.qa-node-detail { display: block; margin-top: 4rpx; color: var(--ink-3); font-size: var(--t-meta); line-height: 1.5; word-break: break-all; }
.qa-node-state { display: block; flex: 0 0 auto; padding-top: 4rpx; color: var(--ink-4); font-size: var(--t-micro); line-height: 1.5; }
.qa-node-state.run { color: var(--brand); }
.qa-node-state.error { color: var(--danger); }

/* 执行步骤：不折叠、始终可见。「第 N 步 · 动作」是分组标题，具体的调用缩进一级挂在它下面 */
.qa-process { margin: 0 0 8rpx; }
.qa-node.step .qa-node-icon { background: var(--surface-sink); }
.qa-node.step .qa-node-title { color: var(--ink-2); font-weight: 600; }
.qa-node.nested { margin-left: 40rpx; }
.qa-node.nested .qa-node-title { color: var(--ink-3); font-weight: 400; }
.qa-answer-text .md-pre { margin: 16rpx 0; padding: 20rpx 24rpx; border-radius: 16rpx; background: #f4f6f4; font-family: Menlo, Consolas, monospace; font-size: 26rpx; line-height: 1.65; white-space: pre-wrap; word-break: break-all; }
.qa-answer-text .md-code { padding: 2rpx 10rpx; border-radius: 8rpx; background: #ecefec; font-family: Menlo, Consolas, monospace; font-size: 26rpx; }
.qa-answer-text .md-list { margin: 8rpx 0 16rpx; padding-left: 40rpx; }
.qa-answer-text .md-li { margin: 8rpx 0; }
.qa-answer-text .md-quote { margin: 12rpx 0; padding: 4rpx 0 4rpx 20rpx; border-left: 4rpx solid #d3ddd6; color: #4c554f; }
.qa-answer-text .md-link { color: #2f6fdd; text-decoration: underline; }
.qa-answer-text .md-del { color: #8f978f; text-decoration: line-through; }
.qa-answer-text .md-hr { height: 0; margin: 28rpx 0; border: 0; border-top: 1rpx solid #eef1ee; }
/* 表格：窄屏用固定布局等分列宽并自动换行，避免横向溢出 */
.qa-answer-text .md-table { width: 100%; margin: 20rpx 0; border: 1rpx solid #e7eae7; border-collapse: collapse; table-layout: fixed; }
.qa-answer-text .md-th, .qa-answer-text .md-td { padding: 16rpx 14rpx; border: 1rpx solid #e7eae7; color: #4c554f; font-size: 26rpx; line-height: 1.55; text-align: left; word-break: break-word; }
.qa-answer-text .md-th { background: #f4f6f4; color: #1b211e; font-weight: 600; }
.qa-progress { display: inline-flex; align-items: center; gap: 10rpx; padding: 12rpx 22rpx 12rpx 16rpx; border-radius: var(--r-pill); background: var(--surface-soft); }
.qa-progress-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 32rpx; width: 32rpx; height: 32rpx; animation: qa-breathe 1.6s ease-in-out infinite; }
.qa-progress-text { color: var(--ink-3); font-size: var(--t-row); line-height: 1.5; }
.qa-sources { margin-top: 16rpx; }
/*
  参考出处：默认收起，只留一行标题，点标题行才展开文件列表。
  收起态不画分隔线，靠上方留白和正文分开，回答底下更干净。
*/
.qa-sources-open { padding-top: 20rpx; border-top: 1rpx solid var(--line-soft); }
/* 标题行整行可点：点击区做到 88rpx（44px）——手指好按，看起来仍是一行小字 */
.qa-source-head { display: flex; align-items: center; gap: 8rpx; min-height: 88rpx; padding: 12rpx 0 10rpx; }
.qa-source-title { display: block; color: var(--ink-3); font-size: var(--t-micro); line-height: 1.4; }
.qa-source-arrow { display: flex; align-items: center; justify-content: center; width: 26rpx; height: 26rpx; transition: transform 0.18s ease; }
.qa-sources-open .qa-source-arrow { transform: rotate(180deg); }
.qa-source-list { margin-top: 12rpx; }
/* 参考出处一行一条：左图标右文字 */
.qa-source { display: flex; align-items: center; flex-direction: row; gap: 14rpx; margin-bottom: 12rpx; padding: 18rpx 20rpx; border-radius: var(--r-md); background: var(--surface-soft); }
.qa-source-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 44rpx; width: 44rpx; height: 44rpx; }
.qa-source-copy { flex: 1 1 auto; min-width: 0; }
.qa-source-file { display: block; color: var(--ink-2); font-size: var(--t-row); line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.qa-source-page { display: block; margin-top: 4rpx; color: var(--ink-4); font-size: var(--t-micro); line-height: 1.4; font-variant-numeric: tabular-nums; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.qa-answer-actions { display: flex; align-items: center; justify-content: flex-end; gap: 12rpx; margin-top: 20rpx; padding-top: 16rpx; border-top: 1rpx solid var(--line-soft); }
/* AI 生成内容标识：每条回答固定露出，满足生成合成内容的显式标识要求 */
.qa-ai-note { display: block; margin-top: 16rpx; color: var(--ink-4); font-size: var(--t-micro); line-height: 1.5; }

/*
  生成的文件（工具产物）：一行一张卡片，左侧类型图标、中间名称与体积、右侧保存。
  点卡片直接预览（图片 / 文档走微信原生预览，文本走站内预览页）；
  右侧小按钮把文件转发到微信聊天，用户可在聊天里保存到手机。
*/
.qa-files { margin: 20rpx 0 4rpx; }
.qa-files-title { display: block; margin-bottom: 12rpx; color: var(--ink-4); font-size: var(--t-micro); line-height: 1.4; }
.qa-file { display: flex; align-items: center; justify-content: flex-start; gap: 18rpx; margin-bottom: 12rpx; padding: 20rpx; border: 1rpx solid var(--line-soft); border-radius: var(--r-lg); background: var(--surface); }
.qa-file:last-child { margin-bottom: 0; }
.qa-file-hover { background: var(--surface-soft); }
.qa-file.picked { border-color: #cfe0f8; background: #f6f9ff; }
.qa-file-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 56rpx; width: 56rpx; height: 56rpx; }
.qa-file-copy { flex: 1 1 auto; min-width: 0; }
.qa-file-name { display: block; color: var(--ink-1); font-size: var(--t-lead); font-weight: 600; line-height: 1.42; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.qa-file-meta { display: block; margin-top: 4rpx; color: var(--ink-4); font-size: var(--t-micro); line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
button.qa-file-save { display: flex; align-items: center; justify-content: center; flex: 0 0 80rpx; width: 80rpx; min-width: 80rpx; height: 80rpx; min-height: 80rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; background: var(--surface-soft); }
button.qa-file-save:active { background: var(--surface-sink); }
button.qa-file-save::after { border: 0; }

button.qa-action { display: flex; align-items: center; gap: 8rpx; min-height: 80rpx; margin: 0; padding: 0 20rpx; border: 0; border-radius: var(--r-md); background: var(--surface-soft); color: var(--ink-2); font-size: var(--t-meta); line-height: 1.3; }
button.qa-action:active { background: var(--surface-sink); }

.qa-state { display: flex; flex-direction: column; align-items: center; padding: 140rpx 30rpx 0; text-align: center; }
.qa-state-title { color: var(--ink-1); font-size: var(--t-body); font-weight: 600; line-height: 1.5; }
.qa-state-desc { margin-top: 10rpx; color: var(--ink-3); font-size: var(--t-row); line-height: 1.6; }
button.qa-outline-button { min-width: 240rpx; min-height: 88rpx; margin-top: 28rpx; border: 1rpx solid var(--line); border-radius: var(--r-md); background: var(--surface); color: var(--ink-2); font-size: var(--t-lead); font-weight: 600; }

/* 输入卡片 */
.qa-footer { flex-shrink: 0; padding: 10rpx 24rpx 18rpx; background: var(--surface); }
.qa-composer { position: relative; overflow: hidden; border: 1rpx solid var(--line); border-radius: var(--r-xl); background: var(--surface); box-shadow: 0 2rpx 12rpx rgba(27, 33, 30, .04); }
.qa-input { display: block; width: 100%; min-height: 150rpx; max-height: 440rpx; box-sizing: border-box; padding: 32rpx 28rpx 0; color: var(--ink-1); font-size: var(--t-body); font-weight: 400; line-height: 1.5; }
/* 已选技能提示：小胶囊 + 一键取消，不占正文位置 */
.qa-skill-chip { display: inline-flex; align-items: center; gap: 8rpx; margin: 22rpx 28rpx 0; padding: 8rpx 10rpx 8rpx 20rpx; border-radius: var(--r-pill); background: var(--info-soft); }
.qa-skill-chip-text { color: var(--info); font-size: var(--t-meta); line-height: 1.3; }
button.qa-skill-chip-close, button.qa-skill-chip-close::after { display: flex; align-items: center; justify-content: center; flex: 0 0 44rpx; width: 44rpx; min-width: 44rpx; height: 44rpx; min-height: 44rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; background: transparent; opacity: .7; }
.qa-bar { display: flex; align-items: center; gap: 6rpx; height: 112rpx; padding: 0 12rpx 0 20rpx; box-sizing: border-box; }
.qa-bar-spacer { flex: 1 1 auto; min-width: 0; }
/* 小机器人：参考稿里是一块淡蓝底的圆角方块，右侧跟一个下拉箭头表示可切换 */
button.qa-logic { display: flex; align-items: center; justify-content: center; gap: 2rpx; flex: 0 0 auto; width: auto; min-width: 80rpx; height: 80rpx; min-height: 80rpx; margin: 0; padding: 0 12rpx 0 16rpx; border: 0; border-radius: var(--r-lg); background: var(--info-soft); line-height: 1; }
button.qa-logic.knowledge { background: var(--info-soft); }
button.qa-logic.planner { background: var(--brand-soft); }
button.qa-skill { display: flex; align-items: center; justify-content: center; gap: 2rpx; flex: 0 0 auto; width: auto; min-width: 80rpx; height: 80rpx; min-height: 80rpx; margin: 0 0 0 4rpx; padding: 0 10rpx; border: 0; border-radius: var(--r-lg); background: transparent; line-height: 1; }
button.qa-model { display: flex; align-items: center; justify-content: center; flex: 0 0 80rpx; width: 80rpx; min-width: 80rpx; height: 80rpx; min-height: 80rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; background: transparent; }
button.qa-scope { display: flex; align-items: center; justify-content: center; gap: 4rpx; flex: 0 0 auto; width: auto; min-width: 80rpx; height: 80rpx; min-height: 80rpx; margin: 0 0 0 6rpx; padding: 0 8rpx; border: 0; border-radius: var(--r-pill); background: transparent; line-height: 1; }
/* 发送/停止：图标自带实心底，按钮只负责热区与对齐——热区 88rpx（44px），三态尺寸完全一致 */
button.qa-send, button.qa-send[disabled] { display: flex; align-items: center; justify-content: center; flex: 0 0 88rpx; width: 88rpx; min-width: 88rpx; height: 88rpx; min-height: 88rpx; margin: 0 0 0 8rpx; padding: 0; border: 0; border-radius: 50%; background: transparent; box-shadow: none; opacity: 1; }
button.qa-send::after, button.qa-logic::after, button.qa-skill::after, button.qa-scope::after, button.qa-model::after, button.qa-action::after, button.qa-outline-button::after, button.sheet-close::after, button.skill-row::after, button.scope-doc::after, button.scope-dir::after, button.kb-confirm::after, button.qa-docstrip-chip::after, button.qa-send::after { border: 0; }

/* 通用底部弹层 */
.sheet-layer { position: fixed; z-index: 90; top: 0; right: 0; bottom: 0; left: 0; }
.sheet-mask { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: rgba(27, 33, 30, .42); }
.sheet-panel { position: absolute; right: 0; bottom: 0; left: 0; max-width: 750rpx; margin: 0 auto; box-sizing: border-box; padding: 40rpx 32rpx calc(36rpx + env(safe-area-inset-bottom)); border-radius: var(--r-xl) var(--r-xl) 0 0; background: var(--surface); }
.sheet-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 32rpx; }
.sheet-title { color: var(--ink-1); font-size: var(--t-h1); font-weight: 600; line-height: 1.3; letter-spacing: 0; }
button.sheet-close { display: flex; align-items: center; justify-content: center; flex: 0 0 64rpx; width: 64rpx; min-width: 64rpx; height: 64rpx; min-height: 64rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; background: var(--surface-soft); }
button.sheet-close:active { background: var(--surface-sink); }

/* 更多选项 */
.option-card { display: flex; align-items: center; gap: 22rpx; padding: 26rpx 28rpx; border: 1rpx solid var(--line-soft); border-radius: var(--r-lg); background: var(--surface); }
.option-card:active { background: var(--surface-soft); }
.option-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 72rpx; width: 72rpx; height: 72rpx; }
.option-copy { flex: 1 1 auto; min-width: 0; }
.option-name { display: block; color: var(--ink-1); font-size: var(--t-body); font-weight: 600; line-height: 1.35; }
.option-desc { display: block; margin-top: 6rpx; color: var(--ink-3); font-size: var(--t-row); line-height: 1.35; }
.option-pill { flex: 0 0 auto; padding: 10rpx 24rpx; border-radius: var(--r-pill); background: var(--surface-soft); color: var(--ink-4); font-size: var(--t-meta); line-height: 1.1; }
.option-pill.on { background: var(--brand-soft); color: var(--brand-ink); font-weight: 600; }

/* 技能 */
button.skill-row { display: flex; align-items: center; gap: 22rpx; width: 100%; min-height: 112rpx; margin: 0; padding: 18rpx 24rpx; border: 0; border-radius: var(--r-lg); background: var(--surface); text-align: left; }
button.skill-row:active { background: var(--surface-soft); }
.skill-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 72rpx; width: 72rpx; height: 72rpx; border-radius: var(--r-lg); background: var(--surface-soft); }
.skill-copy { flex: 1 1 auto; min-width: 0; }
.skill-name { display: block; color: var(--ink-1); font-size: var(--t-body); font-weight: 600; line-height: 1.4; }
.skill-desc { display: block; margin-top: 4rpx; color: var(--ink-3); font-size: var(--t-meta); line-height: 1.4; }

/* 选择知识 */
.knowledge-panel { display: flex; flex-direction: column; max-height: 80vh; }
.kb-search { display: flex; align-items: center; gap: 16rpx; height: 88rpx; padding: 0 26rpx; border-radius: var(--r-md); background: var(--surface-soft); }
.kb-search-input { flex: 1 1 auto; min-width: 0; color: var(--ink-1); font-size: var(--t-lead); }
button.kb-dir { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 96rpx; margin: 24rpx 0 0; padding: 0 26rpx; border: 0; border-radius: var(--r-md); background: var(--surface-soft); color: var(--ink-1); font-size: var(--t-body); font-weight: 500; line-height: 1.3; text-align: left; }
button.kb-dir:active { background: var(--surface-sink); }
.kb-section { display: block; margin: 32rpx 0 12rpx; color: var(--ink-4); font-size: var(--t-meta); }
.kb-list { flex: 1 1 auto; min-height: 0; max-height: 520rpx; }
.kb-row { display: flex; align-items: center; gap: 20rpx; min-height: 104rpx; }
.kb-radio { flex: 0 0 40rpx; width: 40rpx; height: 40rpx; box-sizing: border-box; border: 3rpx solid #ccd3cd; border-radius: 50%; }
.kb-radio.on { border-color: var(--brand); background: var(--brand); box-shadow: inset 0 0 0 8rpx #fff; }
.kb-name { flex: 1 1 auto; min-width: 0; color: var(--ink-1); font-size: var(--t-body); line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.kb-empty { padding: 48rpx 0; color: var(--ink-4); font-size: var(--t-row); text-align: center; }
.kb-foot { display: flex; justify-content: flex-end; padding-top: 24rpx; }
button.kb-confirm { min-width: 200rpx; height: 88rpx; margin: 0; padding: 0 40rpx; border: 0; border-radius: var(--r-md); background: var(--brand-deep); color: #fff; font-size: var(--t-body); font-weight: 600; line-height: 88rpx; }
button.kb-confirm:active { background: var(--brand-ink); }

/* 文件夹会话：范围弹层里列出本文件夹资料 */
.scope-panel { display: flex; flex-direction: column; max-height: 80vh; }
.scope-hint { display: block; margin: -12rpx 0 22rpx; color: var(--ink-3); font-size: var(--t-meta); line-height: 1.5; }
.scope-list { flex: 1 1 auto; min-height: 0; max-height: 620rpx; }
button.scope-doc { display: flex; align-items: center; gap: 18rpx; width: 100%; min-height: 104rpx; margin: 0; padding: 0 10rpx; border: 0; border-radius: var(--r-md); background: var(--surface); text-align: left; }
button.scope-doc:active { background: var(--surface-soft); }
.scope-doc-name { flex: 1 1 auto; min-width: 0; color: var(--ink-1); font-size: var(--t-body); line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.scope-doc-type { flex: 0 0 auto; color: var(--ink-4); font-size: var(--t-micro); }
button.scope-dir { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 96rpx; margin: 24rpx 0 0; padding: 0 26rpx; border: 0; border-radius: var(--r-md); background: var(--surface-soft); color: var(--ink-1); font-size: var(--t-body); font-weight: 500; line-height: 1.3; text-align: left; }
button.scope-dir:active { background: var(--surface-sink); }
.scope-empty { padding: 44rpx 0; color: var(--ink-4); font-size: var(--t-row); line-height: 1.6; text-align: center; }
