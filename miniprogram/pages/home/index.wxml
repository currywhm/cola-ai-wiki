<view class="page home-page">
  <app-nav title="cola 知识库" />
  <view class="library-head"><view class="grow"><text class="library-title">cola 知识库</text><text class="library-subtitle">{{knowledge.length}} 个资料库</text></view><view class="library-actions"><button class="head-action" bindtap="toggleSearch" aria-label="搜索资料库"><ui-icon name="search" size="{{21}}" /></button><button class="head-action head-add" bindtap="createKnowledge" aria-label="创建资料库"><ui-icon name="plus" size="{{22}}" /></button></view></view>
  <view wx:if="{{searchVisible}}" class="search-bar list-search"><ui-icon name="search" size="{{20}}" /><input value="{{query}}" placeholder="搜索资料库" focus="{{searchVisible}}" bindinput="filterInput" confirm-type="search" /></view>
  <view wx:if="{{loadState === 'loading'}}" class="card state-card"><view class="skeleton"></view><view class="skeleton short"></view><text class="state-desc">正在加载你的资料…</text></view>
  <view wx:elif="{{loadState === 'loggedout'}}" class="card state-card"><view class="state-icon"><ui-icon name="user" size="{{32}}" /></view><text class="state-title">已退出登录</text><text class="state-desc">重新使用微信登录后即可查看你的资料。</text><button class="ghost-btn" bindtap="login">使用微信登录</button></view>
  <view wx:elif="{{loadState === 'error'}}" class="card state-card"><view class="state-icon"><ui-icon name="shield" size="{{32}}" /></view><text class="state-title">暂时无法连接资料</text><text class="state-desc">请检查网络后重试。</text><button class="ghost-btn" bindtap="load">重新加载</button></view>
  <block wx:if="{{loadState === 'ready'}}"><view wx:for="{{visibleKnowledge}}" wx:key="id" class="kb-row" bindtap="openKnowledge" data-id="{{item.id}}"><view class="book-icon"><ui-icon name="folder" size="{{21}}" /></view><view class="grow"><text class="kb-name">{{item.name}}</text><text class="kb-meta">{{item.document_count || 0}} 份文档 · {{item.displayDate}} 更新</text></view><ui-icon name="chevron-right" size="{{18}}" /></view><view wx:if="{{!visibleKnowledge.length}}" class="card state-card"><view class="state-icon"><ui-icon name="folder" size="{{32}}" /></view><text class="state-title">从第一份资料开始</text><text class="state-desc">创建资料库后，添加文件、整理内容，再向资料提问。</text><button class="ghost-btn" bindtap="createKnowledge">创建资料库</button></view></block>
</view>
