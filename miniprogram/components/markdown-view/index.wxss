/* 正文不让系统选中：长按留给小程序的「多选分享」，避免 iOS 选择菜单与页面按钮打架；
   复制统一走回答下方的「复制」按钮（复制渲染后的纯文本）。 */
.md-view, .md-view rich-text { user-select: none; -webkit-user-select: none; }
/* Markdown 正文渲染：与对话线程（thread.wxss）共用同一套字阶与墨色，
   保证同一条回答在会话页、产物页、分享页看起来完全一致。 */
.md-view { min-width: 0; color: var(--ink-1, #1b211e); font-size: 32rpx; line-height: 1.75; letter-spacing: 0; white-space: normal; word-break: break-word; }
.md-part { display: block; }
/* 流式尾段：与段落保持同样的下边距，边界前移时不会因为块级切换把正文往上顶一下 */
.md-stream { white-space: pre-wrap; margin: 0 0 16rpx; }
.md-stream:last-child { margin-bottom: 0; }

.md-part .md-p { margin: 0 0 16rpx; }
.md-part .md-p:last-child { margin-bottom: 0; }
.md-part .md-h { margin: 28rpx 0 12rpx; color: var(--ink-1, #1b211e); font-weight: 600; line-height: 1.45; }
.md-part .md-h1 { font-size: 36rpx; }
.md-part .md-h2 { font-size: 34rpx; }
.md-part .md-h3, .md-part .md-h4 { font-size: 32rpx; }
.md-part .md-pre { margin: 16rpx 0; padding: 20rpx 24rpx; border-radius: 16rpx; background: var(--surface-soft, #f4f6f4); font-family: Menlo, Consolas, monospace; font-size: 26rpx; line-height: 1.65; white-space: pre-wrap; word-break: break-all; }
.md-part .md-code { padding: 2rpx 10rpx; border-radius: 8rpx; background: var(--surface-sink, #ecefec); font-family: Menlo, Consolas, monospace; font-size: 26rpx; }
.md-part .md-list { margin: 8rpx 0 16rpx; padding-left: 40rpx; }
.md-part .md-li { margin: 8rpx 0; }
.md-part .md-quote { margin: 12rpx 0; padding: 4rpx 0 4rpx 20rpx; border-left: 4rpx solid #d3ddd6; color: var(--ink-2, #4c554f); }
.md-part .md-link { color: var(--info, #2f6fdd); text-decoration: underline; }
.md-part .md-del { color: var(--ink-4, #8f978f); text-decoration: line-through; }
.md-part .md-hr { height: 0; margin: 28rpx 0; border: 0; border-top: 1rpx solid var(--line-soft, #eef1ee); }
.md-part .md-table { width: 100%; margin: 20rpx 0; border: 1rpx solid var(--line, #e7eae7); border-collapse: collapse; table-layout: fixed; }
.md-part .md-th, .md-part .md-td { padding: 16rpx 14rpx; border: 1rpx solid var(--line, #e7eae7); color: var(--ink-2, #4c554f); font-size: 26rpx; line-height: 1.55; text-align: left; word-break: break-word; }
.md-part .md-th { background: var(--surface-soft, #f4f6f4); color: var(--ink-1, #1b211e); font-weight: 600; }
.md-part .md-task { display: flex; align-items: flex-start; gap: 12rpx; margin: 8rpx 0; }
.md-part .md-task-box { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 32rpx; width: 32rpx; height: 32rpx; margin-top: 4rpx; box-sizing: border-box; border: 2rpx solid #ccd3cd; border-radius: 10rpx; color: #fff; font-size: 24rpx; line-height: 1; }
.md-part .md-task.is-checked .md-task-box { border-color: var(--brand, #078b50); background: var(--brand, #078b50); }
.md-part .md-task.is-checked .md-task-text { color: var(--ink-4, #8f978f); text-decoration: line-through; }
.md-part .md-formula { display: inline-block; padding: 0 6rpx; border-radius: 8rpx; background: var(--surface-soft, #f4f6f4); color: var(--ink-2, #4c554f); font-family: Menlo, Consolas, monospace; font-size: 26rpx; }
.md-part .md-formula-block { margin: 16rpx 0; padding: 20rpx 22rpx; overflow: hidden; border-radius: 16rpx; background: var(--surface-soft, #f4f6f4); color: var(--ink-2, #4c554f); font-family: Menlo, Consolas, monospace; font-size: 26rpx; line-height: 1.65; word-break: break-all; }
.md-part .md-image-inline { max-width: 100%; height: auto; border-radius: 16rpx; }
.md-part .md-footnotes { margin-top: 24rpx; padding-top: 16rpx; border-top: 1rpx solid var(--line-soft, #eef1ee); }
.md-part .md-footnote { display: flex; gap: 10rpx; margin: 8rpx 0; color: var(--ink-3, #6d756e); font-size: 24rpx; line-height: 1.6; }
.md-part .md-footnote-id { flex: 0 0 auto; color: var(--brand, #078b50); font-weight: 600; }

.md-code-card { margin: 20rpx 0; overflow: hidden; border: 1rpx solid var(--line-soft, #eef1ee); border-radius: 16rpx; background: var(--surface-soft, #f4f6f4); }
.md-code-head { display: flex; align-items: center; justify-content: space-between; height: 72rpx; padding: 0 16rpx 0 22rpx; border-bottom: 1rpx solid var(--line-soft, #eef1ee); background: var(--surface-sink, #ecefec); }
.md-code-lang { color: var(--ink-3, #6d756e); font-family: Menlo, Consolas, monospace; font-size: 24rpx; font-weight: 600; letter-spacing: .4rpx; }
.md-code-copy.md-code-copy { display: flex; align-items: center; gap: 6rpx; min-width: 0; min-height: 64rpx; margin: 0; padding: 0 16rpx; border: 0; border-radius: 12rpx; background: transparent; color: var(--ink-2, #4c554f); font-size: 24rpx; line-height: 1; }
.md-code-copy.md-code-copy:active { background: #e2e7e3; }
.md-code-copy.md-code-copy::after, .md-link-row.md-link-row::after { border: 0; }
.md-code-scroll { width: 100%; overflow: hidden; }
.md-code-content { display: block; padding: 22rpx 24rpx; color: var(--ink-1, #1b211e); font-family: Menlo, Consolas, monospace; font-size: 26rpx; line-height: 1.65; word-break: break-all; }
.md-code-content .tok-comment { color: var(--ink-4, #8f978f); }
.md-code-content .tok-string { color: var(--brand-ink, #04613a); }
.md-code-content .tok-number { color: #b15c00; }
.md-code-content .tok-keyword { color: #245fc2; font-weight: 600; }

.md-image-card { margin: 20rpx 0; overflow: hidden; border-radius: 16rpx; background: var(--surface-soft, #f4f6f4); }
.md-image { display: block; width: 100%; border-radius: 16rpx; }
.md-image-caption { display: block; padding: 14rpx 18rpx 18rpx; color: var(--ink-4, #8f978f); font-size: 24rpx; line-height: 1.5; text-align: center; }

.md-links { margin-top: 24rpx; padding-top: 16rpx; border-top: 1rpx solid var(--line-soft, #eef1ee); }
.md-links-title { display: block; margin-bottom: 8rpx; color: var(--ink-4, #8f978f); font-size: 24rpx; line-height: 1.4; }
.md-link-row.md-link-row { display: flex; align-items: center; gap: 14rpx; width: 100%; min-height: 88rpx; margin: 0; padding: 12rpx 8rpx; border: 0; background: transparent; text-align: left; }
.md-link-row.md-link-row:active { background: var(--surface-soft, #f4f6f4); }
.md-link-copy { flex: 1 1 auto; min-width: 0; }
.md-link-label { display: block; color: var(--info, #2f6fdd); font-size: 26rpx; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.md-link-url { display: block; margin-top: 4rpx; color: var(--ink-4, #8f978f); font-size: 22rpx; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
