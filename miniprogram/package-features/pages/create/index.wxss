.kb-avatar-picker { display:flex; flex-direction:column; align-items:center; margin:-12rpx 0 26rpx; }
.kb-avatar-preview,.kb-avatar-placeholder { display:flex; align-items:center; justify-content:center; width:132rpx; height:132rpx; overflow:hidden; border:1rpx solid #dcebe2; border-radius:32rpx; background:#eef8f2; color:#079758; box-shadow:0 8rpx 22rpx rgba(10,120,70,.08); }
.kb-avatar-preview { display:block; }
.kb-avatar-label { margin-top:12rpx; color:#079758; font-size:24rpx; font-weight:600; line-height:1.4; }
.kb-avatar-privacy { margin-top:8rpx; color:#8a8e9f; font-size:21rpx; line-height:1.45; text-align:center; }
.create-intro { text-align:center; margin:20rpx 0 36rpx; }
.create-intro .state-icon { background:#eaf9f1; color:#078b50; }
.create-intro .headline { font-size:40rpx; margin:22rpx 0 12rpx; }
.create-intro .muted { font-size:25rpx; }
.form-card { margin-bottom:28rpx; padding:30rpx; }
.field-label { display:block; font-size:28rpx; font-weight:600; margin-bottom:16rpx; }
.required,.optional { font-size:22rpx; color:#8a8e9f; font-weight:400; margin-left:8rpx; }
.form-input,.form-textarea { box-sizing:border-box; width:100%; background:#fff; padding:20rpx; border:1rpx solid #dedbd4; border-radius:16rpx; font-size:27rpx; line-height:1.55; }
.form-input { height:88rpx; }
.form-textarea { height:220rpx; }
.counter { display:block; text-align:right; color:#8a8e9f; font-size:22rpx; margin:8rpx 0 28rpx; }
.counter:last-child { margin-bottom:0; }
.form-note { display:block; text-align:center; font-size:23rpx; color:#8a8e9f; margin:24rpx 0; }
.form-error { display:block; color:#b23939; background:#fff0f0; border-radius:16rpx; padding:20rpx; margin-bottom:20rpx; font-size:25rpx; }
/* 新建入口默认落在「个人知识库」：一行说清楚，不另外加卡片占地方 */
.scope-note { display:block; margin:-16rpx 0 26rpx; color:#8a8e9f; font-size:24rpx; line-height:1.5; text-align:center; }
/* 名额用完时多一个退出：样式比主按钮轻，不和「创建知识库」抢主次 */
button.ghost-btn { display:block; width:100% !important; min-width:0 !important; min-height:88rpx; margin:0 0 20rpx; padding:0; border:1rpx solid #d7e5dc; border-radius:999rpx; background:#fff; color:#079758; font-size:28rpx; font-weight:600; line-height:86rpx; }
button.ghost-btn::after { border:0; }
button.ghost-btn:active { background:#f2f8f4; }
