.search-page { padding-top:0; background:#f7f7f7; }
.search-row { display:flex; align-items:center; gap:16rpx; margin-top:16rpx; }
.search-field { display:flex; align-items:center; flex:1; min-width:0; gap:12rpx; min-height:78rpx; padding:0 26rpx; border-radius:39rpx; background:#efefef; color:#9aa0a6; }
.search-field input { flex:1; width:0; min-width:0; height:74rpx; color:#23262b; font-size:31rpx; }
button.search-clear { display:flex; align-items:center; justify-content:center; flex:0 0 36rpx; width:36rpx; min-width:36rpx; height:36rpx; min-height:36rpx; padding:0; border-radius:50%; background:#c9ccd0; color:#fff; }
.search-cancel { display:flex; align-items:center; flex:0 0 auto; min-height:78rpx; padding:0 10rpx; background:transparent; color:#0aa05c; font-size:30rpx; font-weight:500; }
.result-count { margin: 24rpx 4rpx 14rpx; font-size: 24rpx; }
.result-card { margin-bottom: 14rpx; }
.result-file { max-width: 68%; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.result-kb { display:inline-block; margin-top:10rpx; padding:2rpx 12rpx; border-radius:8rpx; background:#edf7f2; color:#079758; font-size:20rpx; line-height:1.6; }
.result-content { display: block; margin: 16rpx 0; line-height: 1.7; color: #3e4759; word-break: break-word; }

.result-card .row { gap:14rpx; }
.result-file { flex:1; max-width:none; }
