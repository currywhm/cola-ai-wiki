<view class="page search-page"><app-nav title="cola知识库" showContext="{{false}}" menu bind:menutap="openMine" /><view class="search-row"><view class="search-field"><ui-icon name="search" size="{{18}}" /><input value="{{query}}" placeholder="搜索知识库内容" focus bindinput="input" bindconfirm="submit" confirm-type="search"/><button wx:if="{{query}}" class="search-clear" bindtap="clearQuery" aria-label="清空"><ui-icon name="close" size="{{14}}" /></button></view><button class="search-cancel" bindtap="back">取消</button></view><view wx:if="{{error}}" class="card state-card"><text class="state-desc">{{error}}</text><button class="ghost-btn" bindtap="submit">重试</button></view><view class="muted result-count" wx:if="{{searched}}">找到 {{results.length}} 个结果</view><block wx:for="{{results}}" wx:key="id"><view class="card result-card"><view class="row between"><text class="result-file">{{item.filename}}</text><text class="tag">第 {{item.page_number}} 页</text></view><text wx:if="{{item.knowledge_name}}" class="result-kb">{{item.knowledge_name}}</text><text class="result-content">{{item.content}}</text><view class="link" bindtap="openDocument" data-id="{{item.document_id}}">打开原文 <ui-icon name="chevron-right" size="{{14}}" /></view></view></block><view wx:if="{{searched && !results.length}}" class="card empty"><text class="empty-title">没有找到匹配内容</text><text class="muted block">换个关键词或使用更自然的描述试试</text></view></view>
