.usage-page { min-height:100vh; padding:0 24rpx calc(64rpx + env(safe-area-inset-bottom)); background:#f5f6f6; color:#17191d; }
.usage-state { padding:48rpx 8rpx; }
.usage-skeleton { border-radius:16rpx; background:#e9eceb; }
.usage-skeleton-title { width:48%; height:36rpx; }
.usage-skeleton-card { height:180rpx; margin-top:24rpx; }
.usage-state-title { display:block; color:#17191d; font-size:32rpx; font-weight:700; line-height:1.45; }
.usage-state-desc { display:block; margin-top:10rpx; color:#7b858e; font-size:26rpx; line-height:1.65; }
button.usage-retry { width:100%; min-height:88rpx; margin-top:26rpx; border:0; border-radius:16rpx; background:#1677ff; color:#fff; font-size:29rpx; font-weight:600; }
.usage-hero { padding:34rpx 30rpx; border-radius:22rpx; background:#fff; }
.usage-hero-title { display:block; color:#17191d; font-size:34rpx; font-weight:750; line-height:1.35; }
.usage-hero-desc { display:block; margin-top:10rpx; color:#7f8993; font-size:25rpx; line-height:1.55; }
.usage-section { margin-top:20rpx; padding:28rpx 28rpx 30rpx; border-radius:22rpx; background:#fff; }
.usage-section-head { display:flex; align-items:baseline; justify-content:space-between; gap:18rpx; }
.usage-section-title { color:#17191d; font-size:29rpx; font-weight:700; line-height:1.4; }
.usage-section-value { flex:0 1 auto; color:#7e8993; font-size:23rpx; line-height:1.45; text-align:right; }
.usage-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12rpx; margin-top:20rpx; }
.usage-item { padding:22rpx 8rpx; border-radius:16rpx; background:#f6f8f7; text-align:center; }
.usage-num { display:block; color:#172432; font-size:38rpx; font-weight:700; line-height:1.25; }
.usage-label { display:block; margin-top:6rpx; color:#8d98a3; font-size:22rpx; line-height:1.35; }
.usage-track { width:100%; height:18rpx; margin-top:22rpx; overflow:hidden; border-radius:9rpx; background:#eaf4f0; }
.usage-fill { height:100%; min-width:8rpx; border-radius:9rpx; background:#08a766; transition:width .25s ease; }
.usage-track.quota { background:#eef1f4; }
.usage-fill.quota-fill { background:#3c6f99; }
.usage-note { display:block; margin-top:14rpx; color:#939ca6; font-size:22rpx; line-height:1.55; }
