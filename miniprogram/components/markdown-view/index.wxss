.md-view { min-width:0; color:#22262b; font-size:29rpx; line-height:1.78; letter-spacing:.2rpx; white-space:normal; word-break:break-word; }
.md-part { display:block; }
/* 流式尾段：与段落保持同样的下边距，边界前移时不会因为块级切换把正文往上顶一下 */
.md-stream { white-space:pre-wrap; margin:0 0 14rpx; }
.md-stream:last-child { margin-bottom:0; }

.md-part .md-p { margin:0 0 14rpx; }
.md-part .md-p:last-child { margin-bottom:0; }
.md-part .md-h { margin:20rpx 0 10rpx; color:#191c20; font-weight:650; line-height:1.45; }
.md-part .md-h1 { font-size:34rpx; }
.md-part .md-h2 { font-size:32rpx; }
.md-part .md-h3, .md-part .md-h4 { font-size:30rpx; }
.md-part .md-pre { margin:12rpx 0; padding:18rpx 22rpx; border-radius:12rpx; background:#f4f5f6; font-family:Menlo,Consolas,monospace; font-size:25rpx; line-height:1.6; white-space:pre-wrap; word-break:break-all; }
.md-part .md-code { padding:2rpx 8rpx; border-radius:6rpx; background:#f0f1f2; font-family:Menlo,Consolas,monospace; font-size:25rpx; }
.md-part .md-list { margin:8rpx 0 12rpx; padding-left:36rpx; }
.md-part .md-li { margin:6rpx 0; }
.md-part .md-quote { margin:10rpx 0; padding-left:16rpx; border-left:4rpx solid #d8dce2; color:#6b7280; }
.md-part .md-link { color:#2f6fdd; text-decoration:underline; }
.md-part .md-del { color:#9aa1a9; text-decoration:line-through; }
.md-part .md-hr { height:0; margin:22rpx 0; border:0; border-top:1rpx solid #eceef0; }
.md-part .md-table { width:100%; margin:18rpx 0; border:1rpx solid #e6e9ec; border-collapse:collapse; table-layout:fixed; }
.md-part .md-th, .md-part .md-td { padding:14rpx 12rpx; border:1rpx solid #e6e9ec; color:#33383e; font-size:24rpx; line-height:1.5; text-align:left; word-break:break-word; }
.md-part .md-th { background:#f6f7f8; font-weight:600; }
.md-part .md-task { display:flex; align-items:flex-start; gap:12rpx; margin:8rpx 0; }
.md-part .md-task-box { display:inline-flex; align-items:center; justify-content:center; flex:0 0 30rpx; width:30rpx; height:30rpx; margin-top:4rpx; box-sizing:border-box; border:2rpx solid #cbd1d7; border-radius:8rpx; color:#fff; font-size:22rpx; line-height:1; }
.md-part .md-task.is-checked .md-task-box { border-color:#0a9b5c; background:#0a9b5c; }
.md-part .md-task.is-checked .md-task-text { color:#7b838c; text-decoration:line-through; }
.md-part .md-formula { display:inline-block; padding:0 6rpx; border-radius:6rpx; background:#f6f7f8; color:#4d5661; font-family:Menlo,Consolas,monospace; font-size:25rpx; }
.md-part .md-formula-block { margin:14rpx 0; padding:18rpx 20rpx; overflow:hidden; border-radius:12rpx; background:#f7f8f9; color:#4d5661; font-family:Menlo,Consolas,monospace; font-size:25rpx; line-height:1.6; word-break:break-all; }
.md-part .md-image-inline { max-width:100%; height:auto; border-radius:12rpx; }
.md-part .md-footnotes { margin-top:24rpx; padding-top:16rpx; border-top:1rpx solid #eceff0; }
.md-part .md-footnote { display:flex; gap:10rpx; margin:8rpx 0; color:#727b85; font-size:23rpx; line-height:1.6; }
.md-part .md-footnote-id { flex:0 0 auto; color:#0a9b5c; font-weight:600; }

.md-code-card { margin:18rpx 0; overflow:hidden; border:1rpx solid #e5e8eb; border-radius:16rpx; background:#f7f8f9; }
.md-code-head { display:flex; align-items:center; justify-content:space-between; height:68rpx; padding:0 16rpx 0 22rpx; border-bottom:1rpx solid #e5e8eb; background:#f1f3f5; }
.md-code-lang { color:#6c7580; font-family:Menlo,Consolas,monospace; font-size:22rpx; font-weight:600; letter-spacing:.4rpx; }
.md-code-copy.md-code-copy { display:flex; align-items:center; gap:6rpx; min-width:0; min-height:52rpx; margin:0; padding:0 12rpx; border:0; border-radius:12rpx; background:transparent; color:#66717d; font-size:22rpx; line-height:1; }
.md-code-copy.md-code-copy:active { background:#e5e9ed; }
.md-code-copy.md-code-copy::after, .md-link-row.md-link-row::after { border:0; }
.md-code-scroll { width:100%; overflow:hidden; }
.md-code-content { display:block; padding:20rpx 22rpx; color:#2f363d; font-family:Menlo,Consolas,monospace; font-size:24rpx; line-height:1.62; word-break:break-all; }
.md-code-content .tok-comment { color:#8a939d; }
.md-code-content .tok-string { color:#0a8f57; }
.md-code-content .tok-number { color:#b15c00; }
.md-code-content .tok-keyword { color:#245fc2; font-weight:600; }

.md-image-card { margin:18rpx 0; overflow:hidden; border-radius:16rpx; background:#f6f7f8; }
.md-image { display:block; width:100%; border-radius:16rpx; }
.md-image-caption { display:block; padding:12rpx 18rpx 16rpx; color:#8b949e; font-size:23rpx; line-height:1.5; text-align:center; }

.md-links { margin-top:22rpx; padding-top:16rpx; border-top:1rpx solid #eceff0; }
.md-links-title { display:block; margin-bottom:8rpx; color:#8b98a5; font-size:22rpx; line-height:1.4; }
.md-link-row.md-link-row { display:flex; align-items:center; gap:14rpx; width:100%; min-height:76rpx; margin:0; padding:12rpx 6rpx; border:0; background:transparent; text-align:left; }
.md-link-row.md-link-row:active { background:#f7f9fa; }
.md-link-copy { flex:1 1 auto; min-width:0; }
.md-link-label { display:block; color:#315f9f; font-size:25rpx; line-height:1.4; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.md-link-url { display:block; margin-top:2rpx; color:#98a1aa; font-size:21rpx; line-height:1.4; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
