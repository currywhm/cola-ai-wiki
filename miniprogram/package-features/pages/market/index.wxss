.market-page { padding-bottom:32rpx; }
.market-search { margin-top:2rpx; }
.market-tabs { display:flex; gap:28rpx; padding:24rpx 2rpx 14rpx; border-bottom:1rpx solid #e7e3dd; }
.market-tab { color:#858b99; font-size:25rpx; line-height:1.5; }
.market-tab.active { color:#242b3d; font-weight:600; }
/* 广场列表不画分隔线，靠封面图与留白区分条目 */
.market-item { display:flex; align-items:center; gap:16rpx; min-height:126rpx; padding:20rpx 0; border:0 none; }
.market-cover { display:flex; align-items:center; justify-content:center; flex:0 0 82rpx; width:82rpx; height:82rpx; border-radius:20rpx; background:#eaf9f1; color:#078b50; }
.market-name { display:block; overflow:hidden; color:#2f3745; font-size:28rpx; font-weight:600; line-height:1.4; text-overflow:ellipsis; white-space:nowrap; }
.market-desc,.market-meta { display:block; overflow:hidden; margin-top:5rpx; color:#858b99; font-size:22rpx; line-height:1.4; text-overflow:ellipsis; white-space:nowrap; }
.market-meta { font-size:20rpx; }
button.market-subscribe { display:flex; align-items:center; justify-content:center; flex:0 0 118rpx; width:118rpx !important; min-width:0 !important; min-height:58rpx; margin:0; padding:0 16rpx; border:1rpx solid #079758; border-radius:999rpx; background:#079758; color:#fff; font-size:24rpx; font-weight:600; line-height:58rpx; }
button.market-subscribe::after { border:0; }
button.market-subscribe.subscribed { border-color:#d9e5de; background:#f3f8f5; color:#078b50; }
button.market-subscribe[disabled] { opacity:.65; }
.market-own { flex:0 0 auto; padding:0 14rpx; color:#929aa3; font-size:22rpx; line-height:58rpx; }
.market-empty { margin-top:34rpx; text-align:center; }
