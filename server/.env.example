APP_NAME=知库资料服务
APP_ENV=development
PORT=8000
# 本地默认即 SQLite，不需要单独填写；如需覆盖可取消下一行注释。
# DATABASE_URL=sqlite+aiosqlite:///./data/llmwiki.db
# 微信云托管 MySQL 会直接注入 MYSQL_ADDRESS / MYSQL_USERNAME / MYSQL_PASSWORD /
# MYSQL_DATABASE。未显式设置 DATABASE_URL 时，后端会自动拼出 MySQL 连接串。
# 如需手工指定连接串（会覆盖 MYSQL_*）：
# DATABASE_URL=mysql+aiomysql://用户名:密码@内网IP:3306/数据库名?charset=utf8mb4
# local=本机上传目录；cos=微信云托管对象存储。
STORAGE_BACKEND=local
# 微信云托管官方示例使用 Bucket / Region；也兼容 COS_BUCKET / COS_REGION。
Bucket=
Region=ap-shanghai
COS_PREFIX=
# 仅本地联调 COS 时填写；微信云托管留空，后端会通过开放接口获取临时密钥。
COS_SECRET_ID=
COS_SECRET_KEY=
# 微信登录/凭证/客服调用地址。云托管默认不走环境代理，避免代理证书导致 TLS 校验失败。
WECHAT_API_BASE=https://api.weixin.qq.com
WECHAT_HTTPS_PROXY=
WECHAT_CA_FILE=
WECHAT_OPENAPI_BASE=http://api.weixin.qq.com
UPLOAD_DIR=./uploads
# 运营文案目录（使用技巧等）：改文件即生效，不需要改代码或发版
CONTENT_DIR=./content
# 合规文案（隐私保护指引 / 服务协议 / 软件许可 / 数据管理 / 隐私安全 /
# 会员服务条款 / 关于）里随部署环境变化的字段，只在这里维护一处：
# content/legal 的正文写成 {{operator}} / {{email_line}} / {{icp_line}} 占位符，
# 执行 python scripts/import_content.py 时替换进数据库。
# 上线前请至少补齐运营者名称；个人主体可填本人姓名，留空会显示通用表述。
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_ICP_NUMBER=
JWT_SECRET=replace-with-a-long-random-secret
# 微信开发者 ID 即小程序 AppID；生产启动时会实时校验这两项，错误会直接启动失败。
WECHAT_APPID=
WECHAT_SECRET=
# ---- 微信客服（联系客服）------------------------------------------------
# 小程序侧的客服入口只是一个 <button open-type="contact">（微信拉起原生客服会话），
# 下面三项是后端要接的部分：收消息的回调 + 运营下发的凭证 + 客服账号前缀。
# MP 后台「开发管理 → 消息推送」：URL 填 https://你的域名/api/wechat/kf/callback，
# 数据格式选 JSON 或 XML 都行，加解密方式推荐「安全模式」（则 EncodingAESKey 必填）。
WECHAT_KF_TOKEN=
WECHAT_KF_AES_KEY=
# 客服管理口令：会话原文属于用户隐私，/api/wechat/kf/* 的管理接口靠这个头部口令保护。
# 生产环境必须设置，否则这些接口会被直接关闭。请求时带 X-Kf-Admin-Token 头。
WECHAT_KF_ADMIN_TOKEN=
# 客服账号完整格式是「前缀@小程序微信号」，这里只填小程序微信号那一段（MP 后台设置→基本设置）
WECHAT_KF_ACCOUNT_SUFFIX=
# 收到用户消息时回一条回执（不代替人工回复），同一用户一小时内只回一次
WECHAT_KF_AUTOREPLY=true
WECHAT_KF_AUTOREPLY_COOLDOWN_SECONDS=3600
WECHAT_MCHID=
WECHAT_MCH_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=./cert/apiclient_key.pem
WECHAT_PAY_PLATFORM_CERT_PATH=./cert/wechatpay_platform.pem
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/pay/notify
WECHAT_PAY_BASE_URL=https://api.mch.weixin.qq.com
WECHAT_PAYMENT_MODE=virtual
WECHAT_VIRTUAL_OFFER_ID=
WECHAT_VIRTUAL_APP_KEY=
WECHAT_VIRTUAL_ENV=0
WECHAT_VIRTUAL_PRODUCT_ID=
WECHAT_VIRTUAL_GOODS_PRICE=0
WECHAT_VIRTUAL_MONTHLY_PRODUCT_ID=
WECHAT_VIRTUAL_MONTHLY_GOODS_PRICE=0
WECHAT_VIRTUAL_QUARTERLY_PRODUCT_ID=
WECHAT_VIRTUAL_QUARTERLY_GOODS_PRICE=0
WECHAT_VIRTUAL_YEARLY_PRODUCT_ID=
WECHAT_VIRTUAL_YEARLY_GOODS_PRICE=0
WECHAT_VIRTUAL_PLUS_MONTHLY_PRODUCT_ID=
WECHAT_VIRTUAL_PLUS_MONTHLY_GOODS_PRICE=0
WECHAT_VIRTUAL_PLUS_QUARTERLY_PRODUCT_ID=
WECHAT_VIRTUAL_PLUS_QUARTERLY_GOODS_PRICE=0
WECHAT_VIRTUAL_PLUS_YEARLY_PRODUCT_ID=
WECHAT_VIRTUAL_PLUS_YEARLY_GOODS_PRICE=0
WECHAT_VIRTUAL_NOTIFY_URL=https://api.example.com/api/pay/notify
WECHAT_VIRTUAL_BASE_URL=https://api.weixin.qq.com
# 统一大模型配置：兼容 OpenAI Chat Completions 的服务只需配这三项。
# 它优先级最高；留空才使用下面的 DEEPSEEK_* / OPENAI_* / MINIMAX_*。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-Text-01
HARNESS_ENABLED=false
HARNESS_HOME=./harness-home
HARNESS_PROFILE=sdk
HARNESS_PROVIDER=deepseek-official
HARNESS_MODEL=deepseek-v4-flash
# 官方沙箱模式：read-only | workspace-write | danger-full-access。
# SDK 自己负责 approval 与工具策略；无审批应答时危险操作 fail closed。
DSH_PERMISSION_MODE=workspace-write
HARNESS_MAX_TOKENS=4096
# 积分计费：额度单位是积分（不是问答次数）。用户价 = deepseek-flash 真实成本 × CREDIT_MARKUP，
# 1 积分 = CREDIT_UNIT_YUAN 元。单价默认取官方「高峰价」（元 / 百万 tokens），
# 官方空闲时段是半价，代码按请求时刻自动减半，不用改这里。
CREDIT_MARKUP=1.5
CREDIT_UNIT_YUAN=0.001
CREDIT_PRICE_INPUT_HIT=0.04
CREDIT_PRICE_INPUT_MISS=2.0
CREDIT_PRICE_OUTPUT=8.0
# 多租户隔离：每个租户独立的工作区目录（写边界）与 DSH_HOME（会话/技能/存储/附件）
HARNESS_WORKSPACES=./harness-workspaces
# 运行时池：上限与空闲回收（每个租户一组运行时，冷启动约 1s）
HARNESS_MAX_RUNTIMES=6
HARNESS_IDLE_SECONDS=1800
# 深度思考开关真正生效：快速 / 深度走不同推理强度（off | low | high | max）
HARNESS_QUICK_REASONING_EFFORT=low
HARNESS_DEEP_REASONING_EFFORT=high
# 可选：深度通道换用更擅长长推理的模型（留空表示与快速同模型）
HARNESS_DEEP_MODEL=
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=https://api.duckduckgo.com
WEB_SEARCH_TIMEOUT_SECONDS=12
CORS_ORIGINS=*
