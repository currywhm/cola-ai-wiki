.detail-page { width:100%; min-height:100vh; box-sizing:border-box; overflow-x:hidden; padding:0 32rpx calc(54rpx + env(safe-area-inset-bottom)); background:#f7f7f7; }
.activation-banner { display:flex; align-items:center; justify-content:space-between; width:calc(100% + 64rpx); min-height:104rpx; margin:0 -32rpx; padding:0 34rpx; background:#eef8f4; color:#46a184; }
.activation-copy { display:flex; align-items:center; min-width:0; gap:12rpx; font-size:30rpx; font-weight:500; line-height:1.35; white-space:nowrap; letter-spacing:-.2rpx; }
.activation-copy text { flex:0 1 auto; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.activation-link { flex:0 0 auto; min-height:58rpx; padding:4rpx 0; color:#23896d; font-size:30rpx; font-weight:650; }
button.activation-close { display:flex; align-items:center; justify-content:center; flex:0 0 56rpx; width:56rpx; min-width:56rpx; height:56rpx; min-height:56rpx; padding:0; color:#20242b; }
.library-toolbar { display:flex; align-items:center; justify-content:space-between; width:100%; min-width:0; gap:20rpx; padding:36rpx 0 30rpx; }
.library-title-wrap { display:flex; align-items:center; flex:0 1 auto; width:auto; min-width:0; max-width:calc(100% - 226rpx); gap:7rpx; }
.library-title { display:block; flex:0 1 auto; min-width:0; overflow:hidden; color:#20242b; font-size:42rpx; font-weight:700; line-height:1.25; text-overflow:ellipsis; white-space:nowrap; letter-spacing:-.8rpx; }
button.library-switch { display:flex; align-items:center; justify-content:center; flex:0 0 28rpx; width:28rpx; min-width:28rpx; height:38rpx; min-height:38rpx; padding:0; color:#20242b; opacity:.88; }
.toolbar-actions { display:flex; align-items:center; flex:0 0 auto; gap:14rpx; }
button.toolbar-button { display:flex; align-items:center; justify-content:center; flex:0 0 58rpx; width:58rpx; height:58rpx; min-height:58rpx; border-radius:18rpx; background:transparent; color:#20242b; }
button.toolbar-button.add-button { background:#ededed; }
.document-list { margin:0 0 30rpx; overflow:hidden; }
.doc-swipe-row { position:relative; min-height:142rpx; overflow:hidden; border-bottom:1rpx solid #e7e7e7; background:#f7f7f7; }
.doc-actions { position:absolute; top:0; right:0; bottom:0; display:flex; align-items:center; justify-content:flex-end; gap:14rpx; padding-right:22rpx; width:248rpx; }
button.doc-action { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6rpx; width:90rpx; min-width:90rpx; height:108rpx; min-height:108rpx; padding:0; margin:17rpx 0; border-radius:18rpx; color:#fff; font-size:19rpx; font-weight:650; }
.tag-action { background:#ff8a1d; }
.delete-action { background:#ff3034; }
.doc-card { position:relative; z-index:1; display:flex; align-items:center; gap:22rpx; min-height:142rpx; padding:20rpx 0; background:#f7f7f7; transition:transform .18s ease; }
.doc-card:active { opacity:.7; }
.doc-thumb { display:flex; align-items:center; justify-content:center; flex:0 0 92rpx; width:92rpx; height:104rpx; overflow:hidden; border-radius:3rpx; background:#fff; box-shadow:0 1rpx 4rpx rgba(0,0,0,.07); }
.doc-thumb image { width:100%; height:100%; }
.doc-thumb-fallback { position:relative; color:#d73648; }
.doc-thumb-fallback::before { content:''; position:absolute; top:15rpx; right:13rpx; left:13rpx; height:54rpx; border:2rpx solid #dfe2e3; border-radius:2rpx; background:linear-gradient(#f8f9f9 0 14rpx,transparent 14rpx 25rpx,#eef0f0 25rpx 29rpx,transparent 29rpx 39rpx,#eef0f0 39rpx 43rpx,transparent 43rpx); }
.doc-thumb-fallback ui-icon { position:relative; z-index:1; margin-top:62rpx; }
.doc-copy { flex:1; min-width:0; }
.doc-title { display:block; overflow:hidden; color:#202124; font-size:29rpx; line-height:1.45; text-overflow:ellipsis; white-space:nowrap; }
.doc-meta-line { display:flex; align-items:center; gap:10rpx; margin-top:10rpx; color:#a1a1a1; }
.pdf-mark { color:#ef3340; font-size:24rpx; line-height:1.2; }
.pdf-mark.mark-plain { color:#a1a1a1; }
.doc-meta-divider { color:#c8c8c8; font-size:23rpx; }
.doc-meta { color:#a1a1a1; font-size:24rpx; line-height:1.3; }
button.more-btn { display:flex; align-items:center; justify-content:center; flex:0 0 54rpx; width:54rpx; height:54rpx; min-height:54rpx; color:#7f7f7f; }
.empty-upload { display:flex; flex-direction:column; align-items:center; justify-content:center; min-height:620rpx; margin-top:72rpx; color:#8d8d8d; font-size:29rpx; font-weight:600; background:transparent; }
.empty-upload-illustration { width:178rpx; height:124rpx; opacity:.72; }
.empty-upload-title { display:block; margin-top:24rpx; color:#8c8c8c; font-size:29rpx; font-weight:650; line-height:1.35; letter-spacing:-.2rpx; }
.empty-upload-button { display:flex; align-items:center; justify-content:center; gap:10rpx; min-height:66rpx; margin-top:22rpx; padding:0 24rpx; border-radius:18rpx; background:#f1f1f1; color:#202124; font-size:28rpx; font-weight:700; }
.state-card { margin-top:26rpx; }
.upload-layer { position:fixed; z-index:80; top:0; right:0; bottom:0; left:0; }
.upload-mask { position:absolute; top:0; right:0; bottom:0; left:0; background:rgba(20,24,30,.28); }
.upload-sheet { position:absolute; right:0; bottom:0; left:0; padding:30rpx 48rpx calc(20rpx + env(safe-area-inset-bottom)); border-radius:32rpx 32rpx 0 0; background:#fff; box-shadow:0 -12rpx 36rpx rgba(24,31,40,.12); }
.upload-usage { display:flex; align-items:center; justify-content:space-between; min-height:48rpx; }
.upload-usage-text { color:#969696; font-size:27rpx; font-weight:500; }
.upload-upgrade { display:flex; align-items:center; gap:8rpx; min-height:48rpx; color:#00a05a; font-size:27rpx; font-weight:600; }
.upload-dot { display:block; width:12rpx; height:12rpx; border-radius:50%; background:#ff3c43; }
.upload-divider { height:1rpx; margin:14rpx 0 38rpx; background:#ededed; }
.upload-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); column-gap:30rpx; row-gap:36rpx; }
.upload-option { display:flex; flex-direction:column; align-items:center; min-width:0; color:#8d8d8d; font-size:23rpx; font-weight:500; line-height:1.35; }
.upload-option-icon { display:flex; align-items:center; justify-content:center; width:120rpx; height:120rpx; margin-bottom:14rpx; border-radius:20rpx; background:transparent; color:#626262; }
.upload-option text { overflow:hidden; max-width:100%; text-overflow:ellipsis; white-space:nowrap; }
.upload-cancel { width:calc(100% + 96rpx); min-height:92rpx; margin:44rpx -48rpx 0; border-top:1rpx solid #ededed; background:#fff; color:#2a2a2a; font-size:30rpx; font-weight:650; }
@media (max-width:340px) {
  .activation-copy { gap:8rpx; font-size:25rpx; }
  .activation-copy button { font-size:25rpx; }
  .library-title-wrap { max-width:calc(100% - 204rpx); }
  .library-title { font-size:37rpx; }
  .toolbar-actions { gap:10rpx; }
  button.toolbar-button { flex-basis:54rpx; width:54rpx; height:54rpx; }
  .doc-card { gap:16rpx; }
}
.upload-knowledge-icon { background:transparent; }
