<view class="page folder-chat-page {{conversationActive ? 'conversation-mode' : ''}}" style="{{safeBottom ? 'padding-bottom:calc(0rpx + ' + safeBottom + 'px)' : ''}}">
  <app-nav back title="{{knowledgeName || '微信用户的知识库'}}" />
  <view class="folder-crumb">
    <text class="crumb-part">{{knowledgeName || '微信用户的知识库'}}</text>
    <text class="crumb-sep">›</text>
    <text class="crumb-part crumb-current">{{folderName || '文件夹'}}</text>
  </view>
  <scroll-view class="messages" scroll-y scroll-with-animation enhanced show-scrollbar="{{false}}" scroll-into-view="{{lastMessageId}}">
    <!-- 文件夹文件列表（未进入会话时） -->
    <view wx:if="{{!conversationActive}}" class="folder-panel">
      <view wx:if="{{documentsLoading}}" class="folder-state">
        <view class="folder-skeleton"></view>
        <view class="folder-skeleton short"></view>
        <view class="folder-skeleton"></view>
      </view>
      <view wx:elif="{{documentsError}}" class="folder-state">
        <view class="folder-state-icon"><ui-icon name="folder" size="{{28}}" /></view>
        <text>文件列表加载失败</text>
        <button class="folder-retry" bindtap="loadFolder">重新加载</button>
      </view>
      <view wx:elif="{{!documents.length}}" class="folder-state">
        <view class="folder-state-icon"><ui-icon name="folder" size="{{28}}" /></view>
        <text>这个文件夹还是空的</text>
        <text class="folder-state-desc">回到知识库首页，长按文件移动进来</text>
      </view>
      <block wx:else>
        <view wx:for="{{documents}}" wx:key="id" class="folder-doc" bindtap="openDocument" data-id="{{item.id}}">
          <view class="folder-doc-icon {{item.preview_url ? '' : 'thumb-fallback'}}">
            <image wx:if="{{item.preview_url}}" src="{{item.preview_url}}" mode="aspectFill" />
            <ui-icon wx:else name="file" size="{{30}}" rpx />
          </view>
          <view class="folder-doc-copy">
            <text class="folder-doc-name">{{item.filename}}</text>
            <view class="folder-doc-meta">
              <text class="folder-doc-type {{item.typeKind === 'pdf' ? 'type-pdf' : ''}}">{{item.typeLabel}}</text>
              <text class="folder-meta-sep">|</text>
              <text wx:if="{{item.status === 'completed'}}">{{item.displayTime}}</text>
              <text wx:else class="folder-status-text {{item.status}}">{{item.status === 'failed' ? '解析失败' : '解析中'}}</text>
            </view>
          </view>
        </view>
      </block>
    </view>
    <!-- 会话消息 -->
    <block wx:for="{{messages}}" wx:key="id">
      <view id="{{item.id}}" class="message {{item.role}}">
        <view wx:if="{{item.role === 'user'}}" class="user-bubble">{{item.content}}</view>
        <view wx:else class="assistant-message">
          <view class="assistant-avatar"><image src="/assets/brand/cola-avatar.png" mode="aspectFit" /></view>
          <view class="assistant-card">
            <view class="assistant-head"><text class="assistant-name">cola</text></view>
            <view class="assistant-body">
              <rich-text wx:if="{{item.content}}" class="assistant-content" nodes="{{item.html || item.content}}"></rich-text>
              <text wx:else class="assistant-loading">{{item.progress || '正在检索资料并组织回答…'}}</text>
              <view wx:if="{{item.sources.length}}" class="sources">
                <text class="source-title">参考出处 · {{item.sources.length}} 条</text>
                <view wx:for="{{item.sources}}" wx:for-item="source" wx:key="id" class="source-card" bindtap="openSource" data-id="{{source.document_id || source.id}}" data-url="{{source.url || ''}}">
                  <view class="source-index">{{index + 1}}</view><view class="grow"><text class="source-file">{{source.filename}}</text><text class="source-page">{{source.url ? '公开网页 · 点击复制链接' : '第 ' + source.page_number + ' 页'}}</text></view><ui-icon name="chevron-right" size="{{15}}" />
                </view>
              </view>
            </view>
            <view wx:if="{{!item.local && item.content}}" class="answer-actions">
              <button class="action-icon" bindtap="copyAnswer" data-content="{{item.content}}" aria-label="复制回答"><ui-icon name="copy" size="{{18}}" /></button>
              <button class="action-icon" bindtap="shareAnswer" data-content="{{item.content}}" aria-label="分享回答"><ui-icon name="share" size="{{18}}" /></button>
            </view>
          </view>
        </view>
      </view>
    </block>
  </scroll-view>
  <view class="chat-footer">
    <view class="composer">
      <textarea class="composer-input" value="{{input}}" placeholder="{{documents.length ? '基于本文件夹提问' : '这个文件夹还没有文件'}}" placeholder-style="color:#c7c7c7;font-size:32rpx;" auto-height maxlength="8000" bindtap="enterConversation" bindfocus="enterConversation" bindinput="onInput" bindconfirm="send" confirm-type="send" disabled="{{loadState !== 'ready'}}"></textarea>
      <view class="composer-bar">
        <button class="model-button" bindtap="chooseModel" disabled="{{sending}}">
          <text>{{modelShortLabel}} <text class="model-mode">{{thinkingMode === 'deep' ? '深度' : '快速'}}</text></text>
          <ui-icon name="chevron-down" size="{{11}}" />
        </button>
        <view class="composer-bar-spacer"></view>
      </view>
      <button wx:if="{{sending}}" class="send-button active" bindtap="stopSend" aria-label="停止"><ui-icon name="stop" size="{{32}}" rpx /></button>
      <button wx:else class="send-button {{canSend ? 'active' : ''}}" bindtap="send" disabled="{{!canSend}}" aria-label="发送"><ui-icon name="send" size="{{44}}" rpx /></button>
    </view>
    <text wx:if="{{conversationActive}}" class="ai-disclaimer">内容由AI生成仅供参考</text>
  </view>
  <view wx:if="{{modelPickerVisible}}" class="model-layer">
    <view class="model-mask" bindtap="closeModelPicker"></view>
    <view class="model-sheet" catchtap="stopModelPickerBubble">
      <view class="sheet-grabber"></view>
      <view class="model-sheet-title">选择模型</view>
      <view class="thinking-card">
        <view class="thinking-copy">
          <view class="thinking-icon"><ui-icon name="atom" size="{{31}}" /></view>
          <text class="thinking-title">思考模式</text>
        </view>
        <view class="thinking-switch">
          <button class="thinking-tab {{thinkingMode === 'quick' ? 'active' : ''}}" bindtap="selectThinkingMode" data-mode="quick">快速</button>
          <button class="thinking-tab {{thinkingMode === 'deep' ? 'active' : ''}}" bindtap="selectThinkingMode" data-mode="deep">深度</button>
        </view>
      </view>
      <text class="model-section-title">选择模型</text>
      <view class="model-list">
        <button wx:for="{{modelOptions}}" wx:key="id" class="model-row" bindtap="selectModel" data-id="{{item.id}}">
          <view class="model-row-copy">
            <text class="model-row-name">{{item.name}}</text>
            <text wx:if="{{item.badge}}" class="model-new-badge">{{item.badge}}</text>
          </view>
          <text wx:if="{{item.id === selectedModelKey}}" class="model-check">✓</text>
        </button>
      </view>
    </view>
  </view>
</view>
