.hd-layer { position: fixed; z-index: 200; top: 0; right: 0; bottom: 0; left: 0; }
.hd-mask { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: rgba(0, 0, 0, .32); }
.hd-panel { position: absolute; top: 0; bottom: 0; left: 0; display: flex; flex-direction: column; width: 74%; max-width: 620rpx; box-sizing: border-box; padding: 0 40rpx calc(40rpx + env(safe-area-inset-bottom)); background: #fff; box-shadow: 8rpx 0 40rpx rgba(15, 20, 28, .14); animation: hd-in .22s ease-out; }
@keyframes hd-in { from { transform: translateX(-100%); } to { transform: translateX(0); } }
.hd-head { display: flex; align-items: flex-end; justify-content: space-between; height: 118rpx; }
.hd-title { color: #14171b; font-size: 40rpx; font-weight: 700; line-height: 1.2; letter-spacing: -.4rpx; }
button.hd-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 72rpx; width: 72rpx; min-width: 72rpx; height: 72rpx; min-height: 72rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; background: transparent; }
button.hd-icon:active { background: #f2f2f2; }
button.hd-icon::after, button.hd-new::after, button.hd-item::after, button.hd-search-clear::after { border: 0; }
.hd-search { display: flex; align-items: center; gap: 16rpx; height: 84rpx; margin-top: 18rpx; padding: 0 24rpx; border-radius: 18rpx; background: #f5f5f5; }
.hd-search-input { flex: 1 1 auto; min-width: 0; color: #1f1f1f; font-size: 28rpx; }
button.hd-search-clear { display: flex; align-items: center; justify-content: center; flex: 0 0 40rpx; width: 40rpx; min-width: 40rpx; height: 40rpx; min-height: 40rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; background: transparent; opacity: .55; }
button.hd-new { display: flex; align-items: center; justify-content: center; gap: 14rpx; width: 100%; min-height: 96rpx; margin: 30rpx 0 6rpx; padding: 0; border: 1rpx solid #ececec; border-radius: 999rpx; background: #fff; color: #14171b; font-size: 31rpx; font-weight: 600; line-height: 1.3; }
button.hd-new:active { background: #f7f7f7; }
.hd-list { flex: 1 1 auto; min-height: 0; }
.hd-group { display: block; margin: 26rpx 0 4rpx; color: #a4a9ae; font-size: 26rpx; line-height: 1.4; }
/* 每一行：右侧藏「置顶 / 删除」操作区，行体左滑后整体平移露出 */
/* 列表不使用任何分隔线：行与行之间只靠留白和选中态区分，避免出现「表格线」的观感 */
.hd-row { position: relative; overflow: hidden; border: 0 none; border-radius: 0; background: #fff; box-shadow: none; }
.hd-row + .hd-row { border: 0 none; }
.hd-actions { position: absolute; top: 0; right: 0; bottom: 0; display: flex; align-items: stretch; width: 240rpx; }
button.hd-action { display: flex; align-items: center; justify-content: center; flex: 1 1 0; min-width: 0; margin: 0; padding: 0; border: 0; border-radius: 0; font-size: 26rpx; font-weight: 500; line-height: 1.3; }
button.hd-action::after { border: 0; }
button.hd-pin { background: #ececec; color: #242424; }
button.hd-pin.is-on { background: #e0e0e0; color: #6f6f6f; }
button.hd-del { background: #e64340; color: #fff; }
button.hd-action:active { opacity: .82; }
/* 行体保持直角：既能完整盖住右侧操作区（滑开时不露出碎边），选中态色块又与面板正文等宽 */
button.hd-item { position: relative; display: flex; align-items: center; justify-content: flex-start; gap: 10rpx; width: 100%; min-height: 84rpx; margin: 0; padding: 22rpx 0; border: 0 none; border-radius: 0; background: #fff; color: #22262b; font-size: 30rpx; font-weight: 400; line-height: 1.45; text-align: left; box-shadow: none; transition: transform .2s ease, background-color .18s ease; }
button.hd-item::before, button.hd-item::after { border: 0 none; box-shadow: none; }
.hd-item-text { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
button.hd-item:active { background: #f4f4f4; color: #079c5a; }
button.hd-item.on { background: #f1f7f3; color: #079c5a; font-weight: 600; }
.hd-empty { padding: 60rpx 0; color: #a4a9ae; font-size: 27rpx; line-height: 1.6; text-align: center; }
