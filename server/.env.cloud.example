# 微信云托管最小环境变量模板
# 镜像已经内置运行环境、端口、目录、COS 模式、微信接口地址、Harness 和模型端点。
# 这里只保留账号凭据、平台资源和合规信息；不要把真实密钥提交到 Git。
#
# 可选项：
# - 微信客服、虚拟支付等未启用的功能不用配置，完整配置项见 .env.example。
# - MySQL 和 COS 若由微信云托管自动注入，可以删除对应空占位项。
# - 模型默认使用 DeepSeek 官方接口，只需提供 LLM_API_KEY。

# ---------- 必填：认证 ----------
JWT_SECRET=至少32位随机字符串
WECHAT_APPID=小程序AppID
WECHAT_SECRET=小程序AppSecret
LLM_API_KEY=大模型APIKey

# ---------- MySQL：云托管自动注入时可不填 ----------
MYSQL_ADDRESS=内网IP:3306
MYSQL_USERNAME=数据库用户名
MYSQL_PASSWORD=数据库密码
MYSQL_DATABASE=数据库名

# ---------- COS 或云托管的对象存储 ----------
Bucket=对象存储桶名
Region=ap-shanghai

# ---------- 合规与许可 ----------
LEGAL_OPERATOR_NAME=运营者名称
LEGAL_CONTACT_EMAIL=联系邮箱
LEGAL_ICP_NUMBER=ICP备案号
