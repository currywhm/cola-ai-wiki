<view class="qa-page" style="{{safeBottom ? 'padding-bottom:' + safeBottom + 'px;' : ''}}">
  <!-- 与「问AI」问答页同一套结构：不留标题栏，只保留返回 + 上下文的胶囊安全高度 -->
  <view class="qa-nav" style="height:{{navHeight}}px;">
    <button class="qa-back" bindtap="goBack" aria-label="返回"><ui-icon name="back" size="{{36}}" rpx /></button>
    <button class="qa-history" bindtap="openHistory" aria-label="历史对话"><ui-icon name="menu" size="{{34}}" rpx /></button>
    <view class="qa-context">
      <text class="qa-context-title">{{folderName || '文件夹'}}</text>
      <text class="qa-context-sub">{{knowledgeName || '微信用户的知识库'}}</text>
    </view>
  </view>

  <!-- 本文件夹资料：保留「这个文件夹里有哪些文件」的可达性，横滑一眼看完 -->
  <view wx:if="{{documents.length}}" class="qa-docstrip">
    <scroll-view class="qa-docstrip-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <button wx:for="{{documents}}" wx:key="id" class="qa-docstrip-chip" bindtap="openDocument" data-id="{{item.id}}">
        <ui-icon name="file" size="{{26}}" rpx />
        <text class="qa-docstrip-name">{{item.filename}}</text>
      </button>
    </scroll-view>
  </view>

  <scroll-view class="qa-body" scroll-y scroll-with-animation enhanced show-scrollbar="{{false}}" scroll-into-view="{{lastMessageId}}">
    <view wx:if="{{loadState === 'error'}}" class="qa-state">
      <text class="qa-state-title">暂时无法连接资料</text>
      <text class="qa-state-desc">登录或网络暂不可用，请稍后重试。</text>
      <button class="qa-outline-button" bindtap="retry">重新加载</button>
    </view>
    <block wx:for="{{messages}}" wx:key="id">
      <view id="{{item.id}}" class="qa-message {{item.role}}">
        <view wx:if="{{item.role === 'user'}}" class="qa-user-bubble">{{item.content}}</view>
        <!-- 开场白：头像 + 招呼 + 范围，替代之前一整段裸文本 -->
        <view wx:elif="{{item.greeting}}" class="qa-hello">
          <image class="qa-hello-avatar" src="/assets/brand/cola-avatar.png" mode="aspectFit" />
          <view class="qa-hello-copy">
            <text class="qa-hello-title">{{item.title}}</text>
            <text class="qa-hello-desc">{{item.desc}}</text>
          </view>
        </view>
        <view wx:else class="qa-answer">
          <!-- 过程区：思考 / 步骤 / 工具 / 技能 / 子智能体，与问AI页完全一致 -->
          <view wx:if="{{item.trace.length || item.reason}}" class="qa-trace">
            <view class="qa-trace-head {{item.running ? 'live' : ''}}" bindtap="toggleTrace" data-id="{{item.id}}">
              <view class="qa-trace-icon"><ui-icon name="{{item.traceIcon || 'dengpao'}}" size="{{30}}" rpx /></view>
              <text class="qa-trace-title">{{item.traceTitle || '思考中'}}</text>
              <text wx:if="{{item.traceSummary && (!item.traceOpen || item.running)}}" class="qa-trace-summary">{{item.traceSummary}}</text>
              <view wx:else class="qa-trace-spacer"></view>
              <text wx:if="{{item.traceElapsed}}" class="qa-trace-elapsed">{{item.traceElapsed}}</text>
              <view class="qa-trace-chevron"><ui-icon name="{{item.traceOpen ? 'chevron-up' : 'chevron-down'}}" size="{{22}}" rpx /></view>
            </view>
            <view wx:if="{{item.traceOpen}}" class="qa-trace-body">
              <text wx:if="{{item.reason}}" class="qa-reason">{{item.reason}}</text>
              <view wx:for="{{item.trace}}" wx:for-item="node" wx:key="key" class="qa-node {{node.kind}} {{node.state}}">
                <view class="qa-node-icon"><ui-icon name="{{node.icon || 'atom'}}" size="{{28}}" rpx /></view>
                <view class="qa-node-copy">
                  <text class="qa-node-title">{{node.title}}</text>
                  <text wx:if="{{node.detail}}" class="qa-node-detail">{{node.detail}}</text>
                </view>
                <text wx:if="{{node.stateLabel}}" class="qa-node-state {{node.state}}">{{node.stateLabel}}</text>
              </view>
            </view>
          </view>
          <view wx:if="{{!item.content && !item.trace.length && !item.reason}}" class="qa-progress">
            <view class="qa-progress-icon"><ui-icon name="dengpao" size="{{26}}" rpx /></view>
            <text class="qa-progress-text">{{item.progress || '正在思考…'}}</text>
          </view>
          <rich-text wx:if="{{item.content}}" class="qa-answer-text" nodes="{{item.html || item.content}}"></rich-text>
          <view wx:if="{{item.sources.length}}" class="qa-sources">
            <text class="qa-source-title">参考出处 · {{item.sources.length}} 条</text>
            <view wx:for="{{item.sources}}" wx:for-item="source" wx:key="id" class="qa-source" bindtap="openSource" data-id="{{source.document_id || source.id}}" data-url="{{source.url || ''}}">
              <view class="qa-source-icon"><ui-icon name="{{source.iconName || 'recent-text'}}" size="{{34}}" rpx /></view>
              <view class="qa-source-copy">
                <text class="qa-source-file">{{source.filename}}</text>
                <text class="qa-source-page">{{source.url ? '公开网页 · 点击复制链接' : '第 ' + source.page_number + ' 页'}}</text>
              </view>
            </view>
          </view>
          <view wx:if="{{item.content && !item.local}}" class="qa-answer-actions">
            <button class="qa-action" bindtap="copyAnswer" data-content="{{item.content}}" aria-label="复制回答"><ui-icon name="copy" size="{{18}}" />复制</button>
            <button class="qa-action" open-type="share" data-id="{{item.id}}" aria-label="分享给微信好友"><ui-icon name="share" size="{{18}}" />分享</button>
          </view>
        </view>
      </view>
    </block>
    <!-- 开场之后紧跟问答提示：贴合本文件夹资料，点了直接提问 -->
    <view wx:if="{{!sending && messages.length === 1 && suggestions.length}}" class="qa-prompts">
      <text class="qa-prompts-title">你可以这样问</text>
      <button wx:for="{{suggestions}}" wx:key="*this" class="qa-prompt" bindtap="pickPrompt" data-text="{{item}}">{{item}}</button>
    </view>
    <view wx:elif="{{!sending && messages.length === 1 && suggestionsLoading}}" class="qa-prompts">
      <text class="qa-prompts-hint">正在根据这个文件夹的资料生成提问建议…</text>
    </view>
  </scroll-view>
  <view class="qa-footer">
    <view class="qa-composer">
      <view wx:if="{{pendingSkillName}}" class="qa-skill-chip">
        <text class="qa-skill-chip-text">技能 · {{pendingSkillName}}</text>
        <button class="qa-skill-chip-close" bindtap="clearSkill" aria-label="取消技能"><ui-icon name="close" size="{{20}}" rpx /></button>
      </view>
      <textarea class="qa-input" value="{{input}}" placeholder="{{placeholder}}" placeholder-style="color:#8c8c8c;font-size:30rpx;line-height:1.32;" auto-height maxlength="8000" focus="{{autoFocus}}" adjust-position="{{true}}" show-confirm-bar="{{false}}" bindinput="onInput" bindconfirm="send" confirm-type="send" disabled="{{loadState !== 'ready'}}"></textarea>
      <view class="qa-bar">
        <button class="qa-logic {{askMode}}" bindtap="toggleAskLogic" aria-label="切换问答逻辑">
          <ui-icon name="{{askMode === 'planner' ? 'robot-planner' : 'robot-knowledge'}}" size="{{34}}" rpx />
          <ui-icon name="chevron-down" size="{{16}}" rpx />
        </button>
        <button class="qa-skill" bindtap="openSkillSheet" disabled="{{sending}}" aria-label="技能">
          <ui-icon name="skill" size="{{34}}" rpx />
          <ui-icon name="chevron-down" size="{{15}}" rpx />
        </button>
        <button class="qa-scope {{askMode}}" bindtap="openScopeSheet" disabled="{{sending}}" aria-label="本文件夹与本文件夹资料">
          <ui-icon name="{{askMode === 'planner' ? 'at' : 'knowledge-pick'}}" size="{{30}}" rpx />
        </button>
        <view class="qa-bar-spacer"></view>
        <button class="qa-model" bindtap="openModelSheet" disabled="{{sending}}" aria-label="模型与思考深度"><ui-icon name="model-depth" size="{{34}}" rpx /></button>
        <button wx:if="{{sending}}" class="qa-send" bindtap="stopSend" aria-label="停止"><ui-icon name="stop" size="{{58}}" rpx /></button>
        <button wx:else class="qa-send" bindtap="send" disabled="{{!canSend}}" aria-label="发送"><ui-icon name="{{canSend ? 'send-ready' : 'send-idle'}}" size="{{58}}" rpx /></button>
      </view>
    </view>
  </view>

  <!-- 更多选项：模型与思考深度（只保留深度思考） -->
  <view wx:if="{{modelSheetVisible}}" class="sheet-layer">
    <view class="sheet-mask" bindtap="closeSheets"></view>
    <view class="sheet-panel option-panel" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">更多选项</text>
        <button class="sheet-close" bindtap="closeSheets" aria-label="关闭"><ui-icon name="close" size="{{28}}" rpx /></button>
      </view>
      <view class="option-card" bindtap="toggleDeepThinking">
        <view class="option-icon"><ui-icon name="atom" size="{{52}}" rpx /></view>
        <view class="option-copy">
          <text class="option-name">深度思考</text>
          <text class="option-desc">输出思考过程并回答</text>
        </view>
        <text class="option-pill {{deepThinking ? 'on' : ''}}">{{deepThinking ? '自动' : '已关闭'}}</text>
      </view>
    </view>
  </view>

  <!-- 技能：与问AI页共用同一份技能清单与后端技能包 -->
  <!-- 技能：与问AI页共用同一份数据源，只有选中的才会随本轮对话注入后端 -->
  <skill-picker visible="{{skillSheetVisible}}" selected="{{selectedSkillId}}" bind:close="closeSheets" bind:select="onSkillSelect" bind:create="onSkillCreate" bind:edit="onSkillEdit" />

  <!-- 选择知识：文件夹会话里换成「本文件夹资料 + 回到知识库」，范围始终锁定在当前文件夹 -->
  <view wx:if="{{scopeSheetVisible}}" class="sheet-layer">
    <view class="sheet-mask" bindtap="closeSheets"></view>
    <view class="sheet-panel scope-panel" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">本文件夹资料</text>
        <button class="sheet-close" bindtap="closeSheets" aria-label="关闭"><ui-icon name="close" size="{{28}}" rpx /></button>
      </view>
      <text class="scope-hint">提问范围锁定在「{{folderName || '当前文件夹'}}」，只依据这些文件回答。</text>
      <scroll-view class="scope-list" scroll-y enhanced show-scrollbar="{{false}}">
        <button wx:for="{{documents}}" wx:key="id" class="scope-doc" bindtap="openDocument" data-id="{{item.id}}">
          <ui-icon name="file" size="{{32}}" rpx />
          <text class="scope-doc-name">{{item.filename}}</text>
          <text class="scope-doc-type">{{item.typeLabel}}</text>
        </button>
        <view wx:if="{{!documents.length}}" class="scope-empty">这个文件夹还是空的，先把文件移动进来，问答就会自动带上它们。</view>
      </scroll-view>
      <button class="scope-dir" bindtap="backToDirectory">
        <text>回到知识库目录</text>
        <ui-icon name="chevron-right" size="{{28}}" rpx />
      </button>
    </view>
  </view>

  <!-- 历史对话抽屉：只看当前文件夹的会话，与根目录会话天然隔离 -->
  <history-drawer visible="{{historyVisible}}" loading="{{historyLoading}}" active-id="{{conversationId}}" items="{{historyItems}}" bind:close="closeHistory" bind:pick="pickHistory" bind:create="newConversation" bind:pin="pinHistory" bind:remove="removeHistory" />
</view>
