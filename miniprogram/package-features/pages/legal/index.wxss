/* 服务说明页按参考稿使用微信系统字体、纯白背景、左标题与右对齐日期，正文保持长文阅读节奏。 */
.legal-page { min-height:100vh; padding:0 0 calc(64rpx + env(safe-area-inset-bottom)); background:#fff; color:#17181a; font-family:"PingFang SC","Helvetica Neue",sans-serif; }

/* 加载与失败状态 */
.legal-state { padding:60rpx 32rpx; }
.legal-skeleton { border-radius:10rpx; background:#eceeed; }
.legal-skeleton-title { width:62%; height:46rpx; }
.legal-skeleton-line { height:26rpx; margin-top:26rpx; }
.legal-skeleton-line.short { width:46%; }
.legal-state-title { display:block; color:#17181a; font-size:32rpx; font-weight:700; }
.legal-state-desc { display:block; margin-top:12rpx; color:#71767c; font-size:27rpx; line-height:1.7; }
button.legal-retry { width:100%; min-height:88rpx; margin-top:28rpx; border-radius:12rpx; background:#1677ff; color:#fff; font-size:29rpx; font-weight:600; }

/* 标题与日期：与参考稿一致，标题靠左，更新/生效日期靠右。 */
.legal-doc-head { padding:34rpx 32rpx 0; }
.legal-doc-title { display:block; color:#111; font-size:38rpx; font-weight:700; line-height:1.42; letter-spacing:0; }
.legal-dates { margin-top:30rpx; text-align:right; }
.legal-date { display:block; color:#3f4247; font-size:29rpx; font-weight:400; line-height:1.9; }

/* 正文：不套卡片，正文颜色接近纯黑，标题与正文间留出清晰层级。 */
.legal-body { padding:22rpx 32rpx 0; }
.legal-h2 { display:block; margin-top:52rpx; color:#111; font-size:34rpx; font-weight:700; line-height:1.55; letter-spacing:0; }
.legal-p { display:block; margin-top:28rpx; color:#242629; font-size:29rpx; font-weight:400; line-height:1.9; }
.legal-h2 + .legal-p, .legal-h2 + .legal-line, .legal-h2 + .legal-note { margin-top:25rpx; }
.legal-first { margin-top:0 !important; }

.legal-run { font-size:29rpx; line-height:1.9; }
.legal-run-strong { color:#111; font-weight:700; }
.legal-run-code { padding:2rpx 8rpx; border-radius:6rpx; background:#f1f4f3; color:#252a2f; font-size:27rpx; }

.legal-line { display:flex; align-items:flex-start; margin-top:24rpx; }
.legal-line-body { flex:1 1 auto; min-width:0; color:#242629; font-size:29rpx; font-weight:400; line-height:1.9; }
.legal-dot { flex:0 0 10rpx; width:10rpx; height:10rpx; margin:24rpx 17rpx 0 1rpx; border-radius:50%; background:#2e3135; }
.legal-step { display:flex; align-items:center; justify-content:center; flex:0 0 44rpx; width:44rpx; height:44rpx; margin:7rpx 16rpx 0 0; border-radius:50%; background:#f0f1f2; color:#242629; font-size:23rpx; font-weight:600; }

/* 提示块保持轻量，只用左侧竖线，不改变参考稿的白底长文观感。 */
.legal-note { display:flex; align-items:stretch; margin-top:28rpx; padding:2rpx 0 2rpx 20rpx; border-left:5rpx solid #d2d4d7; }
.legal-note .legal-line-body { color:#373a3e; }
.legal-note-bar { display:none; }

/* 数据管理的两个动作 */
.legal-actions { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16rpx; margin:42rpx 32rpx 0; }
button.legal-action { min-width:0; min-height:88rpx; padding:0 16rpx; border:1rpx solid #e0e2e4; border-radius:12rpx; background:#fff; color:#24282d; font-size:27rpx; font-weight:500; }

/* 客服入口 */
.legal-help { margin:52rpx 32rpx 0; padding-top:38rpx; border-top:1rpx solid #eceeef; }
.legal-help-title { display:block; color:#111; font-size:33rpx; font-weight:700; line-height:1.5; }
.legal-help-desc { display:block; margin-top:12rpx; color:#555a60; font-size:27rpx; line-height:1.8; }
button.legal-contact { width:100%; min-height:90rpx; margin-top:24rpx; border-radius:12rpx; background:#1677ff; color:#fff; font-size:29rpx; font-weight:600; }

/* 相关说明 */
.legal-related { margin:54rpx 32rpx 0; padding-top:38rpx; border-top:1rpx solid #eceeef; }
.legal-related-title { display:block; margin-bottom:8rpx; color:#111; font-size:32rpx; font-weight:700; line-height:1.5; }
button.legal-related-item { display:flex; align-items:center; justify-content:space-between; width:100%; min-height:0; margin:0; padding:24rpx 0; border:0; border-bottom:1rpx solid #f0f1f2; border-radius:0; background:#fff; color:#24282d; text-align:left; }
button.legal-related-item:last-child { border-bottom:0; }
.legal-related-main { flex:1 1 auto; min-width:0; margin-right:16rpx; }
.legal-related-name { display:block; color:#17181a; font-size:29rpx; font-weight:600; line-height:1.55; }
.legal-related-desc { display:block; margin-top:7rpx; overflow:hidden; color:#747980; font-size:24rpx; line-height:1.55; text-overflow:ellipsis; white-space:nowrap; }

.legal-foot-note { display:block; margin:40rpx 32rpx 0; color:#94999f; font-size:23rpx; line-height:1.65; text-align:center; }
