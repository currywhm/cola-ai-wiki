<!-- 好友分享落地页：微信好友点开「分享卡片」后看到的就是这一页。
     只展示这次被分享的一问一答与出处，不出现分享者的昵称 / 头像。 -->
<view class="share-page">
  <view class="share-nav" style="height:{{navHeight}}px;">
    <view class="share-nav-row">
      <image class="share-logo" src="/assets/brand/cola-avatar.png" mode="aspectFit" />
      <text class="share-logo-text">cola知识库</text>
    </view>
  </view>

  <scroll-view class="share-body" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:if="{{state === 'loading'}}" class="share-skeleton">
      <view class="share-skeleton-line"></view>
      <view class="share-skeleton-line short"></view>
      <view class="share-skeleton-line"></view>
      <view class="share-skeleton-line"></view>
      <view class="share-skeleton-line short"></view>
    </view>

    <block wx:elif="{{state === 'ready'}}">
      <view wx:if="{{question}}" class="share-question">
        <text class="share-question-label">好友的提问</text>
        <text class="share-question-text">{{question}}</text>
      </view>
      <view class="share-answer">
        <rich-text class="qa-answer-text" nodes="{{html}}"></rich-text>
      </view>
      <view wx:if="{{sources.length}}" class="share-sources">
        <text class="share-sources-title">参考出处 · {{sources.length}} 条</text>
        <view wx:for="{{sources}}" wx:key="key" class="share-source">
          <view class="share-source-icon"><ui-icon name="{{item.iconName}}" size="{{32}}" rpx /></view>
          <view class="share-source-copy">
            <text class="share-source-file">{{item.filename}}</text>
            <text class="share-source-meta">{{item.meta}}</text>
          </view>
        </view>
      </view>
    </block>

    <view wx:else class="share-state">
      <view class="share-state-icon"><ui-icon name="{{state === 'missing' ? 'jieshao' : 'refresh'}}" size="{{46}}" rpx /></view>
      <text class="share-state-title">{{state === 'missing' ? '这条分享已失效' : '暂时打不开这条分享'}}</text>
      <text class="share-state-desc">{{state === 'missing' ? '内容可能已被删除，或者链接不完整。可以让好友重新分享一次。' : '网络似乎不太稳定，请稍后重试。'}}</text>
      <button wx:if="{{state === 'error'}}" class="share-state-button" bindtap="retry">重新加载</button>
    </view>

    <view class="share-bottom-space"></view>
  </scroll-view>

  <view class="share-footer">
    <button class="share-cta" bindtap="openApp">打开 cola知识库</button>
    <button class="share-forward" open-type="share" aria-label="转发给微信好友"><ui-icon name="share" size="{{34}}" rpx /></button>
  </view>
</view>
