@import "../../styles/thread.wxss";

/* 好友分享落地页：沿用会话页的正文排版（.qa-answer-text），
   背景与卡片跟「问AI / 知识库 / 我的」保持同一套配色，全程不画分隔线。 */
page { overflow-x: hidden; background: #f5f6f6; }

.share-page { display: flex; flex-direction: column; width: 100%; max-width: 750rpx; height: 100vh; min-height: 0; margin: 0 auto; overflow: hidden; background: #f5f6f6; box-sizing: border-box; }

/* 顶部：品牌标识 + 胶囊按钮的安全高度 */
.share-nav { flex: 0 0 auto; display: flex; align-items: flex-end; padding: 0 34rpx; }
.share-nav-row { display: flex; align-items: center; gap: 16rpx; width: 100%; height: 88rpx; }
.share-logo { flex: 0 0 56rpx; width: 56rpx; height: 56rpx; border-radius: 16rpx; }
.share-logo-text { color: #23282f; font-size: 30rpx; font-weight: 600; line-height: 1.3; letter-spacing: .4rpx; }

.share-body { flex: 1; min-height: 0; padding: 6rpx 30rpx 0; box-sizing: border-box; }

/* 好友的提问 */
.share-question { margin-top: 10rpx; padding: 26rpx 30rpx 28rpx; border-radius: 26rpx; background: #fff; box-shadow: 0 2rpx 12rpx rgba(24,28,34,.04); }
.share-question-label { display: block; color: #9aa1a9; font-size: 23rpx; font-weight: 400; line-height: 1.4; }
.share-question-text { display: block; margin-top: 10rpx; color: #171b20; font-size: 32rpx; font-weight: 600; line-height: 1.55; }

/* 回答正文：字号 / 行高完全走 thread.wxss 的 .qa-answer-text */
.share-answer { margin-top: 18rpx; padding: 30rpx 30rpx 26rpx; border-radius: 26rpx; background: #fff; box-shadow: 0 2rpx 12rpx rgba(24,28,34,.04); }

/* 参考出处 */
.share-sources { margin-top: 18rpx; padding: 26rpx 30rpx 10rpx; border-radius: 26rpx; background: #fff; box-shadow: 0 2rpx 12rpx rgba(24,28,34,.04); }
.share-sources-title { display: block; color: #9aa1a9; font-size: 23rpx; font-weight: 400; line-height: 1.4; }
.share-source { display: flex; align-items: center; gap: 18rpx; padding: 18rpx 0; }
.share-source-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 60rpx; width: 60rpx; height: 60rpx; border-radius: 18rpx; background: #f2f5f3; }
.share-source-copy { flex: 1; min-width: 0; }
.share-source-file { display: block; overflow: hidden; color: #23282f; font-size: 27rpx; font-weight: 500; line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }
.share-source-meta { display: block; margin-top: 2rpx; color: #9aa1a9; font-size: 22rpx; font-weight: 400; line-height: 1.4; }

/* 加载骨架：只用亮度差异，不用线条 */
.share-skeleton { margin-top: 18rpx; padding: 34rpx 30rpx; border-radius: 26rpx; background: #fff; box-shadow: 0 2rpx 12rpx rgba(24,28,34,.04); }
.share-skeleton-line { height: 28rpx; margin-bottom: 24rpx; border-radius: 10rpx; background: #eef0f1; }
.share-skeleton-line:last-child { margin-bottom: 0; }
.share-skeleton-line.short { width: 58%; }

/* 失效 / 网络异常 */
.share-state { display: flex; flex-direction: column; align-items: center; padding: 170rpx 40rpx 0; text-align: center; }
.share-state-icon { display: flex; align-items: center; justify-content: center; width: 112rpx; height: 112rpx; border-radius: 34rpx; background: #fff; box-shadow: 0 2rpx 12rpx rgba(24,28,34,.04); }
.share-state-title { margin-top: 28rpx; color: #1f2227; font-size: 34rpx; font-weight: 650; line-height: 1.4; }
.share-state-desc { margin-top: 12rpx; color: #8b8e92; font-size: 26rpx; font-weight: 400; line-height: 1.65; }
button.share-state-button { display: flex; align-items: center; justify-content: center; min-width: 260rpx; min-height: 84rpx; margin: 30rpx 0 0; padding: 0 34rpx; border: 1rpx solid #e3e6e8; border-radius: 999rpx; background: #fff; color: #23282f; font-size: 28rpx; font-weight: 500; }

/* 底部：主按钮进小程序，圆形按钮再转发一次 */
.share-footer { flex: 0 0 auto; display: flex; align-items: center; gap: 18rpx; padding: 14rpx 34rpx calc(22rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: linear-gradient(180deg, rgba(245,246,246,0) 0%, rgba(245,246,246,.96) 32%, #f5f6f6 100%); }
button.share-cta { display: flex; flex: 1; align-items: center; justify-content: center; min-height: 96rpx; margin: 0; padding: 0 32rpx; border: 0; border-radius: 999rpx; background: #242b3d; color: #fff; font-size: 30rpx; font-weight: 600; line-height: 1.3; }
button.share-cta:active { opacity: .88; }
button.share-forward { display: flex; align-items: center; justify-content: center; flex: 0 0 96rpx; width: 96rpx; min-width: 96rpx; height: 96rpx; min-height: 96rpx; margin: 0; padding: 0; border: 1rpx solid #e3e6e8; border-radius: 50%; background: #fff; }
button.share-forward:active { background: #f2f4f3; }
button.share-cta::after, button.share-forward::after, button.share-state-button::after { border: 0; }

.share-bottom-space { height: 40rpx; }
