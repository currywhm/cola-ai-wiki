/* 问AI：极简版式——一个吉祥物、一句标题、几个胶囊入口、一个输入框，其余全部留白 */
.ask-page { display: flex; flex-direction: column; width: 100%; max-width: 750rpx; min-height: 100vh; margin: 0 auto; overflow-x: hidden; background: #f5f6f6; box-sizing: border-box; }
.ask-body { flex: 1; padding: 0 44rpx; box-sizing: border-box; }

.ask-hero-icon { display: flex; align-items: center; justify-content: flex-start; width: 108rpx; height: 108rpx; margin-top: 26rpx; }
.ask-hero-title { display: block; margin-top: 26rpx; color: #14171b; font-size: 44rpx; font-weight: 700; line-height: 1.3; letter-spacing: -.6rpx; }

/* 能力入口：一行一个的白色胶囊，宽度随内容收紧 */
.ask-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 22rpx; margin-top: 50rpx; }
button.ask-chip { display: flex; align-items: center; align-self: flex-start; width: auto; min-height: 84rpx; margin: 0; padding: 0 32rpx 0 26rpx; gap: 14rpx; border: 0; border-radius: 999rpx; background: #fff; box-shadow: 0 2rpx 10rpx rgba(24,28,34,.045); color: #23282f; font-size: 29rpx; font-weight: 400; line-height: 1.4; text-align: left; }
button.ask-chip:active { background: #f4f7f5; }

/* 推荐提问：同款胶囊，浅灰底 */
.ask-suggestions { display: flex; flex-direction: column; align-items: flex-start; gap: 18rpx; margin-top: 132rpx; padding-bottom: 20rpx; }
button.ask-suggestion { display: flex; align-items: center; align-self: flex-start; width: auto; max-width: 100%; min-height: 80rpx; margin: 0; padding: 0 30rpx; border: 0; border-radius: 20rpx; background: #ececed; color: #2b3138; font-size: 29rpx; font-weight: 400; line-height: 1.45; text-align: left; }
button.ask-suggestion:active { background: #e3e4e5; }

/* 登录前：导入引导卡片 */
.ask-promo { position: relative; margin-top: 46rpx; padding: 38rpx 30rpx 26rpx; border-radius: 26rpx; background: #fff; overflow: hidden; }
.ask-promo-copy { position: relative; z-index: 1; width: 56%; }
.ask-promo-title { display: block; color: #191d22; font-size: 34rpx; font-weight: 650; line-height: 1.3; letter-spacing: -.3rpx; }
.ask-promo-desc { display: block; margin-top: 12rpx; color: #a2a9b1; font-size: 26rpx; font-weight: 400; line-height: 1.45; }
button.ask-promo-button { display: inline-flex; align-items: center; justify-content: center; min-height: 76rpx; margin: 30rpx 0 0; padding: 0 36rpx; border: 1rpx solid #eceef0; border-radius: 999rpx; background: #fff; color: #23282f; font-size: 28rpx; font-weight: 500; line-height: 1.3; }
button.ask-promo-button:active { background: #f5f6f6; }
.ask-promo-art { position: absolute; right: -6rpx; bottom: 40rpx; width: 312rpx; height: 214rpx; opacity: .96; }
.ask-promo-dots { display: flex; align-items: center; justify-content: center; gap: 12rpx; margin-top: 30rpx; }
.ask-promo-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #d9dcdf; }
.ask-promo-dot.active { width: 44rpx; border-radius: 6rpx; background: #2b3138; }

.ask-bottom-space { height: 250rpx; }

/* 底部提问入口：贴在 tabBar 之上 */
.ask-footer { position: fixed; right: 0; bottom: calc(104rpx + env(safe-area-inset-bottom)); left: 0; z-index: 10; max-width: 750rpx; margin: 0 auto; padding: 18rpx 44rpx 20rpx; box-sizing: border-box; background: linear-gradient(180deg, rgba(245,246,246,0) 0%, rgba(245,246,246,.94) 34%, #f5f6f6 100%); }
.ask-composer { display: flex; align-items: center; min-height: 110rpx; padding: 0 34rpx; border-radius: 999rpx; background: #fff; box-shadow: 0 4rpx 18rpx rgba(24,28,34,.055); box-sizing: border-box; }
.ask-placeholder { flex: 1; min-width: 0; color: #b0b5bb; font-size: 30rpx; font-weight: 400; line-height: 1.4; }

/* 启动页：只在小程序冷启动时出现一次 */
.boot-screen { position: fixed; z-index: 9999; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; background: #fff; }
.boot-center { display: flex; flex-direction: column; align-items: center; justify-content: center; transform: translateY(-84rpx); }
.boot-avatar { width: 132rpx; height: 132rpx; border-radius: 34rpx; }
.boot-title { display: block; margin-top: 35rpx; color: #070707; font-size: 34rpx; font-weight: 500; line-height: 1.35; letter-spacing: .2rpx; }
.boot-dots { display: flex; align-items: center; justify-content: center; gap: 14rpx; margin-top: 52rpx; }
.boot-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #cfcfcf; animation: bootDotPulse 1.18s infinite ease-in-out; }
.boot-dot-one { background: #8b8b8b; animation-delay: 0s; }
.boot-dot-two { animation-delay: .16s; }
.boot-dot-three { animation-delay: .32s; }
@keyframes bootDotPulse { 0%, 78%, 100% { opacity: .45; transform: scale(1); } 38% { opacity: 1; transform: scale(1.22); } }

button.ask-chip::after, button.ask-suggestion::after, button.ask-promo-button::after { border: 0; }
