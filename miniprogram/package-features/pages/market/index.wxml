<view class="page market-page">
  <app-nav title="知识库广场" back />
  <view class="market-search search-bar"><ui-icon name="search" size="{{20}}" /><input value="{{query}}" placeholder="搜索知识库广场" bindinput="onInput" bindconfirm="search" confirm-type="search" /></view>
  <scroll-view class="market-tabs" scroll-x enable-flex><text class="market-tab {{category === '' ? 'active' : ''}}" data-category="" bindtap="chooseCategory">热门</text><text class="market-tab {{category === '科技' ? 'active' : ''}}" data-category="科技" bindtap="chooseCategory">科技</text><text class="market-tab {{category === '教育' ? 'active' : ''}}" data-category="教育" bindtap="chooseCategory">教育</text><text class="market-tab {{category === '职场' ? 'active' : ''}}" data-category="职场" bindtap="chooseCategory">职场</text><text class="market-tab {{category === '财经' ? 'active' : ''}}" data-category="财经" bindtap="chooseCategory">财经</text><text class="market-tab {{category === '产业' ? 'active' : ''}}" data-category="产业" bindtap="chooseCategory">产业</text><text class="market-tab {{category === '健康' ? 'active' : ''}}" data-category="健康" bindtap="chooseCategory">健康</text><text class="market-tab {{category === '法律' ? 'active' : ''}}" data-category="法律" bindtap="chooseCategory">法律</text><text class="market-tab {{category === '生活' ? 'active' : ''}}" data-category="生活" bindtap="chooseCategory">生活</text><text class="market-tab {{category === '其他' ? 'active' : ''}}" data-category="其他" bindtap="chooseCategory">其他</text></scroll-view>
  <view wx:if="{{loading}}" class="card state-card"><text class="state-desc">正在加载公开知识库…</text></view>
  <view wx:elif="{{error}}" class="card market-empty"><view class="state-icon"><ui-icon name="response" size="{{30}}" /></view><text class="state-title">广场暂时不可用</text><text class="state-desc">{{error}}</text><button class="ghost-btn" bindtap="load">重新加载</button></view>
  <view wx:elif="{{!items.length}}" class="card market-empty"><view class="state-icon"><ui-icon name="folder" size="{{30}}" /></view><text class="state-title">暂无公开知识库</text><text class="state-desc">目前还没有公开内容。你可以先在 Cola 知识库中整理自己的资料。</text><button class="ghost-btn" bindtap="backToChat">返回问答</button></view>
  <block wx:else>
    <view wx:for="{{items}}" wx:key="id" class="market-item">
      <view class="market-cover"><image wx:if="{{item.avatarUrl}}" class="market-cover-image" src="{{item.avatarUrl}}" mode="aspectFill" /><ui-icon wx:else name="folder" size="{{28}}" /></view>
      <view class="grow"><view class="market-title-line"><text class="market-name">{{item.name}}</text><text class="market-category">{{item.category || '其他'}}</text></view><text class="market-desc">{{item.description || '这个知识库暂时还没有填写简介'}}</text><text class="market-meta">{{item.subscribers}} 人订阅 | {{item.documents}} 个内容 | @{{item.publisher_name}}</text></view>
      <text wx:if="{{item.owned}}" class="market-own">我的</text>
      <button wx:else class="market-subscribe {{item.subscribed ? 'subscribed' : ''}}" data-id="{{item.id}}" catchtap="toggleSubscription" disabled="{{busyId}}">{{busyId === item.id ? '处理中' : item.subscribed ? '已订阅' : '订阅'}}</button>
    </view>
  </block>
</view>
