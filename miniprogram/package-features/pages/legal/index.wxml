<view class="page legal-page">
  <app-nav title="{{title}}" back plain />

  <view wx:if="{{loadState === 'loading'}}" class="legal-state">
    <view class="legal-skeleton legal-skeleton-title"></view>
    <view class="legal-skeleton legal-skeleton-line"></view>
    <view class="legal-skeleton legal-skeleton-line short"></view>
  </view>

  <view wx:elif="{{loadState === 'error'}}" class="legal-state">
    <text class="legal-state-title">这份说明暂时打不开</text>
    <text class="legal-state-desc">网络恢复后可以重试；需要马上联系我们的话，点下面的客服。</text>
    <button class="legal-retry" bindtap="retry">重新加载</button>
  </view>

  <block wx:else>
    <view class="legal-doc-head">
      <text class="legal-doc-title">{{title}}</text>
      <view class="legal-dates">
        <text wx:if="{{docUpdatedLabel}}" class="legal-date">更新日期：{{docUpdatedLabel}}</text>
        <text wx:if="{{docEffectiveLabel}}" class="legal-date">生效日期：{{docEffectiveLabel}}</text>
      </view>
    </view>

    <view class="legal-body">
      <block wx:for="{{blocks}}" wx:key="key">
        <text wx:if="{{item.type === 'heading'}}" class="legal-h2{{item.first ? ' legal-first' : ''}}">{{item.text}}</text>

        <view wx:elif="{{item.type === 'paragraph'}}" class="legal-p{{item.first ? ' legal-first' : ''}}">
          <text wx:for="{{item.runs}}" wx:for-item="run" wx:key="key" class="legal-run legal-run-{{run.style}}">{{run.text}}</text>
        </view>

        <view wx:elif="{{item.type === 'bullet'}}" class="legal-line{{item.first ? ' legal-first' : ''}}">
          <view class="legal-dot"></view>
          <view class="legal-line-body">
            <text wx:for="{{item.runs}}" wx:for-item="run" wx:key="key" class="legal-run legal-run-{{run.style}}">{{run.text}}</text>
          </view>
        </view>

        <view wx:elif="{{item.type === 'step'}}" class="legal-line{{item.first ? ' legal-first' : ''}}">
          <view class="legal-step">{{item.index}}</view>
          <view class="legal-line-body">
            <text wx:for="{{item.runs}}" wx:for-item="run" wx:key="key" class="legal-run legal-run-{{run.style}}">{{run.text}}</text>
          </view>
        </view>

        <view wx:elif="{{item.type === 'note'}}" class="legal-note{{item.first ? ' legal-first' : ''}}">
          <view class="legal-note-bar"></view>
          <view class="legal-line-body">
            <text wx:for="{{item.runs}}" wx:for-item="run" wx:key="key" class="legal-run legal-run-{{run.style}}">{{run.text}}</text>
          </view>
        </view>
      </block>
    </view>

    <view wx:if="{{isData}}" class="legal-actions">
      <button class="legal-action" bindtap="copyDataSummary">复制资料库清单</button>
      <button class="legal-action" bindtap="clearLocalCache">清理本地缓存</button>
    </view>

    <view class="legal-help">
      <text class="legal-help-title">还有疑问</text>
      <text class="legal-help-desc">注销账号、删除数据、订单与退款、侵权投诉，都可以直接找我们处理。</text>
      <button class="legal-contact legal-contact-btn" open-type="contact" session-from="{{contactSessionFrom}}"
        send-message-title="{{contactCardTitle}}" send-message-path="{{contactCardPath}}"
        show-message-card="{{true}}" bindcontact="onContact">联系客服</button>
    </view>

    <view wx:if="{{related.length}}" class="legal-related">
      <text class="legal-related-title">相关说明</text>
      <button class="legal-related-item" wx:for="{{related}}" wx:key="id" data-id="{{item.id}}" bindtap="openDoc">
        <view class="legal-related-main">
          <text class="legal-related-name">{{item.title}}</text>
          <text class="legal-related-desc">{{item.summary}}</text>
        </view>
        <ui-icon name="chevron-right" size="{{15}}" />
      </button>
    </view>

    <text class="legal-foot-note">{{fromCache ? '当前显示的是本机缓存内容，联网后会自动更新。' : '内容以后端下发为准，更新后本页自动同步。'}}</text>
  </block>
</view>
