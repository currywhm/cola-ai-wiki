# 微信云托管环境变量完整样例
# 复制到云托管控制台逐项填写；不要提交真实 .env。
# 必填标记说明：
#   [必填] 不填会导致生产启动失败
#   [云注入] 微信云托管开启 MySQL 后自动注入，通常不用手填
#   [可选] 启用对应功能时再填

# ---------- 基础服务 ----------
APP_ENV=production
APP_NAME=知库资料服务
PORT=80
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef

# ---------- 数据库 ----------
# 方案 A：微信云托管 MySQL，推荐。MYSQL_* 通常由平台自动注入。
MYSQL_ADDRESS=10.0.0.8:3306
MYSQL_USERNAME=数据库用户名
MYSQL_PASSWORD=数据库密码
MYSQL_DATABASE=数据库名

# 方案 B：手工指定完整连接串。填写后覆盖上面的 MYSQL_*，二选一。
# DATABASE_URL=mysql+aiomysql://用户名:密码@主机:3306/数据库名?charset=utf8mb4

# ---------- 文件与运营内容 ----------
UPLOAD_DIR=/app/uploads
CONTENT_DIR=/app/content

# ---------- 对象存储 ----------
# 云托管使用 COS；本地开发可改为 local。
STORAGE_BACKEND=cos
# 微信云托管官方对象存储变量名。
Bucket=你的对象存储桶名
Region=ap-shanghai
# 兼容变量：与 Bucket / Region 二选一，留空即可。
COS_BUCKET=
COS_REGION=
COS_PREFIX=cola
# 云托管留空，后端通过 /_/cos/getauth 获取临时密钥。
COS_SECRET_ID=
COS_SECRET_KEY=

# ---------- 微信小程序登录 ----------
# 开发者 ID 就是小程序 AppID，格式为 wx 开头 18 位。
WECHAT_APPID=wx1234567890abcdef
# 必须是后台生成的 32 位 AppSecret。
WECHAT_SECRET=0123456789abcdef0123456789abcdef
WECHAT_OPENAPI_BASE=http://api.weixin.qq.com

# ---------- 微信客服：不需要联系客服时可全部留空 ----------
WECHAT_KF_TOKEN=
WECHAT_KF_AES_KEY=
WECHAT_KF_ADMIN_TOKEN=
WECHAT_KF_ACCOUNT_SUFFIX=
WECHAT_KF_AUTOREPLY=true
WECHAT_KF_AUTOREPLY_COOLDOWN_SECONDS=3600

# ---------- 微信支付：当前默认个人主体虚拟支付 ----------
WECHAT_MCHID=
WECHAT_MCH_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=/app/cert/apiclient_key.pem
WECHAT_PAY_PLATFORM_CERT_PATH=/app/cert/wechatpay_platform.pem
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_BASE_URL=https://api.mch.weixin.qq.com
WECHAT_PAYMENT_MODE=virtual

WECHAT_VIRTUAL_OFFER_ID=
WECHAT_VIRTUAL_APP_KEY=
WECHAT_VIRTUAL_ENV=0
WECHAT_VIRTUAL_PRODUCT_ID=
WECHAT_VIRTUAL_GOODS_PRICE=0
WECHAT_VIRTUAL_MONTHLY_PRODUCT_ID=
WECHAT_VIRTUAL_MONTHLY_GOODS_PRICE=0
WECHAT_VIRTUAL_QUARTERLY_PRODUCT_ID=
WECHAT_VIRTUAL_QUARTERLY_GOODS_PRICE=0
WECHAT_VIRTUAL_YEARLY_PRODUCT_ID=
WECHAT_VIRTUAL_YEARLY_GOODS_PRICE=0
WECHAT_VIRTUAL_PLUS_MONTHLY_PRODUCT_ID=
WECHAT_VIRTUAL_PLUS_MONTHLY_GOODS_PRICE=0
WECHAT_VIRTUAL_PLUS_QUARTERLY_PRODUCT_ID=
WECHAT_VIRTUAL_PLUS_QUARTERLY_GOODS_PRICE=0
WECHAT_VIRTUAL_PLUS_YEARLY_PRODUCT_ID=
WECHAT_VIRTUAL_PLUS_YEARLY_GOODS_PRICE=0
WECHAT_VIRTUAL_NOTIFY_URL=https://你的后端域名/api/pay/notify
WECHAT_VIRTUAL_NOTIFY_TOKEN=
WECHAT_VIRTUAL_BASE_URL=https://api.weixin.qq.com

# ---------- 大模型：统一推荐配置 ----------
# LLM_* 优先级最高；任何兼容 OpenAI Chat Completions 的服务都可用这三项接入。
LLM_API_KEY=你的模型APIKey
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 兼容原来的供应商配置；使用 LLM_* 时可留空。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-Text-01
# 前端可选模型，格式：模型值:显示名,模型值:显示名
CHAT_MODELS=

# ---------- Harness：基础部署建议先关闭 ----------
HARNESS_ENABLED=false
HARNESS_HOME=/app/harness-home
HARNESS_PROFILE=sdk
HARNESS_PROVIDER=deepseek-official
HARNESS_MODEL=deepseek-v4-flash
HARNESS_MAX_TOKENS=4096
HARNESS_RUNTIME_MODE=exe
HARNESS_DSH_BIN=
HARNESS_SDK_PATH=
HARNESS_RUNTIME_SDK_PATH=
HARNESS_REASONING_EFFORT=low
HARNESS_STRICT=true
HARNESS_WORKSPACES=/app/harness-workspaces
HARNESS_MAX_RUNTIMES=6
HARNESS_IDLE_SECONDS=1800
HARNESS_QUICK_REASONING_EFFORT=low
HARNESS_DEEP_REASONING_EFFORT=high
HARNESS_DEEP_MODEL=
HARNESS_PLAN_MODE=true

# ---------- 积分计费 ----------
CREDIT_MARKUP=1.5
CREDIT_UNIT_YUAN=0.001
CREDIT_PRICE_INPUT_HIT=0.04
CREDIT_PRICE_INPUT_MISS=2.0
CREDIT_PRICE_OUTPUT=8.0

# ---------- 对话记忆 ----------
MEMORY_RECENT_MESSAGES=8
MEMORY_COMPRESS_CHARS=3000
MEMORY_SUMMARY_MAX_CHARS=600

# ---------- 全网检索：直连模式使用 ----------
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=https://api.duckduckgo.com
WEB_SEARCH_TIMEOUT_SECONDS=12
# Harness agent 的 web_search 工具使用 Exa 时需要。
EXA_API_KEY=

# ---------- 合规文案 ----------
LEGAL_OPERATOR_NAME=你的运营者名称
LEGAL_CONTACT_EMAIL=
LEGAL_ICP_NUMBER=

# ---------- 跨域 ----------
CORS_ORIGINS=*
