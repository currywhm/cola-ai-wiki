/* 组件 wxss 不允许标签选择器（旧写法 button.hd-xxx 会报 “Some selectors are not allowed in component wxss”），
   但微信基础库对 <button> 的默认样式是 wx-button[class]（特异性 0,1,1），单类选择器压不住，
   会表现为「按钮没边框、文字居中、padding/宽度丢失」。
   因此这里把按钮类名连写两遍（如 .hd-new.hd-new）把特异性提到 0,2,0，等价于原来的 button.hd-new。 */
/* 技能选择面板：技能广场 / 我的技能。
   全程不用分隔线，列表靠留白与圆角卡片区分；点赞收藏只用小图标 + 数字，保持安静。 */

.sk-layer { position: fixed; z-index: 210; top: 0; right: 0; bottom: 0; left: 0; }
.sk-mask { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: rgba(0, 0, 0, .42); }
.sk-panel { position: absolute; right: 0; bottom: 0; left: 0; display: flex; flex-direction: column; max-width: 750rpx; max-height: 84vh; margin: 0 auto; box-sizing: border-box; padding: 34rpx 30rpx 12rpx; border-radius: 30rpx 30rpx 0 0; background: #fff; animation: sk-up .2s ease-out; }
@keyframes sk-up { from { transform: translateY(40rpx); opacity: .5; } to { transform: translateY(0); opacity: 1; } }

/* 标题：标题 + 一句说明，右侧关闭 */
.sk-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.sk-head-copy { flex: 1 1 auto; min-width: 0; }
.sk-title { display: block; color: #14171b; font-size: 38rpx; font-weight: 700; line-height: 1.25; letter-spacing: -.4rpx; }
.sk-sub { display: block; margin-top: 6rpx; color: #9aa1a9; font-size: 23rpx; font-weight: 400; line-height: 1.4; }
.sk-close.sk-close { display: flex; align-items: center; justify-content: center; flex: 0 0 64rpx; width: 64rpx; min-width: 64rpx; height: 64rpx; min-height: 64rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; background: #f4f5f6; }
.sk-close.sk-close::after { border: 0; }
.sk-close.sk-close:active { background: #ebedee; }

/* 两栏：技能广场 / 我的技能 */
.sk-tabs { display: flex; gap: 20rpx; margin-top: 28rpx; }
.sk-tab { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; flex: 1 1 0; min-width: 0; height: 148rpx; border: 2rpx solid transparent; border-radius: 26rpx; background: #f6f7f8; }
.sk-tab.on { border-color: #e2e5e8; background: #fff; box-shadow: 0 4rpx 14rpx rgba(24, 28, 34, .05); }
.sk-tab-icon { display: flex; align-items: center; justify-content: center; height: 52rpx; opacity: .78; }
.sk-tab.on .sk-tab-icon { opacity: 1; }
.sk-tab-text { color: #5c646c; font-size: 28rpx; font-weight: 500; line-height: 1.3; }
.sk-tab.on .sk-tab-text { color: #14171b; font-weight: 600; }

/* 搜索 */
.sk-search { display: flex; align-items: center; gap: 14rpx; height: 84rpx; margin-top: 24rpx; padding: 0 26rpx; border-radius: 999rpx; background: #f5f6f7; }
.sk-search-input { flex: 1 1 auto; min-width: 0; height: 84rpx; border: 0; background: transparent; color: #1f2227; font-size: 28rpx; }
.sk-search-ph { color: #a8adb3; font-size: 28rpx; }
.sk-search-clear.sk-search-clear { display: flex; align-items: center; justify-content: center; flex: 0 0 40rpx; width: 40rpx; min-width: 40rpx; height: 40rpx; min-height: 40rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; background: transparent; opacity: .5; }
.sk-search-clear.sk-search-clear::after { border: 0; }

.sk-body { flex: 1 1 auto; min-height: 0; margin-top: 12rpx; }

/* 新建技能：与列表同一套浅底卡，不用重底色 */
.sk-new { display: flex; align-items: center; gap: 16rpx; margin-top: 14rpx; padding: 22rpx 24rpx; border-radius: 22rpx; background: #f3f5f6; }
.sk-new-hover { opacity: .82; }
.sk-new-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 52rpx; width: 52rpx; height: 52rpx; border-radius: 16rpx; background: #fff; }
.sk-new-text { color: #23282f; font-size: 28rpx; font-weight: 600; line-height: 1.3; }
.sk-new-hint { margin-left: auto; color: #9aa1a9; font-size: 22rpx; line-height: 1.3; }

/* 技能条目 */
.sk-item { display: flex; align-items: flex-start; gap: 20rpx; margin-top: 16rpx; padding: 24rpx 24rpx 20rpx; border: 2rpx solid #eef0f2; border-radius: 24rpx; background: #fff; }
.sk-item.on { border-color: #bfdbfb; background: #f6faff; }
.sk-item-hover { background: #fafbfb; }
.sk-item-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 76rpx; width: 76rpx; height: 76rpx; border-radius: 22rpx; background: #f4f5f6; }
/* 选中态用两个小变化就把状态说清楚：图标底变浅蓝 + 对号套一个小圆底（不加重底色） */
.sk-item-icon.on { background: #e8f1fe; }
.sk-item-main { flex: 1 1 auto; min-width: 0; }
.sk-item-head { display: flex; align-items: center; gap: 12rpx; }
.sk-item-name { max-width: 100%; overflow: hidden; color: #14171b; font-size: 30rpx; font-weight: 600; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.sk-badge { flex: 0 0 auto; padding: 2rpx 12rpx; border-radius: 8rpx; background: #f0f1f3; color: #7d848c; font-size: 20rpx; font-weight: 400; line-height: 1.7; }
.sk-badge.mine { background: #f0f1f3; color: #7d848c; }
.sk-badge.published { background: #eef3fd; color: #2f6fdd; }
.sk-check { display: flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 42rpx; height: 42rpx; border-radius: 50%; background: #e8f1fe; }
.sk-item-desc { display: block; margin-top: 6rpx; overflow: hidden; color: #9aa1a9; font-size: 24rpx; font-weight: 400; line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }

/* 条目底部：右侧偏下是「微信号 + 收藏 + 点赞」，作者按钮靠左；全部小一号，不抢技能名的主次 */
.sk-item-foot { display: flex; align-items: center; gap: 12rpx; margin-top: 14rpx; }
.sk-item-actions { display: flex; align-items: center; gap: 12rpx; flex: 0 0 auto; }
.sk-item-wechat { max-width: 300rpx; overflow: hidden; color: #a8adb3; font-size: 21rpx; font-weight: 400; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.sk-mini.sk-mini { display: flex; align-items: center; justify-content: center; height: 48rpx; min-height: 48rpx; margin: 0; padding: 0 20rpx; border: 1rpx solid #e3e6e8; border-radius: 999rpx; background: #fff; color: #5c646c; font-size: 21rpx; font-weight: 400; line-height: 1; }
.sk-mini.sk-mini.primary { border-color: transparent; background: #eef1f4; color: #35404a; font-weight: 500; }
.sk-mini.sk-mini::after { border: 0; }
.sk-mini.sk-mini:active { opacity: .8; }
.sk-stats { display: flex; align-items: center; gap: 18rpx; flex: 0 1 auto; margin-left: auto; }
.sk-stat { display: flex; align-items: center; gap: 6rpx; padding: 4rpx 2rpx; }
.sk-stat-hover { opacity: .6; }
.sk-stat-num { color: #a8adb3; font-size: 21rpx; font-weight: 400; line-height: 1; }
.sk-stat-num.on { color: #2c2c2c; font-weight: 500; }

/* 空态与加载 */
.sk-hint { padding: 70rpx 0; color: #a8adb3; font-size: 25rpx; text-align: center; }
.sk-empty { display: flex; flex-direction: column; align-items: center; padding: 76rpx 20rpx 40rpx; text-align: center; }
.sk-empty-icon { display: flex; align-items: center; justify-content: center; width: 104rpx; height: 104rpx; border-radius: 32rpx; background: #f4f5f6; }
.sk-empty-title { margin-top: 24rpx; color: #5c646c; font-size: 27rpx; font-weight: 500; line-height: 1.4; }
.sk-empty-desc { margin-top: 8rpx; color: #a8adb3; font-size: 23rpx; font-weight: 400; line-height: 1.5; }

/* 底部只做状态说明：多选后面板不自动关闭，关掉即可，不需要确认按钮 */
.sk-foot { padding: 16rpx 4rpx calc(10rpx + env(safe-area-inset-bottom)); }
.sk-foot-count { display: block; color: #5c646c; font-size: 24rpx; font-weight: 500; line-height: 1.4; }

.sk-bottom-space { height: 24rpx; }
