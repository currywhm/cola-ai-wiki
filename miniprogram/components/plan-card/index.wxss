/* 计划卡片：附着在回答上方的「页内面板」，不加分隔线、不用重底色，
   靠留白与圆角把计划正文和对话正文分开，折叠过程区也不影响它的可见性。 */

.plan-card { margin: 0 0 22rpx; padding: 26rpx 26rpx 22rpx; border-radius: 28rpx; background: #f7f8f9; }
.plan-card.approved { background: #f4f7f4; }
.plan-card.revising { background: #f8f7f5; }

.plan-head { display: flex; align-items: center; gap: 16rpx; }
.plan-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 52rpx; width: 52rpx; height: 52rpx; border-radius: 16rpx; background: #fff; }
.plan-heading { flex: 1 1 auto; min-width: 0; }
.plan-title { display: block; color: #14171b; font-size: 31rpx; font-weight: 600; line-height: 1.32; letter-spacing: -.2rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.plan-sub { display: block; margin-top: 4rpx; color: #9aa1a9; font-size: 23rpx; font-weight: 400; line-height: 1.35; }
.plan-toggle { display: flex; align-items: center; justify-content: center; flex: 0 0 48rpx; width: 48rpx; height: 48rpx; }

.plan-body { max-height: 720rpx; margin-top: 20rpx; padding: 22rpx 22rpx 8rpx; border-radius: 20rpx; background: #fff; }
.plan-md { display: block; color: #2c3138; font-size: 28rpx; line-height: 1.68; letter-spacing: -.1rpx; }

.plan-actions { display: flex; align-items: center; justify-content: flex-end; gap: 16rpx; margin-top: 22rpx; }
button.plan-btn { display: flex; align-items: center; justify-content: center; margin: 0; padding: 0 30rpx; height: 68rpx; min-height: 68rpx; border: 0; border-radius: 34rpx; font-size: 27rpx; font-weight: 500; line-height: 1; }
button.plan-btn::after { border: 0; }
button.plan-revise { color: #4a5058; background: #eef0f2; }
button.plan-revise:active { background: #e4e7ea; }
button.plan-approve { color: #fff; background: #14171b; }
button.plan-approve:active { background: #2b3038; }
