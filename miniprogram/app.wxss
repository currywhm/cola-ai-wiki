page {
  /* 设计令牌：全站唯一的字阶、墨色、圆角来源；间距按 8/16/24/32/48rpx 取 */
  --bg:#f4f6f4; --surface:#ffffff; --surface-soft:#f4f6f4; --surface-sink:#ecefec;
  --line:#e7eae7; --line-soft:#eef1ee;
  --ink-1:#1b211e; --ink-2:#4c554f; --ink-3:#6d756e; --ink-4:#8f978f;
  --brand:#078b50; --brand-deep:#067a46; --brand-ink:#04613a; --brand-soft:#e8f4ee;
  --info:#2f6fdd; --info-soft:#eef3fd;
  --danger:#cf4a45; --danger-soft:#fceceb;
  --r-sm:12rpx; --r-md:16rpx; --r-lg:20rpx; --r-xl:28rpx; --r-pill:999rpx;
  --t-hero:40rpx; --t-h1:36rpx; --t-h2:34rpx; --t-body:32rpx; --t-lead:28rpx;
  --t-row:26rpx; --t-meta:24rpx; --t-micro:22rpx;
  background:var(--bg);
  color:var(--ink-1);
  /* 中文优先的系统字栈：iOS 落到苹方，Android 依次尝试鸿蒙/小米/思源，最后兜到雅黑 */
  font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","HarmonyOS Sans SC","MiSans","Source Han Sans SC","Noto Sans CJK SC","Hiragino Sans GB","Microsoft YaHei","Helvetica Neue",Arial,sans-serif;
  font-size:30rpx;
  font-weight:400;
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
  text-rendering:optimizeLegibility;
}
view,text,button,input,textarea,scroll-view { box-sizing:border-box; }
/* Override WeChat v2 button:not([size=mini]); page controls use button.class. */
button[class] { display:flex; align-items:center; justify-content:center; width:auto; min-width:0; margin:0; padding:0; border:0; background:transparent; color:inherit; font-family:inherit; font-size:29rpx; font-weight:500; line-height:1.4; letter-spacing:0; text-align:center; }
button::after { border:0; }
button[class][disabled] { opacity:.5; }
button.button-hover { opacity:.75; }
ui-icon { display:inline-flex; flex-shrink:0; align-items:center; justify-content:center; vertical-align:middle; }
input,textarea { min-width:0; color:var(--ink-1); font-family:inherit; font-size:30rpx; line-height:1.55; }
.page { width:100%; max-width:750rpx; min-height:100vh; margin:0 auto; padding:0 28rpx calc(32rpx + env(safe-area-inset-bottom)); overflow-x:hidden; }
.eyebrow { color:var(--ink-3); font-size:var(--t-meta); line-height:1.5; }
.headline { display:block; font-size:42rpx; line-height:1.32; font-weight:600; letter-spacing:-.2rpx; }
.section-title { display:block; font-size:var(--t-h1); line-height:1.4; font-weight:600; margin:32rpx 0 20rpx; }
.muted { color:var(--ink-3); }
.small { display:block; margin-top:6rpx; font-size:var(--t-micro); line-height:1.5; }
.block { display:block; }
.bold { font-weight:600; }
.grow { flex:1; min-width:0; }
.row { display:flex; align-items:center; min-width:0; }
.row > view,.row > text,.row > button { min-width:0; }
.between { justify-content:space-between; }
.gap-sm { gap:14rpx; }
.gap-md { gap:20rpx; }
.card { background:var(--surface); border:1rpx solid var(--line); border-radius:var(--r-lg); padding:24rpx; box-shadow:0 2rpx 10rpx rgba(27,33,30,.04); }
.soft-card { background:var(--surface-soft); border-radius:var(--r-md); padding:22rpx; }
.card-title { display:block; overflow:hidden; font-size:var(--t-body); font-weight:600; line-height:1.4; text-overflow:ellipsis; white-space:nowrap; }
.card-subtitle { display:block; overflow:hidden; font-size:var(--t-micro); line-height:1.5; text-overflow:ellipsis; white-space:nowrap; }
.section-head { gap:20rpx; margin-bottom:20rpx; }
.section-head .section-title { margin:0; }
button.primary-btn,button.ghost-btn { min-height:88rpx; padding:18rpx 28rpx; border-radius:var(--r-md); font-size:var(--t-lead); line-height:1.5; font-weight:600; gap:12rpx; }
button.primary-btn { width:100%; background:var(--brand-deep); color:#fff; }
button.ghost-btn { background:var(--brand-soft); color:var(--brand-ink); }
.link,button.link { display:inline-flex; align-items:center; gap:4rpx; min-height:64rpx; color:var(--brand); font-size:var(--t-meta); line-height:1.4; white-space:nowrap; flex-shrink:0; }
.search-bar { display:flex; align-items:center; gap:14rpx; min-height:88rpx; padding:0 22rpx; border:1rpx solid var(--line); border-radius:var(--r-md); background:var(--surface); color:var(--ink-3); }
.search-bar input { flex:1; width:0; min-width:0; height:84rpx; font-size:var(--t-lead); }
.tag { display:inline-flex; align-items:center; min-height:40rpx; padding:4rpx 12rpx; border-radius:var(--r-sm); background:var(--brand-soft); color:var(--brand-ink); font-size:var(--t-micro); line-height:1.4; white-space:nowrap; }
.file-icon { display:flex; align-items:center; justify-content:center; flex:0 0 68rpx; width:68rpx; height:68rpx; border-radius:var(--r-md); background:var(--brand-soft); color:var(--brand-ink); font-size:var(--t-micro); font-weight:600; }
.flow-action { width:100%; margin:28rpx 0 12rpx; }
.empty { padding:48rpx 28rpx; text-align:center; color:var(--ink-3); line-height:1.7; }
.empty-title { display:block; color:var(--ink-1); font-weight:600; margin-bottom:8rpx; }
.loading { padding:30rpx; color:var(--brand); text-align:center; }
.state-card { padding:42rpx 28rpx; text-align:center; }
.state-card .state-title { display:block; margin:18rpx 0 10rpx; font-size:var(--t-body); line-height:1.4; font-weight:600; }
.state-card .state-desc { display:block; color:var(--ink-3); font-size:var(--t-row); line-height:1.7; }
.state-card button.ghost-btn { display:inline-flex; min-width:200rpx; margin-top:26rpx; }
.state-icon { display:flex; align-items:center; justify-content:center; width:84rpx; height:84rpx; margin:0 auto; border-radius:var(--r-lg); background:var(--brand-soft); }
.skeleton { width:80%; height:30rpx; margin:0 auto 20rpx; border-radius:var(--r-sm); background:var(--surface-sink); }
.skeleton.short { width:50%; margin-bottom:30rpx; }
@media (max-width:340px) { .page { padding-left:24rpx; padding-right:24rpx; } .headline { font-size:38rpx; } }
