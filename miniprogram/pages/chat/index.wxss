page { overflow-x:hidden; }
/* 会话态与「问AI」问答页共用同一套版式（消息、过程区、来源、操作） */
@import "../../styles/thread.wxss";
.chat-page { display:flex; flex-direction:column; width:100%; height:100vh; min-height:0; overflow:hidden; padding:0 24rpx calc(110rpx + env(safe-area-inset-bottom)); background:#f7f7f7; }
/* 会话态整页接管版式：通栏白底 + 只留安全区，和问AI问答页完全对齐 */
.conversation-mode { padding:0 0 env(safe-area-inset-bottom); background:#fff; }
/* 进入文件夹后不保留底部导航：整页下沉，提问入口贴着底部，与「问AI」首页同一个位置感 */
.chat-page.folder-mode { padding-bottom:calc(16rpx + env(safe-area-inset-bottom)); }
.library-toolbar { display:flex; align-items:center; justify-content:space-between; width:100%; min-width:0; gap:20rpx; flex-shrink:0; padding:24rpx 8rpx 8rpx; }
.library-desc { display:-webkit-box; overflow:hidden; padding:4rpx 8rpx 12rpx; color:#8a919b; font-size:24rpx; line-height:1.5; -webkit-box-orient:vertical; -webkit-line-clamp:2; }
/* 必须写成 button.class：app.wxss 里的 button[class] 优先级是 (0,1,1)，
   只写 .class 会被它盖掉，字号永远不生效（这就是这个标题一直看着很小的原因）。 */
button.library-title-wrap { display:flex; align-items:center; justify-content:flex-start; flex:0 1 auto; width:auto !important; min-width:0 !important; max-width:calc(100% - 236rpx); gap:9rpx; margin:0; padding:0; border:0; background:transparent; color:#1f2227; font-size:34rpx; font-weight:760; line-height:1.35; text-align:left; letter-spacing:-.6rpx; }
.library-title-wrap text { display:block; flex:0 1 auto; min-width:0; overflow:hidden; color:#1f2227; font-size:34rpx; font-weight:760; line-height:1.35; letter-spacing:-.6rpx; text-overflow:ellipsis; white-space:nowrap; }
.library-switch { display:flex; align-items:center; justify-content:center; flex:0 0 46rpx; width:46rpx; min-width:46rpx; height:46rpx; min-height:46rpx; border-radius:50%; background:#eceef0; color:#20242b; opacity:1; }
.toolbar-actions { display:flex; align-items:center; flex:0 0 auto; gap:14rpx; }
button.toolbar-button { display:flex; align-items:center; justify-content:center; flex:0 0 64rpx; width:64rpx; min-width:64rpx; height:64rpx; min-height:64rpx; padding:0; border-radius:18rpx; background:#f0f0f0; color:#161616; }
.toolbar-button.add-button { background:#f0f0f0; }
.messages { flex:1 1 auto; min-width:0; min-height:0; height:0; padding:4rpx 0 28rpx; }
.welcome { display:flex; align-items:center; justify-content:center; min-height:560rpx; padding:2rpx 0 40rpx; }
.welcome.with-directory { display:block; min-height:0; padding:0 0 40rpx; }
.empty-knowledge { display:flex; flex-direction:column; align-items:center; justify-content:center; transform:translateY(12rpx); color:#929292; }
.empty-illustration { width:178rpx; height:124rpx; opacity:.72; }
.empty-title { display:block; margin-top:24rpx; color:#969696; font-size:33rpx; font-weight:600; line-height:1.35; letter-spacing:0; }
.empty-import { display:flex; align-items:center; justify-content:center; gap:10rpx; min-height:72rpx; margin-top:30rpx; padding:0 34rpx; border:1rpx solid #e3e5e6; border-radius:20rpx; background:#fff; color:#23262b; font-size:30rpx; font-weight:600; }
.directory-panel { width:100%; align-self:flex-start; }
/* 文件夹内的路径：知识库名 › 文件夹名；点前一段退回根目录，全程不画分隔线 */
.dir-crumb { display:flex; align-items:center; gap:10rpx; padding:12rpx 8rpx 16rpx; }
button.dir-crumb-root { display:flex; align-items:center; flex:0 1 auto; min-width:0; margin:0; padding:0; border:0; background:transparent; }
button.dir-crumb-root::after { border:0; }
button.dir-crumb-root:active { opacity:.6; }
button.dir-crumb-root text { display:block; min-width:0; max-width:400rpx; overflow:hidden; color:#98a1ab; font-size:29rpx; font-weight:500; line-height:1.4; text-overflow:ellipsis; white-space:nowrap; }
.dir-crumb-sep { display:flex; align-items:center; flex:0 0 auto; color:#c3c9cf; }
.dir-crumb-current { flex:0 1 auto; min-width:0; overflow:hidden; color:#20242b; font-size:29rpx; font-weight:600; line-height:1.4; text-overflow:ellipsis; white-space:nowrap; }
.directory-list { overflow:hidden; border:0; border-radius:0; background:transparent; box-shadow:none; }
/* 列表不画分隔线；行高归零让操作区与行体完全重合，避免漏出 1px 细边像表格线 */
.dir-swipe-row { position:relative; display:block; overflow:hidden; border:0 none; font-size:0; line-height:0; }
.dir-swipe-row button::before, .dir-swipe-row button::after { display:none; content:none; border:0 none; box-shadow:none; }
/* 左滑露出的操作区：整行高的文字块，和「历史对话」抽屉用同一套视觉 */
/* 操作区只在左滑后存在，收起时完全不渲染 */
.dir-actions { position:absolute; z-index:1; top:0; right:0; bottom:0; display:none; align-items:stretch; width:232rpx; }
.dir-swipe-row.swiped .dir-actions { display:flex; }
button.dir-action { display:flex; align-items:center; justify-content:center; flex:1 1 0; min-width:0; margin:0; padding:0; border:0; border-radius:0; font-size:25rpx; font-weight:500; line-height:1.3; }
button.dir-action::after { border:0; }
button.dir-action:active { opacity:.82; }
.dir-action.pin-action { background:#ececec; color:#242424; }
.dir-action.pin-action.is-on { background:#e2e2e2; color:#71767c; font-size:23rpx; }
.dir-action.delete-action { background:#e64340; color:#fff; }
.dir-swipe-card { position:relative; z-index:2; background:#f7f7f7; transition:transform .18s ease; }
.directory-item { display:flex; align-items:center; min-height:136rpx; gap:20rpx; padding:18rpx 8rpx; }
.directory-file-icon { display:flex; align-items:center; justify-content:center; flex:0 0 92rpx; width:92rpx; min-width:92rpx; height:104rpx; overflow:hidden; border-radius:3rpx; background:#fff; box-shadow:0 1rpx 4rpx rgba(0,0,0,.07); color:#454f5b; }
.directory-file-icon image { width:100%; height:100%; }
.directory-file-icon.thumb-fallback { position:relative; color:#d73648; }
.directory-file-icon.thumb-fallback::before { content:''; position:absolute; top:15rpx; right:13rpx; left:13rpx; height:54rpx; border:2rpx solid #dfe2e3; border-radius:2rpx; background:linear-gradient(#f8f9f9 0 14rpx,transparent 14rpx 25rpx,#eef0f0 25rpx 29rpx,transparent 29rpx 39rpx,#eef0f0 39rpx 43rpx,transparent 43rpx); }
.directory-file-icon.thumb-fallback ui-icon { position:relative; z-index:1; margin-top:62rpx; }
.directory-file-copy { flex:1; min-width:0; }
.directory-file-name-row { display:flex; align-items:center; gap:10rpx; min-width:0; }
.pin-badge { flex:0 0 auto; padding:2rpx 10rpx; border-radius:8rpx; background:#f1f2f3; color:#6b7280; font-size:19rpx; font-weight:600; line-height:1.4; }
.directory-file-name { display:-webkit-box; overflow:hidden; color:#20242b; font-size:32rpx; font-weight:600; line-height:1.35; text-overflow:ellipsis; -webkit-box-orient:vertical; -webkit-line-clamp:2; }
.directory-file-meta { display:flex; align-items:center; gap:12rpx; margin-top:10rpx; color:var(--ink-4); font-size:var(--t-micro); line-height:1.3; }
.directory-file-type { color:var(--ink-4); font-weight:500; }
.directory-file-type.type-pdf { color:#d9503f; font-weight:650; }
.directory-meta-sep { color:#d4d9de; }
.directory-status-text.completed { color:var(--brand); }
.directory-status-text.processing { color:#b17b20; }
.directory-status-text.failed { color:var(--danger); }
.directory-state { display:flex; flex-direction:column; align-items:center; justify-content:center; width:100%; min-height:296rpx; padding:34rpx 24rpx; border:0; border-radius:22rpx; background:transparent; color:#929aa4; font-size:28rpx; line-height:1.5; text-align:center; box-shadow:none; }
.directory-skeleton { width:72%; height:24rpx; margin:0 auto 18rpx; border-radius:8rpx; background:#eef0f1; }
.directory-skeleton.short { width:44%; margin-bottom:22rpx; }
.directory-state-icon { display:flex; align-items:center; justify-content:center; width:78rpx; height:78rpx; margin-bottom:18rpx; border-radius:50%; background:#f1f1f1; color:#303030; }
button.directory-retry { min-height:58rpx; margin-top:18rpx; padding:8rpx 20rpx; border:1rpx solid #dce3e5; border-radius:16rpx; background:transparent; color:#159260; font-size:22rpx; }
.state-panel { margin-top:52rpx; padding:44rpx 24rpx; border:1rpx solid #e8ebed; border-radius:22rpx; background:#fff; text-align:center; }
.state-icon { display:flex; align-items:center; justify-content:center; width:76rpx; height:76rpx; margin:0 auto 18rpx; border-radius:22rpx; background:#edfff6; color:#09aa62; }
.state-title { display:block; color:#202a38; font-size:29rpx; font-weight:600; line-height:1.45; }
.state-desc { display:block; margin-top:9rpx; color:#7b8491; font-size:23rpx; line-height:1.65; }
button.outline-button,button.dark-button { min-width:210rpx; min-height:72rpx; margin:24rpx auto 0; padding:12rpx 24rpx; border-radius:16rpx; font-size:25rpx; font-weight:600; }
button.outline-button { border:1rpx solid #dce2e5; background:#fff; color:#475364; }
button.dark-button { background:#18212e; color:#fff; }
.message { margin:24rpx 0; }
.message.user { display:flex; justify-content:flex-end; }
.user-bubble { max-width:82%; padding:18rpx 22rpx; border-radius:22rpx 22rpx 6rpx 22rpx; background:#1a1a1a; color:#fff; font-size:28rpx; line-height:1.65; word-break:break-word; }
.assistant-message { display:flex; gap:16rpx; max-width:100%; }
.assistant-avatar { flex:0 0 56rpx; width:56rpx; height:56rpx; margin-top:4rpx; border-radius:18rpx; overflow:hidden; background:#eaf8f1; }
.assistant-avatar image { width:100%; height:100%; }
.assistant-card { flex:1; min-width:0; margin:0; padding:0; border:0; border-radius:0; background:transparent; box-shadow:none; }
.assistant-head { margin-bottom:6rpx; }
.assistant-name { color:#6b6b6b; font-size:24rpx; font-weight:600; line-height:1.4; }
.assistant-body { padding-right:56rpx; }
.conversation-mode .message { margin:18rpx 0 34rpx; }
.conversation-mode .messages { padding:8rpx 30rpx 24rpx; }
.conversation-mode .assistant-content { color:#1e2228; font-size:30rpx; line-height:1.9; }
.conversation-mode .assistant-loading { font-size:26rpx; }
.conversation-mode .assistant-name { color:#15181d; font-size:30rpx; font-weight:700; line-height:1.3; }
.conversation-mode .assistant-head { margin-bottom:10rpx; }
.conversation-mode .assistant-body { padding-right:0; }
.conversation-mode .user-bubble { max-width:90%; border-radius:20rpx; background:#1f1f1f; }
/* 复制/分享行不画线：只靠右对齐与留白存在，避免看成表格行边框 */
.conversation-mode .answer-actions { display:flex; align-items:center; justify-content:flex-end; gap:14rpx; margin-top:6rpx; padding:2rpx 0 12rpx; border:0 none; }
.conversation-mode .answer-actions button.action-icon { flex:0 0 auto; width:40rpx; min-width:40rpx; height:44rpx; min-height:44rpx; margin:0; padding:0; border-radius:0; background:transparent; color:#878d95; }
.conversation-mode .answer-actions button.action-icon:active { background:transparent; color:#5a6068; }
.conversation-mode .send-button.active { background:transparent; box-shadow:none; }
.ai-disclaimer { display:block; flex-shrink:0; padding:8rpx 0 0; color:#b9bfc6; font-size:22rpx; line-height:1.4; text-align:center; }
.assistant-content,.assistant-loading { display:block; color:#3e4857; font-size:28rpx; line-height:1.8; white-space:pre-wrap; word-break:break-word; }
.assistant-loading { color:#7b8491; }
/* markdown 渲染（对齐 harness 前端输出呈现） */
.assistant-content { white-space:normal; }
.assistant-content .md-p { margin:0 0 12rpx; }
.assistant-content .md-p:last-child { margin-bottom:0; }
.assistant-content .md-h { margin:16rpx 0 8rpx; color:#1e2228; font-weight:700; line-height:1.5; }
.assistant-content .md-h1 { font-size:36rpx; }
.assistant-content .md-h2 { font-size:33rpx; }
.assistant-content .md-h3,.assistant-content .md-h4 { font-size:30rpx; }
.assistant-content .md-pre { margin:12rpx 0; padding:16rpx 20rpx; border-radius:12rpx; background:#f4f5f6; font-family:Menlo,Consolas,monospace; font-size:24rpx; line-height:1.6; white-space:pre-wrap; word-break:break-all; }
.assistant-content .md-code { padding:2rpx 8rpx; border-radius:6rpx; background:#f0f1f2; font-family:Menlo,Consolas,monospace; font-size:24rpx; }
.assistant-content .md-list { margin:8rpx 0 12rpx; padding-left:36rpx; }
.assistant-content .md-li { margin:4rpx 0; }
.assistant-content .md-quote { margin:10rpx 0; padding-left:16rpx; border-left:4rpx solid #d8dce2; color:#6b7280; }
.assistant-content .md-link { color:#2f6fdd; text-decoration:underline; }
.sources { margin-top:16rpx; padding-top:14rpx; border-top:1rpx solid #edf0f1; }
.source-title { display:block; margin-bottom:8rpx; color:#7b8491; font-size:20rpx; }
.source-card { display:flex; align-items:center; gap:10rpx; min-height:64rpx; padding:8rpx 10rpx; border-radius:12rpx; background:#f7f9fa; color:#667180; }
.source-index { display:flex; align-items:center; justify-content:center; flex:0 0 28rpx; width:28rpx; height:28rpx; border-radius:50%; background:#e5f8ee; color:#079758; font-size:17rpx; }
.source-file { display:block; overflow:hidden; color:#485465; font-size:22rpx; text-overflow:ellipsis; white-space:nowrap; }
.source-page { display:block; margin-top:2rpx; color:#9aa3ad; font-size:19rpx; }
.answer-actions { display:flex; justify-content:flex-end; gap:8rpx; margin-top:10rpx; padding-top:10rpx; border-top:1rpx solid #ededed; }
.answer-actions button { display:flex; align-items:center; justify-content:center; width:44rpx; height:44rpx; min-height:44rpx; border-radius:12rpx; background:#f4f5f6; color:#8e8e8e; }
.answer-actions button:active { background:#eceef0; color:#5a5a5a; }
.chat-footer { position:relative; flex-shrink:0; padding-top:10rpx; }
/* 目录视图的提问入口：与「问AI」首页同一套胶囊输入框，只是入口，不放图标 */
.dir-composer { display:flex; align-items:center; min-height:100rpx; padding:0 34rpx; border-radius:999rpx; background:#fff; box-shadow:0 4rpx 18rpx rgba(24,28,34,.055); }
.dir-composer:active { background:#fafbfb; }
.dir-composer-placeholder { flex:1; min-width:0; overflow:hidden; color:var(--ink-4); font-size:var(--t-body); font-weight:400; line-height:1.4; text-overflow:ellipsis; white-space:nowrap; }
.composer { position:relative; border:1rpx solid var(--line); border-radius:var(--r-xl); background:var(--surface); box-shadow:0 4rpx 18rpx rgba(27,33,30,.06); }
.composer-input { display:block; width:100%; min-height:78rpx; max-height:200rpx; padding:22rpx 28rpx 10rpx; color:var(--ink-1); font-size:var(--t-body); font-weight:400; line-height:1.5; }
.composer-bar { display:flex; align-items:center; gap:12rpx; padding:0 20rpx 16rpx; }
.composer-bar-spacer { flex:1; min-width:0; }
.scope-button { display:flex; align-items:center; justify-content:center; flex:0 0 auto; width:auto; min-width:64rpx; height:64rpx; min-height:64rpx; margin:0; padding:0 6rpx; gap:4rpx; border-radius:var(--r-md); background:transparent; color:var(--brand); line-height:1; }
.scope-icon { display:flex; align-items:center; justify-content:center; flex:0 0 26rpx; width:26rpx; height:26rpx; color:var(--brand); }
.scope-chevron { display:flex; align-items:center; justify-content:center; flex:0 0 12rpx; width:12rpx; height:26rpx; line-height:0; color:var(--brand); }
.model-button { display:flex; align-items:center; max-width:280rpx; gap:8rpx; height:64rpx; min-height:64rpx; padding:0 22rpx; border:0; border-radius:var(--r-pill); background:var(--surface-soft); color:var(--ink-1); font-size:var(--t-meta); font-weight:600; }
.model-button text { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.model-button .model-mode { margin-left:6rpx; color:var(--ink-3); font-weight:400; }
button.send-button, button.send-button[disabled] { display:flex; align-items:center; justify-content:center; position:absolute; right:20rpx; bottom:16rpx; z-index:2; width:52rpx; min-width:52rpx; height:52rpx; min-height:52rpx; padding:0; border-radius:50%; background:transparent; color:#161616; opacity:1; }
button.send-button.active { background:transparent; box-shadow:none; opacity:1; }
button.send-button::after { border:none; background:transparent; }
.conversation-mode .composer { display:flex; flex-direction:column; border-radius:34rpx; }
.conversation-mode .composer-bar { padding:0 20rpx 16rpx; }
.conversation-mode .composer-input { min-height:150rpx; padding:26rpx 28rpx 12rpx; line-height:1.55; }
.conversation-mode .chat-footer { padding:10rpx 24rpx 18rpx; background:#fff; }
.mode-picker { position:absolute; z-index:20; bottom:calc(100% + 12rpx); left:0; width:330rpx; padding:14rpx 16rpx; border:1rpx solid #e9e9e9; border-radius:25rpx; background:#fff; box-shadow:0 12rpx 34rpx rgba(25,30,40,.14); }
.mode-option { display:flex; align-items:center; width:100%; min-height:86rpx; gap:16rpx; padding:8rpx 10rpx; border-radius:18rpx; color:#26272d; font-size:29rpx; text-align:left; }
.mode-option.active { background:#f6f6f6; }
.mode-option-icon { display:flex; align-items:center; justify-content:center; flex:0 0 52rpx; width:52rpx; height:52rpx; border-radius:16rpx; }
.mode-option-icon.web { background:transparent; }
.mode-option-icon.knowledge { background:transparent; }
.mode-option text { flex:1; text-align:left; }
.model-layer { position:fixed; z-index:70; top:0; right:0; bottom:0; left:0; }
/* 提问层（ima 式提问页）：全屏覆盖，顶部导航+问候语+推荐问题，底部输入框 */
.ask-layer { position:fixed; z-index:60; top:0; right:0; bottom:0; left:0; display:flex; flex-direction:column; max-width:750rpx; margin:0 auto; background:var(--bg); }
.ask-body { flex:1; min-height:0; padding:12rpx 28rpx 24rpx; box-sizing:border-box; }
.ask-greeting { display:block; color:var(--ink-1); font-size:var(--t-hero); font-weight:600; line-height:1.55; }
.ask-questions { margin-top:38rpx; }
button.ask-question { display:block; width:100%; margin:0 0 18rpx; padding:24rpx 28rpx; border:0; border-radius:var(--r-lg); background:var(--surface); color:var(--brand-ink); font-size:var(--t-lead); font-weight:500; line-height:1.55; text-align:left; box-shadow:0 2rpx 12rpx rgba(27,33,30,.05); }
button.ask-question:active { background:var(--brand-soft); }
.ask-questions-hint { padding:26rpx 0; color:var(--ink-4); font-size:var(--t-meta); line-height:1.6; text-align:center; }
.ask-footer { flex-shrink:0; padding:10rpx 24rpx calc(12rpx + env(safe-area-inset-bottom)); }
.chat-page .ask-layer .composer { display:flex; flex-direction:column; border-radius:var(--r-xl); }
.chat-page .ask-layer .composer-input { min-height:96rpx; padding:28rpx 28rpx 12rpx; color:var(--ink-1); line-height:1.5; }
.chat-page .ask-layer .composer-bar { position:static; left:auto; top:auto; transform:none; padding:0 20rpx 16rpx; }
.chat-page .ask-layer .model-button { display:flex; }
.chat-page .ask-layer .send-button { right:20rpx; bottom:16rpx; }
.model-mask { position:absolute; top:0; right:0; bottom:0; left:0; background:rgba(27,33,30,.32); }
.model-sheet { position:absolute; right:0; bottom:0; left:0; max-height:62vh; max-width:750rpx; margin:0 auto; padding:16rpx 28rpx calc(30rpx + env(safe-area-inset-bottom)); border-radius:var(--r-xl) var(--r-xl) 0 0; background:var(--surface-soft); box-shadow:0 -12rpx 36rpx rgba(27,33,30,.12); }
.sheet-grabber { width:72rpx; height:9rpx; margin:0 auto 18rpx; border-radius:var(--r-pill); background:#cfd6d0; }
.model-sheet-title { color:var(--ink-1); font-size:var(--t-h2); font-weight:600; line-height:1.35; text-align:center; }
.thinking-card { display:flex; align-items:center; justify-content:space-between; gap:18rpx; min-height:104rpx; margin-top:24rpx; padding:14rpx 28rpx; border-radius:var(--r-lg); background:var(--surface); }
.thinking-copy { display:flex; align-items:center; min-width:0; gap:20rpx; }
.thinking-icon { display:flex; align-items:center; justify-content:center; flex:0 0 40rpx; width:40rpx; height:40rpx; color:var(--ink-1); }
.thinking-title { color:var(--ink-1); font-size:var(--t-body); font-weight:600; line-height:1.25; white-space:nowrap; }
.thinking-switch { display:flex; align-items:center; flex:0 0 auto; min-width:178rpx; height:56rpx; padding:4rpx; border:1rpx solid var(--line); border-radius:var(--r-pill); background:var(--surface-sink); }
button.thinking-tab { flex:1; min-width:84rpx; height:48rpx; min-height:48rpx; border-radius:var(--r-pill); background:transparent; color:var(--ink-4); font-size:var(--t-meta); font-weight:600; line-height:48rpx; }
button.thinking-tab.active { background:var(--surface); color:var(--brand-ink); box-shadow:0 2rpx 8rpx rgba(27,33,30,.08); }
.model-section-title { display:block; margin:36rpx 28rpx 22rpx; color:var(--ink-4); font-size:var(--t-meta); font-weight:600; line-height:1.35; }
.model-list { overflow:hidden; border-radius:var(--r-lg); background:var(--surface); }
.model-row { display:flex; align-items:center; justify-content:space-between; width:100%; min-height:104rpx; padding:0 30rpx; border-bottom:1rpx solid var(--line-soft); text-align:left; }
.model-row:last-child { border-bottom:0; }
.model-row-copy { display:flex; align-items:center; min-width:0; gap:9rpx; }
.model-row-name { overflow:hidden; color:var(--ink-1); font-size:var(--t-body); font-weight:400; line-height:1.35; text-overflow:ellipsis; white-space:nowrap; }
.model-new-badge { flex-shrink:0; min-height:32rpx; padding:0 10rpx; border-radius:var(--r-sm); background:var(--brand-soft); color:var(--brand-ink); font-size:var(--t-micro); font-weight:600; line-height:32rpx; }
.model-check { flex:0 0 auto; margin-left:24rpx; color:var(--brand); font-size:42rpx; font-weight:400; line-height:1; }
.picker-layer { position:fixed; z-index:50; top:0; right:0; bottom:0; left:0; }
.picker-mask { position:absolute; top:0; right:0; bottom:0; left:0; background:rgba(17,25,39,.32); }
.knowledge-sheet { position:absolute; right:0; bottom:0; left:0; height:90vh; padding:18rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); border-radius:var(--r-xl) var(--r-xl) 0 0; background:var(--surface-soft); box-shadow:0 -12rpx 36rpx rgba(27,33,30,.12); }
.picker-head { display:flex; align-items:center; justify-content:space-between; min-height:88rpx; }
.picker-title { color:var(--ink-1); font-size:var(--t-h1); font-weight:600; letter-spacing:0; }
.picker-close { display:flex; align-items:center; justify-content:center; flex:0 0 68rpx; width:68rpx; height:68rpx; min-height:68rpx; border-radius:50%; background:var(--surface-soft); color:var(--ink-2); }
button.picker-market { display:flex; align-items:center; gap:9rpx; min-height:72rpx; padding:6rpx 4rpx 6rpx 10rpx; background:transparent; color:var(--brand-ink); font-size:var(--t-body); font-weight:500; }
.picker-search { margin:14rpx 0 24rpx; min-height:88rpx; border:0; background:var(--surface-soft); }
.picker-search input { height:76rpx; font-size:28rpx; }
.picker-list { height:calc(90vh - 300rpx); }
.picker-group { margin-top:22rpx; padding:4rpx 26rpx; border-radius:24rpx; background:#fff; }
.picker-group-head { display:flex; align-items:center; justify-content:space-between; min-height:96rpx; }
.picker-group-title { display:flex; align-items:center; gap:10rpx; color:#1d2530; font-size:32rpx; font-weight:700; }
.picker-chevron { display:flex; align-items:center; justify-content:center; width:32rpx; height:40rpx; transition:transform .18s ease; transform:rotate(0deg); }
.picker-chevron.collapsed { transform:rotate(-90deg); }
.picker-add { display:flex; align-items:center; justify-content:center; width:60rpx; height:60rpx; min-height:60rpx; background:transparent; color:#3a3f45; }
.picker-item { display:flex; align-items:center; gap:16rpx; min-height:118rpx; padding:12rpx 0; }
.picker-item.selected .picker-name { color:var(--brand-ink); }
.picker-folder { display:flex; align-items:center; justify-content:center; flex:0 0 60rpx; width:60rpx; height:60rpx; overflow:hidden; border-radius:var(--r-md); background:transparent; color:var(--brand); }
.picker-avatar { display:block; width:100%; height:100%; }
.picker-name { display:block; overflow:hidden; color:var(--ink-1); font-size:var(--t-body); font-weight:600; line-height:1.35; text-overflow:ellipsis; white-space:nowrap; }
.picker-meta { display:block; margin-top:5rpx; color:var(--ink-4); font-size:var(--t-meta); line-height:1.35; }
/* 选中项的对号：给一个小圆底，让选中状态一眼可见，但不加任何多余装饰 */
.picker-check { display:flex; align-items:center; justify-content:center; flex:0 0 44rpx; width:44rpx; height:44rpx; border-radius:50%; background:var(--brand-soft); }
.picker-empty { padding:70rpx 0; color:#98a1ab; font-size:26rpx; text-align:center; }
.picker-empty-row { min-height:80rpx; padding:8rpx 0 30rpx; color:#a0a8b2; font-size:27rpx; }
.picker-discover { position:relative; display:flex; align-items:center; min-height:168rpx; margin:18rpx 0 28rpx; padding:24rpx 28rpx; overflow:hidden; border-radius:18rpx; background:#eaf8f1; }
.picker-discover:active { opacity:.82; }
.picker-discover-copy { position:relative; z-index:2; flex:0 1 62%; min-width:0; }
.picker-discover-title { display:block; color:#0b9859; font-size:31rpx; font-weight:650; line-height:1.35; }
.picker-discover-desc { display:block; margin-top:8rpx; color:#7ca88f; font-size:22rpx; line-height:1.45; }
.picker-discover-art { position:absolute; right:22rpx; bottom:-10rpx; width:156rpx; height:112rpx; }
.picker-discover-sheet { position:absolute; width:82rpx; height:102rpx; border:5rpx solid #fff; border-radius:12rpx; background:#dff3e8; box-shadow:0 4rpx 12rpx rgba(21,110,68,.08); }
.picker-discover-sheet.back { right:46rpx; top:16rpx; transform:rotate(-14deg); background:#cfeadc; }
.picker-discover-sheet.front { right:10rpx; top:4rpx; transform:rotate(8deg); background:#fff; }
/* 两个链接挨着居中：button 自带 auto 左右外边距，在 flex 里会被撑开，必须清零 */
.picker-footer { display:flex; align-items:center; justify-content:center; margin:40rpx 0 20rpx; font-size:25rpx; line-height:1.5; }
/* 必须把 width 钉死：微信 v2 基础样式里的 wx-button:not([size="mini"]){width:184px}
   优先级是 (0,2,1)，会把两个链接各撞成 184px 宽，看着就是「离得很远」。 */
.picker-footer button { display:inline-block; width:auto !important; min-width:0 !important; margin:0 !important; min-height:40rpx; padding:0 6rpx; background:transparent; color:#8d959d; font-size:25rpx; font-weight:400; line-height:40rpx; }
.picker-footer button::after { border:0; }
.picker-footer button:active { color:#079758; }
.picker-footer-dot { margin:0 10rpx; color:#c9cfd5; font-size:24rpx; }

/* 好友共享过来的知识库：标题后跟一个小标签，一眼看出它是只读镜像而不是自己的库 */
.library-title-wrap .library-tag { flex:0 0 auto; margin-left:2rpx; padding:2rpx 10rpx; border-radius:8rpx; background:#eef3f0; color:#079758; font-size:20rpx; font-weight:600; letter-spacing:0; }
.picker-badge { flex:0 0 auto; padding:2rpx 10rpx; border-radius:8rpx; background:#f1f3f5; color:#7c858e; font-size:21rpx; font-weight:500; }

/* 邀请好友一起用：底部小面板，不画分隔线，靠白块与浅底分层 */
.share-kb-sheet { position:absolute; right:0; bottom:0; left:0; padding:18rpx 34rpx calc(24rpx + env(safe-area-inset-bottom)); border-radius:28rpx 28rpx 0 0; background:#f7f7f7; box-shadow:0 -10rpx 30rpx rgba(25,30,40,.12); }
.share-kb-card { display:flex; align-items:center; gap:18rpx; margin-top:14rpx; padding:22rpx 24rpx; border-radius:22rpx; background:#fff; }
.share-kb-icon { display:flex; align-items:center; justify-content:center; flex:0 0 72rpx; width:72rpx; height:72rpx; border-radius:22rpx; background:#f2f6f3; }
.share-kb-copy { flex:1; min-width:0; }
.share-kb-name { display:block; overflow:hidden; color:#1f2227; font-size:32rpx; font-weight:650; line-height:1.35; text-overflow:ellipsis; white-space:nowrap; }
.share-kb-meta { display:block; margin-top:4rpx; color:#98a1ab; font-size:23rpx; line-height:1.4; }
.share-kb-notes { margin-top:16rpx; padding:0 6rpx; }
.share-kb-note { display:flex; align-items:center; gap:12rpx; padding:7rpx 0; color:#4c545c; font-size:26rpx; line-height:1.5; }
.share-kb-note text { flex:1; min-width:0; }
button.share-kb-cta { display:flex; align-items:center; justify-content:center; gap:12rpx; width:100% !important; min-width:0 !important; min-height:96rpx; margin:26rpx 0 0; padding:0 30rpx; border:0; border-radius:999rpx; background:#079758; color:#fff; font-size:31rpx; font-weight:600; }
button.share-kb-cta::after { border:0; }
button.share-kb-cta:active { opacity:.88; }
button.share-kb-cancel { display:block; width:100% !important; min-width:0 !important; min-height:76rpx; margin:6rpx 0 0; padding:0; border:0; background:transparent; color:#8b9096; font-size:27rpx; font-weight:400; line-height:76rpx; }
button.share-kb-cancel::after { border:0; }
.upload-layer { position:fixed; z-index:80; top:0; right:0; bottom:0; left:0; }
.upload-mask { position:absolute; top:0; right:0; bottom:0; left:0; background:rgba(20,24,30,.28); }
.upload-sheet { position:absolute; right:0; bottom:0; left:0; padding:30rpx 48rpx calc(20rpx + env(safe-area-inset-bottom)); border-radius:32rpx 32rpx 0 0; background:#fff; box-shadow:0 -12rpx 36rpx rgba(24,31,40,.12); }
.upload-usage { display:flex; align-items:center; justify-content:space-between; min-height:48rpx; }
.upload-usage-text { color:#969696; font-size:27rpx; font-weight:500; }
button.upload-upgrade { display:flex; align-items:center; gap:8rpx; min-height:48rpx; background:transparent; color:#00a05a; font-size:27rpx; font-weight:600; }
.upload-dot { display:block; width:12rpx; height:12rpx; border-radius:50%; background:#ff3c43; }
.upload-divider { height:1rpx; margin:14rpx 0 38rpx; background:#ededed; }
.upload-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); column-gap:30rpx; row-gap:36rpx; }
.upload-option { display:flex; flex-direction:column; align-items:center; min-width:0; color:#8d8d8d; font-size:23rpx; font-weight:500; line-height:1.35; }
.upload-option-icon { display:flex; align-items:center; justify-content:center; width:120rpx; height:120rpx; margin-bottom:14rpx; border-radius:20rpx; background:transparent; color:#626262; }
.upload-option text { overflow:hidden; max-width:100%; text-overflow:ellipsis; white-space:nowrap; }
button.upload-cancel { width:calc(100% + 96rpx); min-height:92rpx; margin:44rpx -48rpx 0; border-top:1rpx solid #ededed; background:#fff; color:#2a2a2a; font-size:30rpx; font-weight:650; }
/* 隐私指引入口：放在上传选项和取消之间，小字、不抢视觉，但确实可点 */
.privacy-line { margin-top:30rpx; color:#98a1ab; font-size:21rpx; font-weight:400; line-height:1.6; text-align:center; }
.privacy-line:active { opacity:0.6; }
.article-sheet { padding-top:48rpx; }
.article-sheet-title { display:block; font-size:34rpx; font-weight:700; color:#1d2530; text-align:center; }
.article-sheet-desc { display:block; margin-top:14rpx; font-size:var(--t-meta); color:var(--ink-3); line-height:1.6; text-align:center; }
.article-input-wrap { display:flex; align-items:center; gap:8rpx; margin-top:32rpx; height:88rpx; padding:0 12rpx 0 28rpx; border-radius:44rpx; background:#f2f3f4; }
.article-input { flex:1; min-width:0; height:88rpx; font-size:27rpx; color:#23262b; }
.article-clear { display:flex; align-items:center; justify-content:center; flex:0 0 56rpx; width:56rpx; height:56rpx; min-height:56rpx; border-radius:50%; background:#dfe1e3; color:#7d8793; }
button.article-submit { display:flex; align-items:center; justify-content:center; width:100%; min-height:88rpx; margin:26rpx 0 0; padding:0; border:0; border-radius:44rpx; background:#d0d0d0; color:#fff; font-size:30rpx; font-weight:650; }
button.article-submit.active { background:var(--brand-deep); color:#fff; }
.article-sheet .upload-cancel { margin-top:28rpx; }
.directory-folder-head { display:flex; align-items:center; gap:20rpx; min-height:136rpx; padding:18rpx 8rpx; }
.directory-folder-icon { display:flex; align-items:center; justify-content:center; flex:0 0 92rpx; width:92rpx; min-width:92rpx; height:104rpx; }
.directory-folder-copy { flex:1; min-width:0; }
/* line-height 必须显式声明：.dir-swipe-row 把行高归零，漏写就会被裁没 */
.directory-folder-name { display:block; flex:0 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:32rpx; font-weight:600; line-height:1.35; color:#20242b; }
.directory-folder-meta { display:block; margin-top:7rpx; color:var(--ink-4); font-size:var(--t-micro); line-height:1.3; }
.directory-folder-chevron { display:flex; align-items:center; color:var(--ink-4); }
/* 面包屑导航：知识库名 › 文件夹名（对齐 ima 文件夹内页头） */
.dir-breadcrumb { display:flex; align-items:center; gap:10rpx; padding:6rpx 8rpx 20rpx; }
.crumb-link { color:var(--ink-4); font-size:var(--t-body); font-weight:400; line-height:1.4; }
.crumb-sep { color:var(--ink-4); font-size:var(--t-body); line-height:1.4; }
.crumb-current { color:var(--ink-1); font-size:var(--t-body); font-weight:600; line-height:1.4; }
.dir-empty-hint { padding:60rpx 0; color:var(--ink-4); font-size:var(--t-meta); line-height:1.6; text-align:center; }
@media (max-width:340px) { button.library-title-wrap { font-size:32rpx; max-width:calc(100% - 220rpx); } .library-title-wrap text { font-size:32rpx; } .toolbar-actions { gap:10rpx; } button.toolbar-button { flex-basis:54rpx; width:54rpx; min-width:54rpx; height:54rpx; min-height:54rpx; } .library-switch { flex-basis:38rpx; width:38rpx; min-width:38rpx; height:38rpx; min-height:38rpx; } .directory-item { gap:10rpx; padding-left:12rpx; padding-right:12rpx; } .directory-file-icon { flex-basis:76rpx; width:76rpx; min-width:76rpx; height:86rpx; } .scope-button { flex-basis:76rpx; width:76rpx; } .mode-picker { width:300rpx; } .model-sheet { padding-left:20rpx; padding-right:20rpx; } .thinking-card { padding-left:22rpx; padding-right:22rpx; } .thinking-title,.model-row-name { font-size:27rpx; } .thinking-switch { min-width:164rpx; } .thinking-tab { min-width:76rpx; font-size:21rpx; } }
.upload-knowledge-icon { background:transparent; }
