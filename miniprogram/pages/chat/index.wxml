<view class="page chat-page {{conversationActive ? 'conversation-mode' : ''}}{{!conversationActive && currentFolderId ? ' folder-mode' : ''}}" style="{{shellStyle}}">
  <view wx:if="{{conversationActive}}" class="qa-nav" style="height:{{navHeight}}px;">
    <button class="qa-back" bindtap="leaveConversation" aria-label="返回"><ui-icon name="back" size="{{36}}" rpx /></button>
    <button class="qa-history" bindtap="openHistory" aria-label="历史对话"><ui-icon name="menu" size="{{41}}" rpx /></button>
    <view class="qa-context"><text class="qa-context-title">{{knowledgeName || '微信用户的知识库'}}</text></view>
  </view>
  <app-nav wx:else title="cola知识库" center />
  <view wx:if="{{!conversationActive}}" class="library-toolbar">
    <button class="library-title-wrap" bindtap="openKnowledgePicker" disabled="{{sending}}" aria-label="切换知识库">
      <text>{{knowledgeName || '微信用户的知识库'}}</text>
      <text wx:if="{{knowledgeReadOnly}}" class="library-tag">{{knowledgeSourceMissing ? '已失效' : '共享'}}</text>
      <view class="library-switch"><ui-icon name="chevron-down" size="{{30}}" rpx /></view>
    </button>
    <view class="toolbar-actions">
      <button class="toolbar-button" bindtap="goSearch" disabled="{{loadState !== 'guest' && !knowledgeId}}" aria-label="搜索知识库"><ui-icon name="search" size="{{38}}" rpx /></button>
      <!-- 好友共享过来的库是只读的：不摆上传入口，避免点了才知道不能写 -->
      <button wx:if="{{!knowledgeReadOnly}}" class="toolbar-button add-button" bindtap="openUpload" disabled="{{sending || (loadState !== 'guest' && !knowledgeId)}}" aria-label="导入文件"><ui-icon name="upload" size="{{38}}" rpx /></button>
      <button class="toolbar-button" bindtap="openKnowledgeActions" disabled="{{sending || (loadState !== 'guest' && !knowledgeId)}}" aria-label="知识库管理"><ui-icon name="menu" size="{{38}}" rpx /></button>
    </view>
  </view>
  <view wx:if="{{!conversationActive && knowledgeDesc}}" class="library-desc">{{knowledgeDesc}}</view>
  <!-- 来源知识库被删掉时，共享库会保留但内容停止同步，这里直说不会让人以为是网络问题 -->
  <view wx:if="{{!conversationActive && knowledgeSourceMissing}}" class="library-desc">来源知识库已被删除，这个共享库已停止同步</view>
  <scroll-view class="messages" scroll-y scroll-with-animation enhanced show-scrollbar="{{false}}" scroll-into-view="{{lastMessageId}}">
    <view wx:if="{{loadState === 'error'}}" class="state-panel">
      <view class="state-icon"><ui-icon name="response" size="{{28}}" /></view>
      <text class="state-title">暂时无法连接资料</text>
      <text class="state-desc">登录或网络暂不可用，请稍后重试。</text>
      <button class="outline-button" bindtap="load">重新加载</button>
    </view>
    <view wx:elif="{{loadState === 'ready' && !knowledgeId}}" class="state-panel">
      <view class="state-icon"><ui-icon name="folder" size="{{28}}" /></view>
      <text class="state-title">先建立一个资料空间</text>
      <text class="state-desc">创建资料库并上传文档，回答才会有可追溯的出处。</text>
      <button class="dark-button" bindtap="create">创建资料库</button>
    </view>
    <view wx:elif="{{!messages.length && knowledgeId}}" class="welcome {{!conversationActive && (documents.length || folders.length) ? 'with-directory' : ''}}">
      <view wx:if="{{!conversationActive && documentsLoading}}" class="directory-state">
        <view class="directory-skeleton"></view>
        <view class="directory-skeleton short"></view>
      </view>
      <view wx:elif="{{!conversationActive && documentsError}}" class="directory-state">
        <view class="directory-state-icon"><ui-icon name="folder" size="{{28}}" /></view>
        <text>目录加载失败</text>
        <button class="directory-retry" bindtap="retryDirectory" data-id="{{knowledgeId}}">重新加载</button>
      </view>
      <view wx:elif="{{!conversationActive && (documents.length || folders.length)}}" class="directory-panel">
        <!-- 进入文件夹后的路径面包屑：点知识库名退回根目录，右侧是当前文件夹 -->
        <view wx:if="{{currentFolderId}}" class="dir-crumb">
          <button class="dir-crumb-root" bindtap="exitFolder" aria-label="返回知识库根目录"><text>{{knowledgeName || '微信用户的知识库'}}</text></button>
          <view class="dir-crumb-sep"><ui-icon name="chevron-right" size="{{19}}" rpx /></view>
          <text class="dir-crumb-current">{{currentFolderName}}</text>
        </view>
        <view class="directory-list">
          <block wx:if="{{!currentFolderId}}">
            <block wx:for="{{documentGroups}}" wx:key="key" wx:for-item="group">
              <view wx:if="{{group.key}}" class="dir-swipe-row {{group.swipeX ? 'swiped' : ''}}">
                <view class="dir-actions">
                  <button class="dir-action pin-action {{group.pinned ? 'is-on' : ''}}" catchtap="pinFolder" data-key="{{group.key}}">{{group.pinned ? '取消置顶' : '置顶'}}</button>
                  <button class="dir-action delete-action" catchtap="confirmDeleteFolder" data-key="{{group.key}}" data-name="{{group.name}}">删除</button>
                </view>
                <view class="directory-folder-head dir-swipe-card" style="transform:translateX({{group.swipeX || 0}}rpx);" bindtap="enterFolder" data-key="{{group.key}}" bindtouchstart="onDirTouchStart" bindtouchmove="onDirTouchMove" bindtouchend="onDirTouchEnd" data-rowtype="folder" data-rowkey="{{group.key}}">
                  <view class="directory-folder-icon"><ui-icon name="folder-green" size="{{84}}" rpx /></view>
                  <view class="directory-folder-copy">
                    <view class="directory-file-name-row">
                      <text wx:if="{{group.pinned}}" class="pin-badge">置顶</text>
                      <text class="directory-folder-name">{{group.name}}</text>
                    </view>
                    <text class="directory-folder-meta">{{group.documents.length}} 个项目</text>
                  </view>
                  <view class="directory-folder-chevron"><ui-icon name="chevron-right" size="{{15}}" /></view>
                </view>
              </view>
            </block>
          </block>
          <view wx:for="{{visibleDocuments}}" wx:key="id" wx:for-item="item" class="dir-swipe-row {{item.swipeX ? 'swiped' : ''}}">
            <view class="dir-actions">
              <button class="dir-action pin-action {{item.pinned ? 'is-on' : ''}}" catchtap="pinDocument" data-id="{{item.id}}">{{item.pinned ? '取消置顶' : '置顶'}}</button>
              <button class="dir-action delete-action" catchtap="confirmDeleteDocument" data-id="{{item.id}}" data-name="{{item.filename}}">删除</button>
            </view>
            <view class="directory-item dir-swipe-card" style="transform:translateX({{item.swipeX || 0}}rpx);" bindtap="openDocument" data-id="{{item.id}}" bindlongpress="showDocumentActions" data-id="{{item.id}}" bindtouchstart="onDirTouchStart" bindtouchmove="onDirTouchMove" bindtouchend="onDirTouchEnd" data-rowtype="doc" data-rowkey="{{item.id}}">
              <view class="directory-file-icon thumb-fallback">
                <ui-icon name="file" size="{{30}}" rpx />
              </view>
              <view class="directory-file-copy">
                <view class="directory-file-name-row">
                  <text wx:if="{{item.pinned}}" class="pin-badge">置顶</text>
                  <text class="directory-file-name">{{item.filename}}</text>
                </view>
                <view class="directory-file-meta">
                  <ui-icon wx:if="{{item.typeKind === 'image'}}" name="image-blue" size="{{24}}" />
                  <text class="directory-file-type {{item.typeKind === 'pdf' ? 'type-pdf' : ''}}">{{item.typeLabel}}</text>
                  <text class="directory-meta-sep">|</text>
                  <text wx:if="{{item.status === 'completed'}}">{{item.displayTime}}</text>
                  <text wx:else class="directory-status-text {{item.status}}">{{item.status === 'failed' ? '解析失败' : '解析中'}}</text>
                </view>
              </view>
            </view>
          </view>
          <view wx:if="{{currentFolderId && !visibleDocuments.length}}" class="dir-empty-hint">这个文件夹还是空的，长按文件可以移动进来</view>
        </view>
      </view>
      <view wx:else class="empty-knowledge">
        <image class="empty-illustration" src="/assets/brand/cola-empty-knowledge.png" mode="aspectFit" />
        <text class="empty-title">构建你的专属知识库</text>
        <button class="empty-import" bindtap="openUpload"><ui-icon name="upload" size="{{24}}" /><text>导入文件</text></button>
      </view>
    </view>
    <!-- 消息渲染与「问AI」问答页完全一致（含 harness 过程区），只复用 thread.wxss 里的 qa-* 样式 -->
    <block wx:for="{{messages}}" wx:key="id">
      <view id="{{item.id}}" class="qa-message {{item.role}} {{pickMode ? 'picking' : ''}}" bindlongpress="enterPick" data-key="msg:{{item.id}}">
        <view wx:if="{{pickMode && item.content && !item.greeting && !item.local}}" class="qa-pick {{pickedMap['msg:' + item.id] ? 'on' : ''}}" catchtap="togglePickItem" data-key="msg:{{item.id}}"><ui-icon wx:if="{{pickedMap['msg:' + item.id]}}" name="dui" size="{{26}}" rpx /></view>
        <view wx:if="{{item.role === 'user'}}" class="qa-user-bubble">{{item.content}}</view>
        <!-- 开场白：头像 + 招呼 + 当前范围（本地消息，不写入历史） -->
        <view wx:elif="{{item.greeting}}" class="qa-hello">
          <image class="qa-hello-avatar" src="/assets/brand/cola-avatar.png" mode="aspectFit" />
          <view class="qa-hello-copy">
            <text class="qa-hello-title">{{item.title}}</text>
            <text class="qa-hello-desc">{{item.desc}}</text>
          </view>
        </view>
        <view wx:else class="qa-answer">
          <!-- 思维链折叠成一行摘要（点开才看全文）；执行步骤独立成一区、始终可见 -->
          <view wx:if="{{item.reason}}" class="qa-trace">
            <view class="qa-trace-head {{item.running ? 'live' : ''}}" bindtap="toggleTrace" data-id="{{item.id}}">
              <view class="qa-trace-icon"><ui-icon name="{{item.traceIcon || 'dengpao'}}" size="{{30}}" rpx /></view>
              <text class="qa-trace-title">{{item.traceTitle || '思考中'}}</text>
              <text wx:if="{{item.traceSummary}}" class="qa-trace-summary">{{item.traceSummary}}</text>
              <view wx:else class="qa-trace-spacer"></view>
              <text wx:if="{{item.traceElapsed}}" class="qa-trace-elapsed">{{item.traceElapsed}}</text>
              <view class="qa-trace-chevron"><ui-icon name="{{item.reasonOpen ? 'chevron-up' : 'chevron-down'}}" size="{{22}}" rpx /></view>
            </view>
            <view wx:if="{{item.reasonOpen}}" class="qa-trace-body">
              <text class="qa-reason">{{item.reason}}</text>
            </view>
          </view>
          <view wx:if="{{item.trace.length}}" class="qa-process">
            <block wx:for="{{item.trace}}" wx:for-item="node" wx:key="key">
              <tool-card wx:if="{{node.kind === 'tool'}}" node="{{node}}" />
              <view wx:else class="qa-node {{node.kind}} {{node.state}} {{node.depth ? 'nested' : ''}}">
                <view class="qa-node-icon"><ui-icon name="{{node.icon || 'atom'}}" size="{{28}}" rpx /></view>
                <view class="qa-node-copy">
                  <text class="qa-node-title">{{node.title}}</text>
                  <text wx:if="{{node.detail}}" class="qa-node-detail">{{node.detail}}</text>
                </view>
                <text wx:if="{{node.stateLabel}}" class="qa-node-state {{node.state}}">{{node.stateLabel}}</text>
              </view>
            </block>
          </view>
          <plan-card wx:if="{{item.planNode}}" node="{{item.planNode}}" message-id="{{item.id}}" open="{{item.planOpen}}" bind:review="onPlanReview" bind:toggle="onPlanToggle" />
          <view wx:if="{{!item.content && !item.trace.length && !item.reason}}" class="qa-progress">
            <view class="qa-progress-icon"><ui-icon name="dengpao" size="{{26}}" rpx /></view>
            <text class="qa-progress-text">{{item.progress || '正在思考…'}}</text>
          </view>
          <markdown-view wx:if="{{item.content}}" source="{{item.content}}" streaming="{{item.running}}" />
          <!-- 生成的文件：agent 本轮真的写出来的文件。点卡片预览，右侧按钮保存到微信 -->
          <view wx:if="{{item.artifacts.length}}" class="qa-files">
            <text class="qa-files-title">生成的文件 · {{item.artifacts.length}}</text>
            <view wx:for="{{item.artifacts}}" wx:for-item="file" wx:key="id" class="qa-file {{pickedMap['file:' + file.id] ? 'picked' : ''}}" hover-class="qa-file-hover" hover-stay-time="60" bindtap="onFileTap" data-id="{{file.id}}">
              <view wx:if="{{pickMode}}" class="qa-pick inline {{pickedMap['file:' + file.id] ? 'on' : ''}}"><ui-icon wx:if="{{pickedMap['file:' + file.id]}}" name="dui" size="{{24}}" rpx /></view>
              <view class="qa-file-icon"><ui-icon name="{{file.icon || 'recent-text'}}" size="{{52}}" rpx /></view>
              <view class="qa-file-copy">
                <text class="qa-file-name">{{file.name}}</text>
                <text class="qa-file-meta">{{file.meta}}</text>
              </view>
              <button wx:if="{{!pickMode}}" class="qa-file-save" catchtap="saveArtifact" data-id="{{file.id}}" aria-label="保存到微信"><ui-icon name="download" size="{{30}}" rpx /></button>
            </view>
          </view>
          <!-- 参考出处默认收起：只露一行标题，点一下才展开文件列表 -->
          <view wx:if="{{item.sources.length}}" class="qa-sources {{item.sourcesOpen ? 'qa-sources-open' : ''}}">
            <view class="qa-source-head" bindtap="toggleSources" data-key="{{item.id}}">
              <text class="qa-source-title">参考出处 · {{item.sources.length}} 条</text>
              <view class="qa-source-arrow"><ui-icon name="chevron-down" size="{{20}}" rpx /></view>
            </view>
            <view wx:if="{{item.sourcesOpen}}" class="qa-source-list">
              <view wx:for="{{item.sources}}" wx:for-item="source" wx:key="id" class="qa-source" bindtap="openSource" data-id="{{source.document_id || source.id}}" data-url="{{source.url || ''}}">
                <view class="qa-source-icon"><ui-icon name="{{source.iconName || 'recent-text'}}" size="{{34}}" rpx /></view>
                <view class="qa-source-copy">
                  <text class="qa-source-file">{{source.filename}}</text>
                  <text class="qa-source-page">{{source.url ? '公开网页 · 点击复制链接' : '第 ' + source.page_number + ' 页'}}</text>
                </view>
              </view>
            </view>
          </view>
          <text wx:if="{{item.content && !item.local}}" class="qa-ai-note">内容由 AI 生成，请自行核实重要信息</text>
          <view wx:if="{{item.content && !item.local}}" class="qa-answer-actions">
            <button class="qa-action" bindtap="copyAnswer" data-content="{{item.content}}" aria-label="复制回答"><ui-icon name="copy" size="{{18}}" />复制</button>
            <button class="qa-action" open-type="share" data-id="{{item.id}}" aria-label="分享给微信好友"><ui-icon name="share" size="{{18}}" />分享</button>
          </view>
        </view>
      </view>
    </block>
    <!-- 开场之后紧跟问答提示：与知识库 / 文件夹会话一致 -->
    <view wx:if="{{conversationActive && !sending && messages.length === 1 && messages[0].greeting && suggestions.length}}" class="qa-prompts">
      <text class="qa-prompts-title">你可以这样问</text>
      <button wx:for="{{suggestions}}" wx:key="*this" class="qa-prompt" bindtap="pickPrompt" data-text="{{item}}">{{item}}</button>
    </view>
    <view wx:elif="{{conversationActive && !sending && messages.length === 1 && messages[0].greeting && suggestionsLoading}}" class="qa-prompts">
      <text class="qa-prompts-hint">正在根据这个知识库的资料生成提问建议…</text>
    </view>
  </scroll-view>
  <view wx:if="{{!pickMode}}" class="chat-footer">
    <!-- 目录视图的提问入口：和问AI首页同款胶囊输入框，点一下才进问答页，
         这里只是入口，不放任何切换 / 发送图标 -->
    <view wx:if="{{!conversationActive && !askLayerVisible && knowledgeId && loadState === 'ready'}}" class="dir-composer" bindtap="openDirectoryAsk">
      <text class="dir-composer-placeholder">{{currentFolderId ? '基于本文件夹提问' : '基于知识库提问'}}</text>
    </view>
    <view wx:if="{{conversationActive}}" class="qa-composer">
      <!-- 选中的技能不显示在对话里：技能图标线条变蓝即表示本轮已启用 -->
      <textarea class="qa-input" value="{{input}}" placeholder="{{askMode === 'web' ? '向全网提问' : '基于知识库提问'}}" placeholder-style="color:#8f978f;font-size:32rpx;line-height:1.5;" auto-height maxlength="8000" adjust-position="{{false}}" show-confirm-bar="{{false}}" bindkeyboardheightchange="onKeyboardHeightChange" bindblur="onKeyboardBlur" bindinput="onInput" bindconfirm="send" confirm-type="send" disabled="{{loadState !== 'ready'}}"></textarea>
      <view class="qa-bar">
        <button class="qa-logic {{askMode === 'web' ? 'planner' : 'knowledge'}}" bindtap="toggleAskLogic" aria-label="切换问答逻辑">
          <ui-icon name="{{askMode === 'web' ? 'robot-planner' : 'robot-knowledge'}}" size="{{34}}" rpx />
          <ui-icon name="chevron-down" size="{{16}}" rpx />
        </button>
        <button class="qa-skill" bindtap="openSkillSheet" disabled="{{sending}}" aria-label="技能">
          <ui-icon name="{{selectedSkillIds.length ? 'skill-blue' : 'skill'}}" size="{{34}}" rpx />
          <ui-icon name="chevron-down" size="{{15}}" rpx />
        </button>
        <button class="qa-scope" bindtap="openKnowledgePicker" disabled="{{sending}}" aria-label="选择知识库">
          <ui-icon name="{{askMode === 'web' ? 'at' : 'knowledge-pick'}}" size="{{30}}" rpx />
        </button>
        <view class="qa-bar-spacer"></view>
        <button class="qa-model" bindtap="chooseModel" disabled="{{sending}}" aria-label="模型与思考深度"><ui-icon name="model-depth" size="{{34}}" rpx /></button>
        <button wx:if="{{sending}}" class="qa-send" bindtap="stopSend" aria-label="停止"><ui-icon name="stop" size="{{58}}" rpx /></button>
        <button wx:else class="qa-send" bindtap="send" disabled="{{!canSend}}" aria-label="发送"><ui-icon name="{{canSend ? 'send-ready' : 'send-idle'}}" size="{{58}}" rpx /></button>
      </view>
    </view>
  </view>
  <pick-bar wx:if="{{pickMode}}" count="{{pickCount}}" total="{{pickTotal}}" bind:close="exitPick" bind:all="togglePickAll" bind:share="openShareSheet" />
  <share-sheet visible="{{shareSheetVisible}}" message-count="{{pickMessageCount}}" file-count="{{pickFileCount}}" knowledges="{{shareKnowledges}}" knowledge-loading="{{shareKnowledgeLoading}}" hint="{{shareHintText}}" bind:close="closeShareSheet" bind:wechat="armShareWechat" bind:copy="shareCopy" bind:knowledgeopen="loadShareKnowledges" bind:knowledgepick="saveShareToKnowledge" />
  <view wx:if="{{askLayerVisible}}" class="ask-layer" style="bottom:{{keyboardHeight}}px;">
    <app-nav conversation back title="{{knowledgeName || '微信用户的知识库'}}" bind:conversationback="closeAskLayer" />
    <scroll-view class="ask-body" scroll-y enhanced show-scrollbar="{{false}}">
      <text class="ask-greeting">{{askGreeting}}</text>
      <view wx:if="{{askMode === 'knowledge'}}" class="ask-questions">
        <button wx:for="{{suggestions}}" wx:key="index" class="ask-question" bindtap="chooseSuggestion" data-index="{{index}}">{{item}}</button>
        <view wx:if="{{suggestionsLoading && !suggestions.length}}" class="ask-questions-hint">正在生成推荐问题…</view>
        <view wx:elif="{{!suggestions.length && !suggestionsLoading}}" class="ask-questions-hint">导入文档后，这里会出现推荐问题</view>
      </view>
    </scroll-view>
    <view class="ask-footer">
      <view class="composer ask-composer">
        <view wx:if="{{modePickerVisible}}" class="mode-picker">
          <button class="mode-option {{askMode === 'web' ? 'active' : ''}}" bindtap="selectAskMode" data-mode="web">
            <view class="mode-option-icon web"><ui-icon name="web" size="{{24}}" /></view>
            <text>问全网</text>
          </button>
          <button class="mode-option {{askMode === 'knowledge' ? 'active' : ''}}" bindtap="selectAskMode" data-mode="knowledge" disabled="{{!knowledgeId}}">
            <view class="mode-option-icon knowledge"><ui-icon name="knowledge-mode" size="{{22}}" /></view>
            <text>问知识库</text>
          </button>
        </view>
        <textarea class="composer-input" value="{{input}}" placeholder="{{askMode === 'web' ? '向全网提问' : '基于知识库提问'}}" placeholder-style="color:#8f978f;font-size:32rpx;" focus="{{askFocus}}" auto-height maxlength="8000" bindinput="onInput" bindconfirm="sendFromAsk" confirm-type="send" adjust-position="{{false}}" show-confirm-bar="{{false}}" bindkeyboardheightchange="onKeyboardHeightChange" bindblur="onKeyboardBlur"></textarea>
        <view class="composer-bar">
          <button class="scope-button" bindtap="toggleModePicker" disabled="{{sending}}" aria-label="选择提问范围">
            <ui-icon name="{{askMode === 'web' ? 'web' : 'knowledge-mode'}}" size="{{26}}" rpx />
            <ui-icon name="chevron-down" size="{{16}}" rpx />
          </button>
          <button class="model-button" bindtap="chooseModel" disabled="{{sending}}">
            <text>{{modelShortLabel}} <text class="model-mode">{{thinkingMode === 'deep' ? '深度' : '快速'}}</text></text>
            <ui-icon name="chevron-down" size="{{11}}" />
          </button>
          <view class="composer-bar-spacer"></view>
        </view>
        <button wx:if="{{sending}}" class="send-button active" bindtap="stopSend" aria-label="停止"><ui-icon name="stop" size="{{52}}" rpx /></button>
        <button wx:else class="send-button" bindtap="sendFromAsk" disabled="{{!canSend}}" aria-label="发送"><ui-icon name="{{canSend ? 'send-ready' : 'send-idle'}}" size="{{52}}" rpx /></button>
      </view>
    </view>
  </view>
  <!-- 更多选项：和问AI问答页一致，只保留一个深度思考 -->
  <view wx:if="{{modelPickerVisible}}" class="sheet-layer">
    <view class="sheet-mask" bindtap="closeModelPicker"></view>
    <view class="sheet-panel option-panel" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">更多选项</text>
        <button class="sheet-close" bindtap="closeModelPicker" aria-label="关闭"><ui-icon name="close" size="{{28}}" rpx /></button>
      </view>
      <view class="option-card" bindtap="toggleDeepThinking">
        <view class="option-icon"><ui-icon name="atom" size="{{52}}" rpx /></view>
        <view class="option-copy">
          <text class="option-name">深度思考</text>
          <text class="option-desc">输出思考过程并回答</text>
        </view>
        <text class="option-pill {{thinkingMode === 'deep' ? 'on' : ''}}">{{thinkingMode === 'deep' ? '自动' : '已关闭'}}</text>
      </view>
    </view>
  </view>
  <view wx:if="{{pickerVisible}}" class="picker-layer">
    <view class="picker-mask" bindtap="closeKnowledgePicker"></view>
    <view class="knowledge-sheet">
      <view class="picker-head"><button class="picker-close" bindtap="closeKnowledgePicker" aria-label="关闭"><ui-icon name="close" size="{{48}}" rpx /></button><text class="picker-title">{{importMode ? '请选择要上传的目标知识库' : '选择知识库'}}</text><button class="picker-market" bindtap="openDiscover"><ui-icon name="compass" size="{{40}}" rpx /><text>发现</text></button></view>
      <view class="search-bar picker-search"><ui-icon name="search" size="{{40}}" rpx /><input value="{{pickerQuery}}" placeholder="搜索知识库" bindinput="filterPicker" /></view>
      <scroll-view class="picker-list" scroll-y>
        <view class="picker-group">
          <view class="picker-group-head"><view class="picker-group-title" data-group="personal" bindtap="togglePickerGroup"><text>个人知识库</text><view class="picker-chevron {{personalExpanded ? '' : 'collapsed'}}"><ui-icon name="chevron-down" size="{{28}}" rpx /></view></view><button class="picker-add" catchtap="createFromPicker" aria-label="创建知识库"><ui-icon name="plus" size="{{42}}" rpx /></button></view>
          <view wx:if="{{personalExpanded}}">
            <view wx:for="{{filteredKnowledge}}" wx:key="id" class="picker-item {{item.id === knowledgeId ? 'selected' : ''}}" bindtap="selectKnowledge" data-id="{{item.id}}"><view class="picker-folder"><image wx:if="{{item.avatarUrl}}" class="picker-avatar" src="{{item.avatarUrl}}" mode="aspectFill" /><ui-icon wx:else name="knowledge-pick" size="{{48}}" rpx /></view><view class="grow"><text class="picker-name">{{item.name}}</text><text class="picker-meta">{{item.metaLabel}}</text></view><view wx:if="{{item.id === knowledgeId}}" class="picker-check"><ui-icon name="check" size="{{34}}" rpx /></view></view>
            <view wx:if="{{!filteredKnowledge.length}}" class="picker-empty">{{pickerQuery ? '没有找到匹配的知识库' : '还没有个人知识库，点右上角新建'}}</view>
          </view>
        </view>
        <view class="picker-group">
          <view class="picker-group-head"><view class="picker-group-title" data-group="shared" bindtap="togglePickerGroup"><text>共享知识库</text><view class="picker-chevron {{sharedExpanded ? '' : 'collapsed'}}"><ui-icon name="chevron-down" size="{{28}}" rpx /></view></view></view>
          <view wx:if="{{sharedExpanded}}">
            <view wx:for="{{filteredShared}}" wx:key="id" class="picker-item {{item.id === knowledgeId ? 'selected' : ''}}" bindtap="selectKnowledge" data-id="{{item.id}}">
              <view class="picker-folder"><image wx:if="{{item.avatarUrl}}" class="picker-avatar" src="{{item.avatarUrl}}" mode="aspectFill" /><ui-icon wx:else name="knowledge-pick" size="{{48}}" rpx /></view>
              <view class="grow"><text class="picker-name">{{item.name}}</text><text class="picker-meta">{{item.metaLabel}}</text></view>
              <text wx:if="{{item.badgeLabel}}" class="picker-badge">{{item.badgeLabel}}</text>
              <view wx:if="{{item.id === knowledgeId}}" class="picker-check"><ui-icon name="check" size="{{34}}" rpx /></view>
            </view>
            <view wx:if="{{!filteredShared.length}}" class="picker-empty-row">{{pickerQuery ? '没有找到匹配的共享知识库' : '暂无共享知识库'}}</view>
          </view>
        </view>
        <view class="picker-group">
          <view class="picker-group-head"><view class="picker-group-title" data-group="subscriptions" bindtap="togglePickerGroup"><text>订阅知识库</text><view class="picker-chevron {{subscriptionsExpanded ? '' : 'collapsed'}}"><ui-icon name="chevron-down" size="{{28}}" rpx /></view></view></view>
          <view wx:if="{{subscriptionsExpanded}}">
            <view wx:for="{{filteredSubscriptions}}" wx:key="id" class="picker-item {{item.id === knowledgeId ? 'selected' : ''}}" bindtap="selectKnowledge" data-id="{{item.id}}">
              <view class="picker-folder"><image wx:if="{{item.avatarUrl}}" class="picker-avatar" src="{{item.avatarUrl}}" mode="aspectFill" /><ui-icon wx:else name="knowledge-pick" size="{{48}}" rpx /></view>
              <view class="grow"><text class="picker-name">{{item.name}}</text><text class="picker-meta">{{item.metaLabel}}</text></view>
              <text wx:if="{{item.badgeLabel}}" class="picker-badge">{{item.badgeLabel}}</text>
              <view wx:if="{{item.id === knowledgeId}}" class="picker-check"><ui-icon name="check" size="{{34}}" rpx /></view>
            </view>
            <view wx:if="{{!filteredSubscriptions.length && pickerQuery}}" class="picker-empty-row">没有找到匹配的订阅知识库</view>
            <view wx:if="{{!filteredSubscriptions.length && !pickerQuery}}" class="picker-discover" bindtap="openDiscover"><view class="picker-discover-copy"><text class="picker-discover-title">去发现更多知识库</text><text class="picker-discover-desc">在知识库广场订阅后，会出现在这里</text></view><view class="picker-discover-art"><view class="picker-discover-sheet back"></view><view class="picker-discover-sheet front"></view></view></view>
          </view>
        </view>
        <!-- 两个链接挨着居中：button 自带 auto 左右外边距，在 flex 里会被拉开，必须清零 -->
        <view class="picker-footer"><button bindtap="openAgreement">服务协议</button><text class="picker-footer-dot">·</text><button bindtap="openPrivacy">隐私政策</button><text class="picker-footer-dot">·</text><button bindtap="openAiPrivacy">AI隐私政策</button></view>
      </scroll-view>
    </view>
  </view>
  <view wx:if="{{uploadSheetVisible}}" class="upload-layer" catchtouchmove="stopModelPickerBubble">
    <view class="upload-mask" bindtap="closeUploadSheet"></view>
    <view class="upload-sheet">
      <view class="upload-usage">
        <text class="upload-usage-text">已使用{{uploadUsedLabel}}/{{uploadLimitLabel}}</text>
        <button class="upload-upgrade" bindtap="activate">会员扩容<text class="upload-dot"></text></button>
      </view>
      <view class="upload-divider"></view>
      <view class="upload-grid">
        <button class="upload-option" bindtap="chooseUploadSource" data-source="knowledge">
          <view class="upload-option-icon upload-knowledge-icon"><ui-icon name="knowledge" size="{{33}}" /></view>
          <text>新建知识库</text>
        </button>
        <button class="upload-option" bindtap="chooseUploadSource" data-source="file">
          <view class="upload-option-icon"><ui-icon name="wechat-file" size="{{33}}" /></view>
          <text>微信文件</text>
        </button>
        <button class="upload-option" bindtap="chooseUploadSource" data-source="article">
          <view class="upload-option-icon"><ui-icon name="gongzhonghao" size="{{33}}" /></view>
          <text>公众号导入</text>
        </button>
        <button class="upload-option" bindtap="chooseUploadSource" data-source="album">
          <view class="upload-option-icon"><ui-icon name="image" size="{{33}}" /></view>
          <text>本地相册</text>
        </button>
        <button class="upload-option" bindtap="chooseUploadSource" data-source="camera">
          <view class="upload-option-icon"><ui-icon name="camera" size="{{33}}" /></view>
          <text>拍照</text>
        </button>
        <button class="upload-option" bindtap="chooseUploadSource" data-source="folder">
          <view class="upload-option-icon"><ui-icon name="folder-add" size="{{33}}" /></view>
          <text>创建文件夹</text>
        </button>
      </view>
      <!-- 相册 / 拍照 / 微信文件都是隐私接口：把指引入口放在选择动作旁边，审核和用户都看得到 -->
      <view class="privacy-line" bindtap="openPrivacyGuide">选择文件前会先展示《小程序用户隐私保护指引》；点此可查看全文</view>
      <button class="upload-cancel" bindtap="closeUploadSheet">取消</button>
    </view>
  </view>
  <view wx:if="{{articleSheetVisible}}" class="upload-layer" catchtouchmove="stopModelPickerBubble">
    <view class="upload-mask" bindtap="closeArticleSheet"></view>
    <view class="upload-sheet article-sheet">
      <text class="article-sheet-title">导入公众号文章</text>
      <text class="article-sheet-desc">粘贴公众号文章链接，正文的图片、文字和代码都会完整保留。</text>
      <view class="article-input-wrap">
        <input class="article-input" value="{{articleUrl}}" placeholder="https://mp.weixin.qq.com/s/..." bindinput="onArticleUrlInput" confirm-type="done" bindconfirm="confirmArticleImport" focus="{{articleSheetVisible}}" />
        <button wx:if="{{articleUrl}}" class="article-clear" bindtap="clearArticleUrl" aria-label="清空"><ui-icon name="close" size="{{16}}" /></button>
      </view>
      <button class="article-submit {{articleUrl && !articleImporting ? 'active' : ''}}" bindtap="confirmArticleImport" disabled="{{!articleUrl || articleImporting}}">{{articleImporting ? '正在抓取文章…' : '开始导入'}}</button>
      <button class="upload-cancel" bindtap="closeArticleSheet">取消</button>
    </view>
  </view>
  <!-- 技能：把常用任务写进输入框，随知识库资料执行；与问AI问答页共用同一套技能包 -->
  <!-- 技能：与问AI问答页共用同一份数据源（技能广场 + 我的技能），只有选中的才会注入后端 -->
  <!-- 邀请好友一起用这个知识库：先在服务端换一条一次性邀请链接，再让微信拉起转发 -->
  <view wx:if="{{kbShareVisible}}" class="picker-layer">
    <view class="picker-mask" bindtap="closeKnowledgeShare"></view>
    <view class="share-kb-sheet">
      <view class="picker-head"><button class="picker-close" bindtap="closeKnowledgeShare" aria-label="关闭"><ui-icon name="close" size="{{44}}" rpx /></button><text class="picker-title">邀请好友一起用</text></view>
      <view class="share-kb-card">
        <view class="share-kb-icon"><ui-icon name="knowledge-pick" size="{{44}}" rpx /></view>
        <view class="share-kb-copy"><text class="share-kb-name">{{knowledgeName || '微信用户的知识库'}}</text><text class="share-kb-meta">好友接受后会在他的「共享知识库」里</text></view>
      </view>
      <view class="share-kb-notes">
        <view class="share-kb-note"><ui-icon name="dui" size="{{26}}" rpx /><text>资料由你维护，好友那边自动同步</text></view>
        <view class="share-kb-note"><ui-icon name="dui" size="{{26}}" rpx /><text>好友只能阅读和提问，改不到你的资料</text></view>
        <view class="share-kb-note"><ui-icon name="dui" size="{{26}}" rpx /><text>一条链接只认第一个接受的好友，{{kbShareDays}} 天内有效</text></view>
      </view>
      <button class="share-kb-cta" open-type="share" aria-label="选择微信好友"><ui-icon name="wechat" size="{{38}}" rpx /><text>选择微信好友</text></button>
      <button class="share-kb-cancel" bindtap="closeKnowledgeShare">取消</button>
    </view>
  </view>
  <skill-picker visible="{{skillSheetVisible}}" selected="{{selectedSkillIds}}" bind:close="closeSheets" bind:select="onSkillSelect" bind:create="onSkillCreate" bind:edit="onSkillEdit" />
  <!-- 历史对话：后端持久化，按用户 + 知识库收窄，长按可删 -->
  <history-drawer visible="{{historyVisible}}" loading="{{historyLoading}}" activeId="{{conversationId}}" items="{{historyItems}}" bind:pick="pickHistory" bind:create="newConversation" bind:close="closeHistory" bind:pin="pinHistory" bind:remove="removeHistory" />
</view>
