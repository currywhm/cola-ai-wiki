<view class="page recent-page">
  <app-nav title="最近" center />
  <scroll-view class="recent-body" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:if="{{loading}}" class="recent-skeleton-wrap">
      <view class="recent-skeleton"></view>
      <view class="recent-skeleton short"></view>
      <view class="recent-skeleton"></view>
    </view>
    <block wx:else>
      <view wx:if="{{recentKbs.length}}" class="recent-section">
        <view class="recent-section-head">
          <text class="recent-section-title">最近知识库</text>
          <text class="recent-section-hint">按最近使用</text>
        </view>
        <scroll-view class="recent-kb-scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="recent-kb-list">
            <view wx:for="{{recentKbs}}" wx:key="id" class="recent-kb-card" hover-class="recent-kb-card-hover" hover-stay-time="60" bindtap="openKnowledge" data-id="{{item.id}}">
              <view class="recent-kb-icon {{item.tone}}"><ui-icon name="knowledge" size="{{36}}" rpx /></view>
              <text class="recent-kb-name">{{item.name}}</text>
              <text class="recent-kb-time">{{item.timeLabel}}</text>
            </view>
          </view>
        </scroll-view>
      </view>

      <view class="recent-section">
        <view class="recent-section-head">
          <text class="recent-section-title">最近知识</text>
          <text class="recent-section-hint">{{recentDocs.length}} 条</text>
        </view>
        <view wx:if="{{recentDocs.length}}" class="recent-doc-card">
          <view wx:for="{{recentDocs}}" wx:key="id" class="recent-doc" hover-class="recent-doc-hover" hover-stay-time="60" bindtap="openItem" data-id="{{item.id}}" data-kind="{{item.kind}}" data-knowledge="{{item.knowledgeId}}" data-name="{{item.name}}">
            <view class="recent-doc-icon"><ui-icon name="{{item.iconName}}" size="{{64}}" rpx /></view>
            <view class="recent-doc-info">
              <text class="recent-doc-name">{{item.name}}</text>
              <text class="recent-doc-time">{{item.timeLabel}}</text>
            </view>
          </view>
        </view>
        <view wx:elif="{{failed}}" class="recent-empty">暂时无法加载最近记录，请稍后重试</view>
        <view wx:else class="recent-empty">暂无最近记录</view>
      </view>
      <view wx:if="{{recentDocs.length}}" class="recent-end">没有更多了</view>
      <view class="recent-bottom-space"></view>
    </block>
  </scroll-view>
</view>
