/* 会话线程共用样式：问AI独立问答页、知识库会话、文件夹会话三处共用一份，
   保证「问AI」与「知识库 / 文件夹」进入的会话在字号、间距、圆角、配色上完全一致。 */

.qa-page { display: flex; flex-direction: column; width: 100%; max-width: 750rpx; height: 100vh; min-height: 0; margin: 0 auto; overflow: hidden; background: #fff; box-sizing: border-box; padding-bottom: env(safe-area-inset-bottom); }

/* 顶部：只留返回与胶囊按钮的安全高度 */
.qa-nav { position: relative; flex: 0 0 auto; }
button.qa-back { position: absolute; left: 6rpx; bottom: 0; display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; background: transparent; }
button.qa-back::after { border: 0; }
/* 返回右侧的折叠图标：拉出历史对话抽屉 */
button.qa-history { position: absolute; left: 76rpx; bottom: 0; display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; background: transparent; }
button.qa-history::after { border: 0; }
button.qa-history:active { background: #f2f2f2; }
/* 会话页的上下文（知识库名 / 文件夹名）：居中、小字、弱对比，不与标题栏抢位置 */
.qa-context { position: absolute; right: 200rpx; bottom: 0; left: 190rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 88rpx; }
.qa-context-title { max-width: 100%; overflow: hidden; color: #22262b; font-size: 30rpx; font-weight: 600; line-height: 1.25; text-overflow: ellipsis; white-space: nowrap; }
.qa-context-sub { max-width: 100%; margin-top: 2rpx; overflow: hidden; color: #9aa1a9; font-size: 21rpx; line-height: 1.25; text-overflow: ellipsis; white-space: nowrap; }

/* 会话内的资料条：文件夹会话用它保留「本文件夹有哪些文件」的可达性 */
.qa-docstrip { flex: 0 0 auto; padding: 0 30rpx 4rpx; }
.qa-docstrip-scroll { white-space: nowrap; }
/* 必须带 button. 前缀：app.wxss 的 button[class] 会把 display 拉成 flex，横滑芯片会变成竖排 */
button.qa-docstrip-chip { display: inline-flex; align-items: center; gap: 8rpx; max-width: 420rpx; margin-right: 14rpx; padding: 12rpx 22rpx; border-radius: 999rpx; background: #f4f5f6; color: #5d656e; font-size: 24rpx; line-height: 1.3; }
.qa-docstrip-chip:active { background: #eaeded; }
.qa-docstrip-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.qa-body { flex: 1 1 auto; min-height: 0; height: 0; padding: 8rpx 30rpx 24rpx; box-sizing: border-box; }

/* 开场白：品牌头像 + 一句招呼 + 当前资料范围（本地消息，不写入对话历史） */
.qa-hello { display: flex; align-items: flex-start; gap: 20rpx; padding: 6rpx 0 2rpx; }
.qa-hello-avatar { flex: 0 0 76rpx; width: 76rpx; height: 76rpx; border-radius: 24rpx; background: #eef4f1; }
.qa-hello-copy { flex: 1 1 auto; min-width: 0; padding-top: 2rpx; }
.qa-hello-title { display: block; color: #14171b; font-size: 33rpx; font-weight: 650; line-height: 1.4; letter-spacing: -.2rpx; }
.qa-hello-desc { display: block; margin-top: 10rpx; color: #6f7780; font-size: 27rpx; line-height: 1.7; }

/* 开场后的问答提示：直接发送，不再回填输入框 */
.qa-prompts { margin: 2rpx 0 8rpx; }
.qa-prompts-title { display: block; margin-bottom: 14rpx; color: #98a2ac; font-size: 24rpx; font-weight: 500; line-height: 1.4; }
/* justify-content 必须显式写：app.wxss 的 button[class] 会把它居中对齐 */
button.qa-prompt { display: flex; align-items: flex-start; justify-content: flex-start; width: 100%; margin: 0 0 16rpx; padding: 24rpx 26rpx; border-radius: 18rpx; background: #fff; color: #0a9b5c; font-size: 28rpx; font-weight: 500; line-height: 1.5; text-align: left; box-shadow: 0 4rpx 16rpx rgba(24, 32, 42, .06); }
button.qa-prompt:active { background: #f4f7f5; }
button.qa-prompt::after { border: 0; }
.qa-prompts-hint { display: block; padding: 4rpx 0 10rpx; color: #b0b6bd; font-size: 24rpx; line-height: 1.5; }

/* 消息 */
.qa-message { margin: 26rpx 0 34rpx; }
.qa-message.user { display: flex; justify-content: flex-end; }
.qa-user-bubble { max-width: 84%; padding: 20rpx 26rpx; border-radius: 22rpx 22rpx 6rpx 22rpx; background: #1f1f1f; color: #fff; font-size: 30rpx; line-height: 1.62; word-break: break-word; }
.qa-answer { min-width: 0; }
/* 正文：产品级字号（比初版小两档）与更紧的行高，长回答也不窒息 */
.qa-answer-text { display: block; color: #22262b; font-size: 29rpx; line-height: 1.78; letter-spacing: .2rpx; white-space: normal; word-break: break-word; }
.qa-answer-text .md-p { margin: 0 0 14rpx; }
.qa-answer-text .md-p:last-child { margin-bottom: 0; }
.qa-answer-text .md-h { margin: 20rpx 0 10rpx; color: #191c20; font-weight: 650; line-height: 1.45; }
.qa-answer-text .md-h1 { font-size: 34rpx; }
.qa-answer-text .md-h2 { font-size: 32rpx; }
.qa-answer-text .md-h3, .qa-answer-text .md-h4 { font-size: 30rpx; }

/* 过程区（思考 / 步骤 / 工具 / 技能）：小字号、弱对比，不抢正文 */
.qa-trace { margin: 0 0 20rpx; }
.qa-trace-head { display: flex; align-items: center; gap: 10rpx; padding: 6rpx 0; }
.qa-trace-dot { flex: 0 0 12rpx; width: 12rpx; height: 12rpx; border-radius: 50%; background: #c9ced4; }
.qa-trace-dot.live { background: #079c5a; animation: qa-pulse 1.4s ease-in-out infinite; }
@keyframes qa-pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: .45; transform: scale(.78); } }
.qa-trace-title { flex: 1 1 auto; min-width: 0; color: #7b838c; font-size: 25rpx; line-height: 1.4; }
.qa-trace-body { margin: 8rpx 0 4rpx; padding: 18rpx 22rpx; border-radius: 18rpx; background: #f7f8f9; }
.qa-reason { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 12; overflow: hidden; color: #8b929a; font-size: 24rpx; line-height: 1.68; white-space: pre-wrap; word-break: break-word; }
.qa-node { display: flex; align-items: flex-start; gap: 12rpx; margin-top: 14rpx; }
.qa-node-mark { flex: 0 0 10rpx; width: 10rpx; height: 10rpx; margin-top: 12rpx; border-radius: 50%; background: #cbd1d7; }
.qa-node.run .qa-node-mark { background: #079c5a; }
.qa-node.error .qa-node-mark { background: #d9534f; }
.qa-node.skill .qa-node-mark { background: #2f6fdd; }
.qa-node-copy { flex: 1 1 auto; min-width: 0; }
.qa-node-title { display: block; color: #5d656e; font-size: 24rpx; line-height: 1.5; }
.qa-node.done .qa-node-title { color: #767e87; }
.qa-node-detail { display: block; margin-top: 2rpx; color: #9aa1a9; font-size: 22rpx; line-height: 1.5; word-break: break-all; }
.qa-answer-text .md-pre { margin: 12rpx 0; padding: 18rpx 22rpx; border-radius: 12rpx; background: #f4f5f6; font-family: Menlo, Consolas, monospace; font-size: 25rpx; line-height: 1.6; white-space: pre-wrap; word-break: break-all; }
.qa-answer-text .md-code { padding: 2rpx 8rpx; border-radius: 6rpx; background: #f0f1f2; font-family: Menlo, Consolas, monospace; font-size: 25rpx; }
.qa-answer-text .md-list { margin: 8rpx 0 12rpx; padding-left: 36rpx; }
.qa-answer-text .md-li { margin: 6rpx 0; }
.qa-answer-text .md-quote { margin: 10rpx 0; padding-left: 16rpx; border-left: 4rpx solid #d8dce2; color: #6b7280; }
.qa-answer-text .md-link { color: #2f6fdd; text-decoration: underline; }
.qa-progress { display: inline-block; padding: 10rpx 20rpx; border-radius: 14rpx; background: #f4f5f6; color: #8b98a5; font-size: 26rpx; line-height: 1.5; }
.qa-sources { margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid #eceff0; }
.qa-source-title { display: block; margin-bottom: 10rpx; color: #8b98a5; font-size: 22rpx; }
.qa-source { display: flex; flex-direction: column; gap: 4rpx; margin-bottom: 10rpx; padding: 16rpx 18rpx; border-radius: 14rpx; background: #f7f9fa; }
.qa-source-file { color: #485465; font-size: 25rpx; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.qa-source-page { color: #9aa3ad; font-size: 21rpx; }
.qa-answer-actions { display: flex; align-items: center; justify-content: flex-end; gap: 12rpx; margin-top: 16rpx; padding-top: 14rpx; border-top: 1rpx solid #eceff0; }
button.qa-action { display: flex; align-items: center; gap: 6rpx; min-height: 48rpx; margin: 0; padding: 0 16rpx; border: 0; border-radius: 14rpx; background: #f3f4f5; color: #6d7684; font-size: 23rpx; line-height: 1.3; }
button.qa-action:active { background: #eaeded; }

.qa-state { display: flex; flex-direction: column; align-items: center; padding: 140rpx 30rpx 0; text-align: center; }
.qa-state-title { color: #1f2227; font-size: 32rpx; font-weight: 700; line-height: 1.5; }
.qa-state-desc { margin-top: 10rpx; color: #8b8e92; font-size: 25rpx; line-height: 1.6; }
button.qa-outline-button { min-width: 220rpx; min-height: 72rpx; margin-top: 28rpx; border: 1rpx solid #dce3e6; border-radius: 16rpx; background: #fff; color: #43505e; font-size: 26rpx; font-weight: 600; }

/* 输入卡片 */
.qa-footer { flex-shrink: 0; padding: 10rpx 24rpx 18rpx; background: #fff; }
.qa-composer { position: relative; overflow: hidden; border: 1rpx solid #d8d8d8; border-radius: 32rpx; background: #fff; }
.qa-input { display: block; width: 100%; min-height: 172rpx; max-height: 440rpx; box-sizing: border-box; padding: 40rpx 30rpx 0; color: #1f1f1f; font-size: 30rpx; font-weight: 400; line-height: 1.32; }
/* 已选技能提示：小胶囊 + 一键取消，不占正文位置 */
.qa-skill-chip { display: inline-flex; align-items: center; gap: 8rpx; margin: 22rpx 30rpx 0; padding: 8rpx 10rpx 8rpx 20rpx; border-radius: 999rpx; background: #eef5ff; }
.qa-skill-chip-text { color: #2f6fdd; font-size: 24rpx; line-height: 1.3; }
button.qa-skill-chip-close, button.qa-skill-chip-close::after { display: flex; align-items: center; justify-content: center; flex: 0 0 36rpx; width: 36rpx; min-width: 36rpx; height: 36rpx; min-height: 36rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; background: transparent; opacity: .7; }
.qa-bar { display: flex; align-items: center; gap: 4rpx; height: 112rpx; padding: 0 26rpx 0 24rpx; box-sizing: border-box; }
.qa-bar-spacer { flex: 1 1 auto; min-width: 0; }
/* 小机器人：参考稿里是一块淡蓝底的圆角方块，右侧跟一个下拉箭头表示可切换 */
button.qa-logic { display: flex; align-items: center; justify-content: center; gap: 2rpx; flex: 0 0 auto; width: auto; min-width: 76rpx; height: 72rpx; min-height: 72rpx; margin: 0; padding: 0 12rpx 0 16rpx; border: 0; border-radius: 22rpx; background: #eaf2fe; line-height: 1; }
button.qa-logic.knowledge { background: #eaf2fe; }
button.qa-logic.planner { background: #e9f6ee; }
button.qa-skill { display: flex; align-items: center; justify-content: center; gap: 2rpx; flex: 0 0 auto; width: auto; min-width: 76rpx; height: 72rpx; min-height: 72rpx; margin: 0 0 0 4rpx; padding: 0 10rpx; border: 0; border-radius: 22rpx; background: transparent; line-height: 1; }
button.qa-model { display: flex; align-items: center; justify-content: center; flex: 0 0 72rpx; width: 72rpx; min-width: 72rpx; height: 72rpx; min-height: 72rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; background: transparent; }
button.qa-scope { display: flex; align-items: center; justify-content: center; gap: 4rpx; flex: 0 0 auto; width: auto; min-width: 72rpx; height: 72rpx; min-height: 72rpx; margin: 0 0 0 6rpx; padding: 0 8rpx; border: 0; border-radius: 999rpx; background: transparent; line-height: 1; }
/* 发送/停止：图标自带实心底，按钮只负责占位与对齐，三态尺寸完全一致 */
button.qa-send, button.qa-send[disabled] { display: flex; align-items: center; justify-content: center; flex: 0 0 58rpx; width: 58rpx; min-width: 58rpx; height: 58rpx; min-height: 58rpx; margin: 0 0 0 16rpx; padding: 0; border: 0; border-radius: 50%; background: transparent; box-shadow: none; opacity: 1; }
button.qa-send::after, button.qa-logic::after, button.qa-skill::after, button.qa-scope::after, button.qa-model::after, button.qa-action::after, button.qa-outline-button::after, button.sheet-close::after, button.skill-row::after, button.scope-doc::after, button.scope-dir::after, button.kb-confirm::after, button.qa-docstrip-chip::after, button.qa-send::after { border: 0; }

/* 通用底部弹层 */
.sheet-layer { position: fixed; z-index: 90; top: 0; right: 0; bottom: 0; left: 0; }
.sheet-mask { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: rgba(0, 0, 0, .42); }
.sheet-panel { position: absolute; right: 0; bottom: 0; left: 0; max-width: 750rpx; margin: 0 auto; box-sizing: border-box; padding: 40rpx 32rpx calc(36rpx + env(safe-area-inset-bottom)); border-radius: 28rpx 28rpx 0 0; background: #fff; }
.sheet-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 34rpx; }
.sheet-title { color: #1f1f1f; font-size: 34rpx; font-weight: 650; line-height: 1.3; letter-spacing: .5rpx; }
button.sheet-close { display: flex; align-items: center; justify-content: center; flex: 0 0 60rpx; width: 60rpx; min-width: 60rpx; height: 60rpx; min-height: 60rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; background: #f2f2f2; }
button.sheet-close:active { background: #e8e8e8; }

/* 更多选项 */
.option-card { display: flex; align-items: center; gap: 22rpx; padding: 26rpx 28rpx; border: 1rpx solid #ececec; border-radius: 24rpx; background: #fff; }
.option-card:active { background: #fafafa; }
.option-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 72rpx; width: 72rpx; height: 72rpx; }
.option-copy { flex: 1 1 auto; min-width: 0; }
.option-name { display: block; color: #1f1f1f; font-size: 32rpx; font-weight: 600; line-height: 1.35; }
.option-desc { display: block; margin-top: 6rpx; color: #9c9c9c; font-size: 25rpx; line-height: 1.35; }
.option-pill { flex: 0 0 auto; padding: 10rpx 24rpx; border-radius: 999rpx; background: #f4f4f4; color: #8c8c8c; font-size: 25rpx; line-height: 1.1; }
.option-pill.on { background: #eaf7f0; color: #079c5a; font-weight: 600; }

/* 技能 */
button.skill-row { display: flex; align-items: center; gap: 22rpx; width: 100%; min-height: 112rpx; margin: 0; padding: 18rpx 24rpx; border: 0; border-radius: 22rpx; background: #fff; text-align: left; }
button.skill-row:active { background: #fafafa; }
.skill-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 72rpx; width: 72rpx; height: 72rpx; border-radius: 20rpx; background: #f5f6f7; }
.skill-copy { flex: 1 1 auto; min-width: 0; }
.skill-name { display: block; color: #1f1f1f; font-size: 30rpx; font-weight: 600; line-height: 1.4; }
.skill-desc { display: block; margin-top: 4rpx; color: #9c9c9c; font-size: 24rpx; line-height: 1.4; }

/* 选择知识 */
.knowledge-panel { display: flex; flex-direction: column; max-height: 80vh; }
.kb-search { display: flex; align-items: center; gap: 16rpx; height: 86rpx; padding: 0 26rpx; border-radius: 18rpx; background: #f5f5f5; }
.kb-search-input { flex: 1 1 auto; min-width: 0; color: #1f1f1f; font-size: 28rpx; }
button.kb-dir { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 96rpx; margin: 24rpx 0 0; padding: 0 26rpx; border: 0; border-radius: 18rpx; background: #f5f5f5; color: #1f1f1f; font-size: 30rpx; font-weight: 500; line-height: 1.3; text-align: left; }
button.kb-dir:active { background: #eeeeee; }
.kb-section { display: block; margin: 32rpx 0 12rpx; color: #9c9c9c; font-size: 24rpx; }
.kb-list { flex: 1 1 auto; min-height: 0; max-height: 520rpx; }
.kb-row { display: flex; align-items: center; gap: 20rpx; min-height: 104rpx; }
.kb-radio { flex: 0 0 40rpx; width: 40rpx; height: 40rpx; box-sizing: border-box; border: 3rpx solid #dcdcdc; border-radius: 50%; }
.kb-radio.on { border-color: #079c5a; background: #079c5a; box-shadow: inset 0 0 0 8rpx #fff; }
.kb-name { flex: 1 1 auto; min-width: 0; color: #1f1f1f; font-size: 30rpx; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.kb-empty { padding: 48rpx 0; color: #9c9c9c; font-size: 26rpx; text-align: center; }
.kb-foot { display: flex; justify-content: flex-end; padding-top: 24rpx; }
button.kb-confirm { min-width: 184rpx; height: 84rpx; margin: 0; padding: 0 40rpx; border: 0; border-radius: 16rpx; background: #079c5a; color: #fff; font-size: 30rpx; font-weight: 600; line-height: 84rpx; }
button.kb-confirm:active { background: #078b50; }

/* 文件夹会话：范围弹层里列出本文件夹资料 */
.scope-panel { display: flex; flex-direction: column; max-height: 80vh; }
.scope-hint { display: block; margin: -12rpx 0 22rpx; color: #9c9c9c; font-size: 24rpx; line-height: 1.5; }
.scope-list { flex: 1 1 auto; min-height: 0; max-height: 620rpx; }
button.scope-doc { display: flex; align-items: center; gap: 18rpx; width: 100%; min-height: 104rpx; margin: 0; padding: 0 10rpx; border: 0; border-radius: 16rpx; background: #fff; text-align: left; }
button.scope-doc:active { background: #f7f7f7; }
.scope-doc-name { flex: 1 1 auto; min-width: 0; color: #1f1f1f; font-size: 29rpx; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.scope-doc-type { flex: 0 0 auto; color: #9aa3ad; font-size: 22rpx; }
button.scope-dir { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 96rpx; margin: 24rpx 0 0; padding: 0 26rpx; border: 0; border-radius: 18rpx; background: #f5f5f5; color: #1f1f1f; font-size: 30rpx; font-weight: 500; line-height: 1.3; text-align: left; }
button.scope-dir:active { background: #eeeeee; }
.scope-empty { padding: 44rpx 0; color: #9c9c9c; font-size: 26rpx; line-height: 1.6; text-align: center; }
