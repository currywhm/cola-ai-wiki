<view class="page mine-page">
  <app-nav id="pageNav" title="我的" center />
  <view class="mine-content">
    <block wx:if="{{!loggedIn}}">
      <view class="guest-panel">
        <view class="profile-card guest-profile-card" bindtap="openLogin">
          <view class="profile-main">
            <view class="profile-avatar guest-avatar"><ui-icon name="mine-login" size="{{48}}" rpx /></view>
            <view class="profile-copy">
              <text class="profile-name">登录</text>
              <text class="profile-id">立即体验知识库</text>
            </view>
            <ui-icon name="chevron-right" size="{{18}}" />
          </view>
        </view>

        <view class="menu-section guest-menu-section">
          <button class="menu-row" bindtap="openLogin">
            <view class="menu-icon"><ui-icon name="mine-usage" size="{{24}}" /></view>
            <view class="menu-main"><text class="menu-title">使用情况</text><text class="menu-desc">查看资料、空间与本月积分</text></view>
            <ui-icon name="chevron-right" size="{{16}}" />
          </button>
          <button class="menu-row" bindtap="openLogin">
            <view class="menu-icon"><ui-icon name="mine-membership" size="{{24}}" /></view>
            <view class="menu-main"><text class="menu-title">会员服务</text><text class="menu-desc">查看会员权益与空间方案</text></view>
            <ui-icon name="chevron-right" size="{{16}}" />
          </button>
          <button class="menu-row" bindtap="openLogin">
            <view class="menu-icon"><ui-icon name="mine-tips" size="{{24}}" /></view>
            <view class="menu-main"><text class="menu-title">使用技巧</text><text class="menu-desc">上手指南、提问方法和权益说明</text></view>
            <ui-icon name="chevron-right" size="{{16}}" />
          </button>
          <button class="menu-row" bindtap="openLogin">
            <view class="menu-icon"><ui-icon name="mine-service" size="{{24}}" /></view>
            <view class="menu-main"><text class="menu-title">联系客服</text><text class="menu-desc">订单与退款、注销账号、删除数据、侵权投诉</text></view>
            <ui-icon name="chevron-right" size="{{16}}" />
          </button>
        </view>

        <button class="guest-login-button" bindtap="openLogin">去登录</button>
        <view class="legal-footer guest-legal-footer">
          <view>
            <button bindtap="openLegal" data-type="terms">服务协议</button>
            <text class="legal-separator">|</text>
            <button bindtap="openLegal" data-type="guide">隐私政策</button>
            <text class="legal-separator">|</text>
            <button bindtap="openLegal" data-type="ai-privacy">AI隐私政策</button>
            <text class="legal-separator">|</text>
            <button bindtap="openLegal" data-type="license">软件许可</button>
          </view>
        </view>
      </view>
    </block>
    <block wx:else>
    <view class="profile-card">
      <view class="profile-main">
        <view class="profile-avatar">
          <!-- 设过头像就显示微信头像；没设过仍用产品标识 -->
          <image wx:if="{{avatarSrc}}" class="profile-avatar-image" src="{{avatarSrc}}" mode="aspectFill" />
          <image wx:else class="profile-avatar-image" src="/assets/brand/cola-avatar.png" mode="aspectFit" />
        </view>
        <view class="profile-copy">
          <view class="profile-name-row">
            <text class="profile-name">{{user.nickname || '微信用户'}}</text>
            <text class="plan-badge">{{user.membership_label || '基础版'}}</text>
          </view>
          <text class="profile-id">{{statusLine}}</text>
        </view>
        <button class="profile-edit" bindtap="openAccountSettings">
          <text>账号设置</text>
          <ui-icon name="chevron-right" size="{{17}}" />
        </button>
      </view>

      <view wx:if="{{loadState === 'error'}}" class="account-status">
        <text>微信登录暂不可用，请稍后重试</text>
        <button class="outline-button" bindtap="load">重新连接</button>
      </view>
      <text wx:elif="{{loadState === 'loading'}}" class="account-loading">正在连接微信账号…</text>
      <view wx:else class="storage-block">
        <view class="storage-line">
          <text class="storage-count">{{storageUsedLabel}} / {{storageLimitLabel}}</text>
          <text class="storage-label">{{storageNote}}</text>
        </view>
        <view class="storage-track"><view class="storage-fill" style="{{storageFillStyle}}"></view></view>
        <view class="storage-meta">
          <text class="storage-meta-item">{{quotaLabel}}</text>
          <text wx:if="{{!memberActive && !trialActive}}" class="storage-meta-warn">试用已结束，升级会员可继续添加资料</text>
        </view>
      </view>
    </view>

    <view class="menu-section">
      <button class="menu-row" bindtap="openUsage">
        <view class="menu-icon"><ui-icon name="mine-usage" size="{{24}}" /></view>
        <view class="menu-main">
          <text class="menu-title">使用情况</text>
          <text class="menu-desc">{{loadState === 'ready' ? stats.knowledge + ' 个资料库 · ' + stats.documents + ' 个文档 · ' + quotaLabel : '查看资料、空间与本月积分'}}</text>
        </view>
        <ui-icon name="chevron-right" size="{{16}}" />
      </button>

      <button class="menu-row" bindtap="openMembership">
        <view class="menu-icon"><ui-icon name="mine-membership" size="{{24}}" /></view>
        <view class="menu-main">
          <text class="menu-title">会员服务</text>
          <text class="menu-desc">{{user.membership_label || '基础版'}} · Plus 10GB / Pro 30GB 空间</text>
        </view>
        <ui-icon name="chevron-right" size="{{16}}" />
      </button>

      <button class="menu-row" bindtap="openTips">
        <view class="menu-icon"><ui-icon name="mine-tips" size="{{24}}" /></view>
        <view class="menu-main">
          <text class="menu-title">使用技巧</text>
          <text class="menu-desc">上手指南、提问方法和权益说明</text>
        </view>
        <ui-icon name="chevron-right" size="{{16}}" />
      </button>

      <button class="menu-row" open-type="contact" session-from="mine"
        send-message-title="回到 Cola" send-message-path="pages/mine/index"
        show-message-card="{{true}}" bindcontact="onContact">
        <view class="menu-icon"><ui-icon name="mine-service" size="{{24}}" /></view>
        <view class="menu-main">
          <text class="menu-title">联系客服</text>
          <text class="menu-desc">订单与退款、注销账号、删除数据、侵权投诉</text>
        </view>
        <ui-icon name="chevron-right" size="{{16}}" />
      </button>

      <button class="menu-row logout-bar" bindtap="openLogout">
        <view class="menu-icon"><ui-icon name="mine-logout" size="{{23}}" /></view>
        <text class="menu-title">退出登录</text>
        <ui-icon name="chevron-right" size="{{16}}" />
      </button>
    </view>

    <view wx:if="{{accountVisible}}" class="plan-layer">
      <view class="plan-mask" bindtap="closeAccountSettings"></view>
      <view class="plan-picker" catchtap="stopPickerBubble">
        <view class="plan-picker-head">
          <view class="plan-heading-copy">
            <text class="plan-picker-title">账号设置</text>
            <text class="plan-picker-desc">{{privacyNeeded ? '第 1 步 · 同意微信官方隐私提示' : '第 2 步 · 选用你的微信头像和昵称'}}</text>
          </view>
          <button class="close-picker" bindtap="closeAccountSettings" disabled="{{savingProfile}}" aria-label="关闭账号设置">
            <ui-icon name="close" size="{{18}}" />
          </button>
        </view>

        <!-- 第 1 步：微信侧还没记录同意时，这里只给一个官方「同意」按钮。
             open-type="agreePrivacyAuthorization" 是官方指定的隐私同意组件，点它弹出的是微信官方
             隐私弹窗（「用户隐私保护提示」+ 拒绝 / 同意），不是我们自绘的弹层。 -->
        <block wx:if="{{privacyNeeded}}">
          <view class="official-notice">
            <text class="official-notice-title">用户隐私保护提示</text>
            <text class="official-notice-body">在你使用 cola知识库 服务之前，请仔细阅读 {{privacyContractName || '《cola知识库小程序隐私保护指引》'}}。如你同意该指引，请点击「同意」开始使用本小程序。</text>
          </view>
          <button class="confirm-pay" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="onPrivacyAgreed" bindtap="onAgreeTap">
            <text>同意并使用微信头像昵称</text>
          </button>
          <view class="account-privacy" bindtap="openPrivacyGuide">查看《小程序用户隐私保护指引》全文</view>
        </block>

        <!-- 第 2 步：两个控件都是微信官方的，各点一下就能选用，不需要打字。
             头像 = <button open-type="chooseAvatar">，昵称 = <input type="nickname">（键盘上方给微信昵称）。 -->
        <block wx:else>
          <button class="avatar-picker" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
            <image wx:if="{{avatarPreview}}" class="avatar-picker-image" src="{{avatarPreview}}" mode="aspectFill" />
            <image wx:elif="{{avatarSrc}}" class="avatar-picker-image" src="{{avatarSrc}}" mode="aspectFill" />
            <image wx:else class="avatar-picker-image" src="/assets/brand/cola-avatar.png" mode="aspectFit" />
            <view class="avatar-picker-badge"><ui-icon name="camera" size="{{26}}" rpx /></view>
          </button>
          <text class="avatar-picker-hint">点一下，选用你的微信头像</text>
          <view class="account-row" bindtap="focusNickname">
            <text class="account-row-label">微信昵称</text>
            <input class="account-row-input" type="nickname" value="{{nicknameDraft}}" focus="{{nicknameFocus}}" placeholder="点一下一键选用" placeholder-class="account-placeholder" bindinput="onNicknameInput" bindblur="onNicknameBlur" />
            <text class="account-row-tag">一键选用</text>
          </view>
          <text class="account-note">头像和昵称用的都是微信官方控件里的那一份：点头像、点昵称各一次即可，不用打字。保存后仅用于在本小程序内显示你的账号。</text>
          <button class="confirm-pay" bindtap="saveProfile" loading="{{savingProfile}}" disabled="{{savingProfile}}">
            <text>{{savingProfile ? '保存中' : '保存'}}</text>
          </button>
          <view class="account-privacy" bindtap="openPrivacyGuide">查看《小程序用户隐私保护指引》全文</view>
        </block>
      </view>
    </view>

    <view class="legal-footer">
      <view>
        <button bindtap="openLegal" data-type="terms">服务协议</button>
        <text class="legal-separator">|</text>
        <button bindtap="openLegal" data-type="guide">隐私政策</button>
        <text class="legal-separator">|</text>
        <button bindtap="openLegal" data-type="ai-privacy">AI隐私政策</button>
        <text class="legal-separator">|</text>
        <button bindtap="openLegal" data-type="license">软件许可</button>
      </view>
    </view>



    <view wx:if="{{logoutVisible}}" class="logout-layer">
      <view class="logout-mask" bindtap="closeLogout"></view>
      <view class="logout-sheet" catchtap="stopLogoutBubble">
        <view class="logout-head">
          <text class="logout-title">退出登录</text>
          <button class="logout-close" bindtap="closeLogout" disabled="{{loggingOut}}" aria-label="关闭退出登录确认">
            <ui-icon name="close" size="{{19}}" />
          </button>
        </view>
        <text class="logout-question">确认退出当前账号吗？</text>
        <view class="logout-actions">
          <button class="logout-button logout-cancel" bindtap="closeLogout" disabled="{{loggingOut}}">取消</button>
          <button class="logout-button logout-confirm" bindtap="confirmLogout" loading="{{loggingOut}}" disabled="{{loggingOut}}">确认</button>
        </view>
      </view>
    </view>
    </block>
  </view>
</view>
