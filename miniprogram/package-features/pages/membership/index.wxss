.membership-page { min-height:100vh; padding:0 24rpx calc(190rpx + env(safe-area-inset-bottom)); background:#f5f6f6; color:#17191d; }
.membership-state { padding:48rpx 8rpx; }
.membership-skeleton { border-radius:16rpx; background:#e9eceb; }
.membership-skeleton-title { width:52%; height:36rpx; }
.membership-skeleton-card { height:190rpx; margin-top:24rpx; }
.membership-state-title { display:block; color:#17191d; font-size:32rpx; font-weight:700; line-height:1.45; }
.membership-state-desc { display:block; margin-top:10rpx; color:#7b858e; font-size:26rpx; line-height:1.65; }
button.membership-retry { width:100%; min-height:88rpx; margin-top:26rpx; border:0; border-radius:16rpx; background:#1677ff; color:#fff; font-size:29rpx; font-weight:600; }
.membership-hero { display:flex; align-items:center; gap:18rpx; padding:30rpx; border-radius:22rpx; background:#fff; }
.membership-hero-icon { display:flex; align-items:center; justify-content:center; flex:0 0 66rpx; width:66rpx; height:66rpx; border-radius:18rpx; background:#eef8f4; color:#16875b; }
.membership-hero-main { flex:1; min-width:0; }
.membership-hero-title { display:block; color:#17191d; font-size:34rpx; font-weight:760; line-height:1.35; }
.membership-hero-desc { display:block; margin-top:7rpx; color:#818c96; font-size:23rpx; line-height:1.5; }
.membership-block { margin-top:20rpx; padding:28rpx; border-radius:22rpx; background:#fff; }
.membership-block-title { display:block; color:#17191d; font-size:29rpx; font-weight:700; line-height:1.4; }
.tier-tabs { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14rpx; margin-top:20rpx; }
button.tier-tab { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6rpx; min-height:102rpx; padding:14rpx; border:1rpx solid #edf0f1; border-radius:16rpx; background:#fff; color:#4b5663; text-align:center; }
.tier-tab-title { color:#20242b; font-size:30rpx; font-weight:800; line-height:1.3; }
.tier-tab-desc { color:#8e99a4; font-size:22rpx; font-weight:500; line-height:1.35; }
.tier-tab.active { border-color:#a9d7c1; background:#eef9f4; }
.tier-tab.active .tier-tab-title { color:#16875b; }
.plan-options { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12rpx; margin-top:18rpx; }
button.plan-option { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:5rpx; min-width:0; min-height:104rpx; padding:12rpx 8rpx; border:1rpx solid #edf0f1; border-radius:15rpx; background:#fff; color:#4b5663; text-align:center; }
.plan-option.selected { border-color:#a9d7c1; background:#eef9f4; }
.plan-option-label { color:#44505d; font-size:24rpx; font-weight:760; line-height:1.25; }
.plan-option-price { color:#17191d; font-size:30rpx; font-weight:800; line-height:1.2; }
.plan-option-note { overflow:hidden; width:100%; color:#8b96a1; font-size:19rpx; line-height:1.25; text-overflow:ellipsis; white-space:nowrap; }
.benefit-row { display:flex; align-items:flex-start; justify-content:space-between; gap:20rpx; margin-top:20rpx; }
.benefit-label { flex:0 0 150rpx; color:#89949f; font-size:23rpx; line-height:1.55; }
.benefit-value { flex:1; color:#2d3742; font-size:25rpx; font-weight:600; line-height:1.55; text-align:right; }
button.plan-terms { min-height:50rpx; margin:22rpx auto 0; padding:0 8rpx; border:0; background:transparent; color:#16875b; font-size:22rpx; font-weight:600; text-decoration:underline; }
.checkout-bar { position:fixed; z-index:20; right:0; bottom:0; left:0; display:flex; align-items:center; gap:22rpx; padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); border-top:1rpx solid #eceeef; background:rgba(255,255,255,.96); box-sizing:border-box; }
.checkout-main { flex:1; min-width:0; }
.checkout-label { display:block; color:#8a949e; font-size:21rpx; line-height:1.3; }
.checkout-price { display:block; margin-top:2rpx; color:#17191d; font-size:34rpx; font-weight:800; line-height:1.25; }
button.checkout-button { flex:0 0 250rpx; min-height:84rpx; margin:0; padding:0 22rpx; border:0; border-radius:18rpx; background:#07c160; color:#fff; font-size:29rpx; font-weight:700; }
