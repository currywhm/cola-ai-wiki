/* 知识库邀请落地页：与「问AI / 知识库 / 我的」共用同一套背景与卡片语言，
   全程不画分隔线，靠底色与留白分层。 */
page { overflow-x: hidden; background: #f5f6f6; }

.kb-page { display: flex; flex-direction: column; width: 100%; max-width: 750rpx; height: 100vh; min-height: 0; margin: 0 auto; overflow: hidden; background: #f5f6f6; box-sizing: border-box; }

.kb-nav { flex: 0 0 auto; display: flex; align-items: flex-end; padding: 0 34rpx; }
.kb-nav-row { display: flex; align-items: center; gap: 16rpx; width: 100%; height: 88rpx; }
.kb-logo { flex: 0 0 56rpx; width: 56rpx; height: 56rpx; border-radius: 16rpx; }
.kb-logo-text { color: #23282f; font-size: 30rpx; font-weight: 600; line-height: 1.3; letter-spacing: .4rpx; }

.kb-body { flex: 1; min-height: 0; padding: 14rpx 30rpx 0; box-sizing: border-box; }

/* 资料库概览卡 */
.kb-card { padding: 34rpx 32rpx 30rpx; border-radius: 28rpx; background: #fff; box-shadow: 0 2rpx 12rpx rgba(24,28,34,.04); }
.kb-card-head { display: flex; align-items: center; gap: 22rpx; }
.kb-card-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 88rpx; width: 88rpx; height: 88rpx; border-radius: 26rpx; background: #f2f6f3; }
.kb-card-copy { flex: 1; min-width: 0; }
.kb-card-name { display: block; overflow: hidden; color: #171b20; font-size: 36rpx; font-weight: 650; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.kb-card-meta { display: block; margin-top: 8rpx; color: #9aa3ad; font-size: 25rpx; font-weight: 400; line-height: 1.4; }
.kb-card-desc { display: block; margin-top: 22rpx; color: #6f767e; font-size: 27rpx; font-weight: 400; line-height: 1.62; }

/* 三条说明：只说清「接受之后会发生什么」，不做成清单样式的重底 */
.kb-notes { margin-top: 16rpx; padding: 26rpx 32rpx 22rpx; border-radius: 28rpx; background: #fff; box-shadow: 0 2rpx 12rpx rgba(24,28,34,.04); }
.kb-note { display: flex; align-items: flex-start; gap: 16rpx; padding: 12rpx 0; }
.kb-note-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 36rpx; width: 36rpx; height: 36rpx; margin-top: 4rpx; }
.kb-note-text { flex: 1; color: #4c545c; font-size: 27rpx; font-weight: 400; line-height: 1.6; }

/* 加载骨架：只用亮度差，不画线 */
.kb-skeleton { padding: 34rpx 32rpx; border-radius: 28rpx; background: #fff; box-shadow: 0 2rpx 12rpx rgba(24,28,34,.04); }
.kb-skeleton-line { height: 30rpx; margin-bottom: 24rpx; border-radius: 10rpx; background: #eef0f1; }
.kb-skeleton-line:last-child { margin-bottom: 0; }
.kb-skeleton-line.short { width: 58%; }

/* 失效 / 已被领取 / 网络异常 */
.kb-state { display: flex; flex-direction: column; align-items: center; padding: 150rpx 40rpx 0; text-align: center; }
.kb-state-icon { display: flex; align-items: center; justify-content: center; width: 112rpx; height: 112rpx; border-radius: 34rpx; background: #fff; box-shadow: 0 2rpx 12rpx rgba(24,28,34,.04); }
.kb-state-title { margin-top: 28rpx; color: #1f2227; font-size: 34rpx; font-weight: 650; line-height: 1.4; }
.kb-state-desc { margin-top: 12rpx; color: #8b8e92; font-size: 26rpx; font-weight: 400; line-height: 1.65; }
button.kb-state-button { display: flex; align-items: center; justify-content: center; min-width: 260rpx; min-height: 84rpx; margin: 30rpx 0 0; padding: 0 34rpx; border: 1rpx solid #e3e6e8; border-radius: 999rpx; background: #fff; color: #23282f; font-size: 28rpx; font-weight: 500; }

/* 底部动作区 */
.kb-footer { flex: 0 0 auto; padding: 14rpx 34rpx calc(22rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: linear-gradient(180deg, rgba(245,246,246,0) 0%, rgba(245,246,246,.96) 32%, #f5f6f6 100%); }
.kb-hint { display: block; margin: 0 8rpx 14rpx; color: #8b9096; font-size: 23rpx; font-weight: 400; line-height: 1.45; }
.kb-footer-row { display: flex; align-items: center; gap: 18rpx; }
button.kb-cta { display: flex; flex: 1; align-items: center; justify-content: center; min-width: 0; min-height: 96rpx; margin: 0; padding: 0 32rpx; border: 0; border-radius: 999rpx; background: #242b3d; color: #fff; font-size: 30rpx; font-weight: 600; line-height: 1.3; }
button.kb-cta.ghost { width: 100%; background: #fff; border: 1rpx solid #e3e6e8; color: #23282f; }
button.kb-cta:active { opacity: .88; }
button.kb-forward { display: flex; align-items: center; justify-content: center; flex: 0 0 96rpx; width: 96rpx; min-width: 96rpx; height: 96rpx; min-height: 96rpx; margin: 0; padding: 0; border: 1rpx solid #e3e6e8; border-radius: 50%; background: #fff; }
button.kb-forward:active { background: #f2f4f3; }
button.kb-cta::after, button.kb-forward::after, button.kb-state-button::after { border: 0; }

.kb-bottom-space { height: 40rpx; }
