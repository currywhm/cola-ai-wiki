/* 新建 / 编辑技能：与「我的」页面同一套版式——浅灰底 + 白色圆角卡，
   全程不画分隔线，靠留白和圆角区分层级；顶部只避让胶囊按钮。 */
page { overflow-x: hidden; background: #f5f6f6; }

.se-page { display: flex; flex-direction: column; width: 100%; max-width: 750rpx; height: 100vh; min-height: 0; margin: 0 auto; overflow: hidden; background: #f5f6f6; box-sizing: border-box; }

/* 顶部：返回键贴左，标题居中 */
.se-nav { position: relative; flex: 0 0 auto; }
button.se-back { position: absolute; left: 6rpx; bottom: 0; display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; background: transparent; }
button.se-back::after { border: 0; }
button.se-back:active { background: #eceeee; }
.se-nav-title-wrap { position: absolute; right: 200rpx; bottom: 0; left: 96rpx; display: flex; align-items: center; justify-content: center; height: 88rpx; }
.se-nav-title { max-width: 100%; overflow: hidden; color: #171b20; font-size: 32rpx; font-weight: 650; line-height: 1.25; letter-spacing: -.2rpx; text-overflow: ellipsis; white-space: nowrap; }

.se-body { flex: 1 1 auto; min-height: 0; height: 0; padding: 8rpx 30rpx 0; box-sizing: border-box; }
.se-loading { padding: 160rpx 0; color: #a8adb3; font-size: 26rpx; text-align: center; }

/* 首屏说明：先讲清「选中才生效」，避免用户以为保存就自动带上 */
.se-intro { padding: 6rpx 8rpx 20rpx; }
.se-intro-title { display: block; color: #171b20; font-size: 40rpx; font-weight: 700; line-height: 1.3; letter-spacing: -.6rpx; }
.se-intro-desc { display: block; margin-top: 10rpx; color: #9aa1a9; font-size: 24rpx; font-weight: 400; line-height: 1.55; }

.se-card { margin-top: 16rpx; padding: 26rpx 28rpx 24rpx; border-radius: 26rpx; background: #fff; box-shadow: 0 2rpx 12rpx rgba(24, 28, 34, .04); }
.se-label { color: #7d848c; font-size: 24rpx; font-weight: 500; line-height: 1.4; letter-spacing: .2rpx; }
.se-label-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.se-counter { color: #b6bbc1; font-size: 22rpx; font-weight: 400; line-height: 1.4; }

.se-input { height: 68rpx; margin-top: 6rpx; color: #171b20; font-size: 30rpx; font-weight: 500; line-height: 1.4; }
.se-placeholder { color: #b6bbc1; font-size: 28rpx; font-weight: 400; }
.se-textarea { width: 100%; min-height: 260rpx; max-height: 640rpx; margin-top: 12rpx; padding: 22rpx 22rpx 24rpx; border-radius: 20rpx; background: #f5f6f7; color: #1f2227; font-size: 28rpx; font-weight: 400; line-height: 1.7; box-sizing: border-box; }

/* 图标选择：每行精确 7 个，14 个图标正好两行；选中用浅底 + 描边，不用对勾，保持安静 */
.se-icons { display: flex; flex-wrap: wrap; justify-content: space-between; margin-top: 4rpx; }
.se-icon { display: flex; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; margin-top: 16rpx; border: 2rpx solid #eef0f2; border-radius: 22rpx; background: #fff; opacity: .62; }
.se-icon.on { border-color: #cfd4d9; background: #f5f6f7; opacity: 1; }

.se-note { margin-top: 16rpx; padding: 22rpx 26rpx; border-radius: 22rpx; background: #eef1f4; }
.se-note-text { color: #6f7780; font-size: 24rpx; font-weight: 400; line-height: 1.6; }

.se-bottom-space { height: 40rpx; }

/* 底部操作：编辑态多一行「下架 / 删除」，按钮一律无边框 */
.se-footer { flex: 0 0 auto; display: flex; flex-direction: column; gap: 14rpx; padding: 18rpx 30rpx calc(22rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #f5f6f6; }
.se-footer-row { display: flex; align-items: center; gap: 16rpx; }
button.se-ghost { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 84rpx; margin: 0; padding: 0 28rpx; border: 1rpx solid #e3e6e8; border-radius: 999rpx; background: #fff; color: #4b545d; font-size: 27rpx; font-weight: 500; line-height: 1.3; }
button.se-ghost:active { background: #f0f2f3; }
button.se-danger { display: flex; align-items: center; justify-content: center; flex: 0 0 180rpx; min-height: 92rpx; margin: 0; padding: 0 24rpx; border: 1rpx solid #f0d9d9; border-radius: 999rpx; background: #fff; color: #d94545; font-size: 28rpx; font-weight: 500; line-height: 1.3; }
button.se-danger:active { background: #fdf3f3; }
button.se-save { display: flex; flex: 1 1 auto; align-items: center; justify-content: center; min-height: 92rpx; margin: 0; padding: 0 32rpx; border: 0; border-radius: 999rpx; background: #242b3d; color: #fff; font-size: 30rpx; font-weight: 600; line-height: 1.3; }
button.se-save:active { opacity: .9; }
button.se-save[disabled] { background: #c9ccd2; color: #fff; }
button.se-ghost[disabled], button.se-danger[disabled] { opacity: .55; }
button.se-ghost::after, button.se-danger::after, button.se-save::after { border: 0; }

/* 保存后询问是否发布：底部弹层，和技能面板同一套观感 */
.se-ask { position: fixed; z-index: 240; top: 0; right: 0; bottom: 0; left: 0; }
.se-ask-mask { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: rgba(0, 0, 0, .42); }
.se-ask-panel { position: absolute; right: 0; bottom: 0; left: 0; max-width: 750rpx; margin: 0 auto; padding: 40rpx 34rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 30rpx 30rpx 0 0; background: #fff; box-sizing: border-box; animation: se-up .2s ease-out; }
@keyframes se-up { from { transform: translateY(40rpx); opacity: .4; } to { transform: translateY(0); opacity: 1; } }
.se-ask-title { display: block; color: #14171b; font-size: 34rpx; font-weight: 700; line-height: 1.3; }
.se-ask-desc { display: block; margin-top: 12rpx; color: #8b929a; font-size: 25rpx; font-weight: 400; line-height: 1.6; }
button.se-ask-primary { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 94rpx; margin: 30rpx 0 0; padding: 0 32rpx; border: 0; border-radius: 999rpx; background: #242b3d; color: #fff; font-size: 30rpx; font-weight: 600; line-height: 1.3; }
button.se-ask-ghost { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 88rpx; margin: 14rpx 0 0; padding: 0 32rpx; border: 0; border-radius: 999rpx; background: #f3f4f5; color: #4b545d; font-size: 28rpx; font-weight: 500; line-height: 1.3; }
button.se-ask-primary::after, button.se-ask-ghost::after { border: 0; }
